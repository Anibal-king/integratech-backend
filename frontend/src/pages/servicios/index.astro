---
/** Catálogo completo de servicios (destino de la tarjeta «Ver más» del inicio). */
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatusMessage from '../../components/StatusMessage.astro';
import ServiciosCatalogo from '../../components/ServiciosCatalogo.astro';
import { api } from '../../lib/api';

// Se renderiza en cada visita: muestra siempre los servicios publicados en el panel.
export const prerender = false;

const servicios = await api.servicios();
---

<Layout
  title="Servicios — SIIE"
  description="Catálogo completo de servicios de ingeniería: automatización, soluciones comerciales e industriales, energía renovable, auditorías y mantenimiento de infraestructura."
>
  <PageHeader
    tituloId="catalogo-title"
    eyebrow="Catálogo"
    titulo="Todos nuestros servicios"
    descripcion="Busque una línea de servicio o recorra el catálogo completo. Cada una agrupa capacidades que ejecutamos con personal técnico propio y equipos de las marcas que representamos."
    migas={[{ label: 'Servicios' }]}
  />

  <Section variant="muted" class="section" aria-labelledby="catalogo-title">
    <div class="container">
      {servicios.status !== 'ok' ? (
        <StatusMessage resultado={servicios} vacio="Pronto publicaremos nuestros servicios aquí." />
      ) : (
        <ServiciosCatalogo servicios={servicios.data} nivelTitulo={2} />
      )}
    </div>
  </Section>
</Layout>
