---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import StatusMessage from '../../components/StatusMessage.astro';
import Galeria from '../../components/Galeria.astro';
import NoEncontrado from '../../components/NoEncontrado.astro';
import { api, mediaUrl, mediaSrcset } from '../../lib/api';

// Se renderiza en cada visita: un servicio nuevo tiene página al instante y uno
// oculto o eliminado responde 404.
export const prerender = false;

const resultado = await api.servicio(Astro.params.id!);
const servicio = resultado.status === 'ok' ? resultado.data : null;
const noExiste = resultado.status === 'http' && resultado.code === 404;
if (!servicio) Astro.response.status = noExiste ? 404 : 503;

const portada = servicio?.portada ?? null;
// La portada va de fondo en el encabezado; la galería muestra las demás.
const galeria = servicio?.fotos.filter((f) => f.id !== portada?.id) ?? [];
---

{!servicio ? (
  <Layout title={noExiste ? 'Servicio no encontrado — IntegraTech' : 'Servicio no disponible — IntegraTech'}>
    {noExiste ? (
      <NoEncontrado titulo="Este servicio no está disponible" mensaje="Puede que se haya retirado o que la dirección no sea correcta. Revisa nuestros servicios actuales." />
    ) : (
      <Section variant="light" class="section">
        <div class="container">
          <p><a href="/#servicios">← Volver a servicios</a></p>
          <StatusMessage resultado={resultado.status === 'ok' ? undefined : resultado} />
        </div>
      </Section>
    )}
  </Layout>
) : (
  <Layout title={`${servicio.nombre} — IntegraTech`} description={servicio.descripcion ?? undefined}>
    <!-- Encabezado con imagen -->
    <Section variant="dark" class="svc-hero">
      {portada && (
        <img
          class="svc-hero__bg"
          src={mediaUrl(portada.src)}
          srcset={mediaSrcset(portada.srcset)}
          sizes="100vw"
          width={portada.ancho}
          height={portada.alto}
          alt=""
          fetchpriority="high"
        />
      )}
      <div class="svc-hero__overlay"></div>
      <div class="container svc-hero__inner">
        <p><a href="/#servicios" class="svc-hero__back">← Volver a servicios</a></p>
        <span class="eyebrow">Servicio</span>
        <h1>{servicio.nombre}</h1>
        <p>{servicio.descripcion}</p>
      </div>
    </Section>

    <Section variant="light" class="section">
      <div class="container">
        <div class="detail">
          <div>
            {servicio.descripcion_larga && (
              <div class="detail__larga">
                {servicio.descripcion_larga.split(/\n{2,}/).map((p) => <p>{p}</p>)}
              </div>
            )}
            <h2>Qué incluye</h2>
            {servicio.items.length === 0 ? (
              <StatusMessage tipo="empty" mensaje="Escríbenos y te contamos el alcance de este servicio para tu proyecto." />
            ) : (
              <ul class="detail__list">
                {servicio.items.map((i) => <li>{i}</li>)}
              </ul>
            )}
          </div>

          <aside class="detail__aside">
            <h3>¿Te interesa este servicio?</h3>
            <p>Agenda una visita técnica o pide una cotización sin compromiso.</p>
            <a href="/#contacto" class="btn btn--primary btn--block">Solicitar cotización</a>
          </aside>
        </div>
      </div>
    </Section>

    {galeria.length > 0 && (
      <Section variant="muted" class="section">
        <div class="container">
          <div class="section__head">
            <span class="eyebrow">Trabajos realizados</span>
            <h2>Galería del servicio</h2>
            <p>Ejemplos reales de proyectos ejecutados en esta línea.</p>
          </div>
          <Galeria fotos={galeria} />
        </div>
      </Section>
    )}
  </Layout>
)}

<style>
  .svc-hero {
    position: relative;
    min-height: 340px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .svc-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .svc-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--overlay-scrim-soft) 0%, var(--overlay-scrim) 100%);
  }
  .svc-hero__inner {
    position: relative;
    padding-block: 2.5rem 3rem;
    color: var(--overlay-text);
  }
  .svc-hero__inner h1 { color: var(--overlay-text); }
  .svc-hero__inner p { color: var(--overlay-text-muted); max-width: 60ch; margin-bottom: 0; }
  .svc-hero__back { color: var(--overlay-text-muted); font-weight: 600; }

  .detail {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2.5rem;
    align-items: start;
  }
  .detail__larga { margin-bottom: 2rem; max-width: 70ch; }
  .detail__larga p { color: var(--text-muted); font-size: 1.05rem; }
  .detail__list { columns: 2; column-gap: 2rem; }
  .detail__list li { break-inside: avoid; }
  .detail__aside {
    background: var(--surface-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.6rem;
    position: sticky;
    top: calc(var(--header-height) + 1.5rem);
  }

  @media (max-width: 820px) {
    .detail { grid-template-columns: 1fr; }
    .detail__list { columns: 1; }
    .detail__aside { position: static; }
  }
</style>
