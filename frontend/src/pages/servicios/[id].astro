---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatusMessage from '../../components/StatusMessage.astro';
import Galeria from '../../components/Galeria.astro';
import NoEncontrado from '../../components/NoEncontrado.astro';
import { api, mediaUrl, mediaSrcset } from '../../lib/api';

// Se renderiza en cada visita: un servicio nuevo tiene página al instante y uno
// oculto o eliminado responde 404.
export const prerender = false;

const resultado = await api.servicio(Astro.params.id!);
const servicio = resultado.status === 'ok' ? resultado.data : null;
const noExiste = resultado.status === 'http' && resultado.code === 404;
if (!servicio) Astro.response.status = noExiste ? 404 : 503;

const portada = servicio?.portada ?? null;
// La portada va de fondo en el encabezado; la galería muestra las demás.
const galeria = servicio?.fotos.filter((f) => f.id !== portada?.id) ?? [];
---

{!servicio ? (
  <Layout title={noExiste ? 'Servicio no encontrado — SIIE' : 'Servicio no disponible — SIIE'}>
    {noExiste ? (
      <NoEncontrado titulo="Este servicio no está disponible" mensaje="Puede que se haya retirado o que la dirección no sea correcta. Revise nuestros servicios actuales." />
    ) : (
      <Section variant="light" class="section">
        <div class="container">
          <p><a href="/#servicios">← Volver a servicios</a></p>
          <StatusMessage resultado={resultado.status === 'ok' ? undefined : resultado} />
        </div>
      </Section>
    )}
  </Layout>
) : (
  <Layout title={`${servicio.nombre} — SIIE`} description={servicio.descripcion ?? undefined}>
    <!-- Encabezado con la portada de fondo -->
    <PageHeader
      eyebrow="Servicio"
      titulo={servicio.nombre}
      descripcion={servicio.descripcion}
      migas={[{ label: 'Servicios', href: '/servicios' }, { label: servicio.nombre }]}
      fondo={portada ? { src: mediaUrl(portada.src), srcset: mediaSrcset(portada.srcset), ancho: portada.ancho, alto: portada.alto } : undefined}
    />

    <Section variant="light" class="section">
      <div class="container">
        <div class="detail">
          <div>
            {servicio.descripcion_larga && (
              <div class="detail__larga">
                {servicio.descripcion_larga.split(/\n{2,}/).map((p) => <p>{p}</p>)}
              </div>
            )}
            <h2>Qué incluye</h2>
            {servicio.items.length === 0 ? (
              <StatusMessage tipo="empty" mensaje="Escríbanos y le explicamos el alcance de este servicio para su proyecto." />
            ) : (
              <ul class="detail__list">
                {servicio.items.map((i) => <li>{i}</li>)}
              </ul>
            )}
          </div>

          <aside class="detail__aside surface-dark">
            <h3>¿Le interesa este servicio?</h3>
            <p>Agende una visita técnica o solicite una cotización sin compromiso.</p>
            <a href="/#contacto" class="btn btn--primary btn--block">Solicitar cotización <span class="btn__arrow" aria-hidden="true">→</span></a>
            <ul class="detail__tel">
              <li>PBX <a href="tel:+50325561756">2556-1756</a></li>
              <li>Cel. <a href="tel:+50379862065">7986-2065</a></li>
            </ul>
          </aside>
        </div>
      </div>
    </Section>

    {galeria.length > 0 && (
      <Section variant="muted" class="section">
        <div class="container">
          <div class="section__head">
            <span class="eyebrow">Trabajos realizados</span>
            <h2>Galería del servicio</h2>
            <p>Ejemplos reales de proyectos ejecutados en esta línea.</p>
          </div>
          <Galeria fotos={galeria} />
        </div>
      </Section>
    )}
  </Layout>
)}

<style>
  .detail {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    align-items: start;
  }
  .detail__larga { margin-bottom: 2.5rem; max-width: 70ch; }
  .detail__larga p { color: var(--text-muted); font-size: 1.125rem; }
  .detail h2 { font-size: clamp(1.6rem, 1.3rem + 1vw, 2.1rem); margin-bottom: 1.25rem; }
  .detail__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 2rem;
  }
  .detail__list li {
    position: relative;
    margin: 0;
    padding: 0.9rem 0 0.9rem 2rem;
    border-top: 1px solid var(--border);
    line-height: 1.5;
  }
  .detail__list li::before {
    content: '';
    position: absolute;
    left: 0.3rem;
    top: 1.15rem;
    width: 0.45rem;
    height: 0.8rem;
    border: solid var(--accent);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .detail__aside {
    padding: 2rem;
    border-radius: var(--radius-lg);
    position: sticky;
    top: calc(var(--header-height) + 1.5rem);
    background:
      radial-gradient(circle at 100% 0%, color-mix(in srgb, var(--color-brand-blue) 60%, transparent), transparent 60%),
      var(--color-navy);
  }
  .detail__aside h3 { font-size: 1.6rem; }
  .detail__aside p { color: var(--text-muted); margin-bottom: 1.5rem; }
  .detail__tel {
    list-style: none;
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    margin: 1.25rem 0 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--border);
    font-size: 0.95rem;
    color: var(--text-muted);
  }
  .detail__tel li { margin: 0; }
  .detail__tel a { color: var(--color-white); font-weight: 600; }

  @media (max-width: 860px) {
    .detail { grid-template-columns: 1fr; }
    .detail__list { grid-template-columns: 1fr; }
    .detail__aside { position: static; }
  }
</style>
