---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { api } from '../lib/api';
import { marcaLogo, documentosLegales } from '../lib/imagenes';

const [empresa, marcas, legal] = await Promise.all([
  api.empresa(),
  api.marcas(),
  api.legal(),
]);
---

<Layout title="Nosotros — IntegraTech">
  <section class="section">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">Quiénes somos</span>
        <h1>{empresa?.nombre ?? 'Servicios Integrales de Ingeniería El Salvador, S.A. de C.V.'}</h1>
      </div>

      {empresa ? (
        <div class="prose">
          {empresa.resena_historica && (
            <>
              <h2>Reseña</h2>
              <p>{empresa.resena_historica}</p>
            </>
          )}

          <div class="grid grid--2" style="margin:2rem 0;">
            {empresa.mision && (
              <article class="card">
                <h3>Misión</h3>
                <p>{empresa.mision}</p>
              </article>
            )}
            {empresa.vision && (
              <article class="card">
                <h3>Visión</h3>
                <p>{empresa.vision}</p>
              </article>
            )}
          </div>

          {empresa.valores?.length > 0 && (
            <>
              <h2>Valores</h2>
              <div class="grid grid--3">
                {empresa.valores.map((v) => (
                  <article class="card">
                    <h3>{v.nombre}</h3>
                    <p>{v.descripcion}</p>
                  </article>
                ))}
              </div>
            </>
          )}
        </div>
      ) : (
        <div class="notice">
          No se pudo cargar la información de la empresa. Verifica que el backend esté corriendo en <code>{api.baseUrl}</code>.
        </div>
      )}
    </div>
  </section>

  {marcas.length > 0 && (
    <section class="section section--surface">
      <div class="container">
        <div class="section__head">
          <span class="eyebrow">Alianzas</span>
          <h2>Marcas que representamos</h2>
        </div>
        <div class="marcas">
          {marcas.map((m) => {
            const logo = marcaLogo(m.nombre);
            return (
              <article class="marca">
                <div class="marca__logo">
                  {logo ? (
                    <Image src={logo} alt={m.nombre} widths={[160, 320]} sizes="200px" loading="lazy" />
                  ) : (
                    <span class="marca__nombre">{m.nombre}</span>
                  )}
                </div>
                <div class="marca__txt">
                  <h3>{m.nombre}</h3>
                  {m.funcion && <p>{m.funcion}</p>}
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {(legal.length > 0 || empresa) && (
    <section class="section">
      <div class="container">
        <h2>Datos legales</h2>
        <table class="legal">
          <tbody>
            {empresa?.nit && <tr><th>NIT</th><td>{empresa.nit}</td></tr>}
            {empresa?.registro_fiscal && <tr><th>Registro fiscal (NRC)</th><td>{empresa.registro_fiscal}</td></tr>}
            {empresa?.direccion && <tr><th>Dirección</th><td>{empresa.direccion}</td></tr>}
            {empresa?.telefono && <tr><th>Teléfono</th><td>{empresa.telefono}</td></tr>}
            {empresa?.celular && <tr><th>Celular</th><td>{empresa.celular}</td></tr>}
            {legal.map((d) => (
              <tr><th>{d.tipo}</th><td>{d.numero}{d.descripcion ? ` — ${d.descripcion}` : ''}</td></tr>
            ))}
          </tbody>
        </table>

        {documentosLegales.length > 0 && (
          <div class="docs">
            {documentosLegales.map((d) => (
              <figure class="doc">
                <Image src={d.img} alt={d.alt} widths={[240, 480]} sizes="240px" loading="lazy" />
                <figcaption>{d.alt}</figcaption>
              </figure>
            ))}
          </div>
        )}
      </div>
    </section>
  )}
</Layout>

<style>
  .prose { max-width: 70ch; }
  .prose h2 { margin-top: 2rem; }
  .legal {
    border-collapse: collapse;
    width: 100%;
    max-width: 640px;
    margin-top: 1rem;
  }
  .legal th, .legal td {
    text-align: left;
    padding: 0.6rem 0.8rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }
  .legal th { width: 40%; color: var(--color-primary); }
  code { background: var(--color-surface-2); padding: 0.1rem 0.35rem; border-radius: 4px; }

  /* Marcas */
  .marcas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .marca {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1rem 1.2rem;
    box-shadow: var(--shadow-sm);
  }
  .marca__logo {
    flex-shrink: 0;
    width: 96px;
    height: 64px;
    display: grid;
    place-items: center;
    background: #fff;
    border: 1px solid var(--color-surface-2);
    border-radius: 8px;
    padding: 6px;
  }
  .marca__logo img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .marca__nombre { font-weight: 700; font-size: 0.8rem; text-align: center; color: var(--color-primary); }
  .marca__txt h3 { margin: 0 0 0.2rem; font-size: 1rem; }
  .marca__txt p { margin: 0; color: var(--color-text-muted); font-size: 0.88rem; }

  /* Documentos legales */
  .docs {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 1.75rem;
  }
  .doc {
    margin: 0;
    width: 240px;
  }
  .doc img {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    box-shadow: var(--shadow-sm);
  }
  .doc figcaption {
    margin-top: 0.4rem;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    line-height: 1.35;
  }
</style>
