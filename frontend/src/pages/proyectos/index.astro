---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import StatusMessage from '../../components/StatusMessage.astro';
import Galeria from '../../components/Galeria.astro';
import { api, dataOr } from '../../lib/api';

// Se renderiza en cada visita: las galerías son las fotos de cada servicio del panel.
export const prerender = false;

const [servicios, proyectos, contratos] = await Promise.all([
  api.servicios(),
  api.proyectos(),
  api.contratosMantenimiento().then((r) => dataOr(r, [])),
]);

const slug = (nombre: string) =>
  nombre
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');

const categorias = dataOr(servicios, [])
  .map((s) => ({ ...s, slug: slug(s.nombre) }))
  .filter((c) => c.fotos.length > 0);

const totalFotos = categorias.reduce((n, c) => n + c.fotos.length, 0);
---

<Layout title="Proyectos — IntegraTech">
  <!-- Encabezado + navegación por categoría -->
  <Section variant="light" class="section section--tight">
    <div class="container">
      <p><a href="/#proyectos" class="back-link">← Volver a proyectos</a></p>
      <div class="section__head">
        <span class="eyebrow">Nuestro trabajo</span>
        <h1>Galería de proyectos</h1>
        <p>{totalFotos} imágenes de instalaciones reales, organizadas por línea de servicio. Elige una categoría o recorre la página.</p>
      </div>

      {categorias.length > 0 && (
        <nav class="cat-nav" aria-label="Ir a categoría">
          {categorias.map((c) => (
            <a href={`#${c.slug}`} class="cat-nav__link">
              {c.nombre} <span class="cat-nav__count">{c.fotos.length}</span>
            </a>
          ))}
        </nav>
      )}
    </div>
  </Section>

  <!-- Una sección por categoría: fotos a la izquierda, descripción legible a la derecha -->
  {categorias.length === 0 ? (
    <Section variant="light" class="section">
      <div class="container">
        <StatusMessage
          resultado={servicios.status === 'ok' ? { status: 'empty' } : servicios}
          vacio="Pronto publicaremos aquí la galería de proyectos."
        />
      </div>
    </Section>
  ) : (
    categorias.map((c, i) => (
      <Section variant={i % 2 === 1 ? 'muted' : 'light'} id={c.slug} class="section cat">
        <div class="container cat__grid">
          <div class="cat__photos">
            <Galeria fotos={c.fotos} min={220} />
          </div>

          <aside class="cat__aside">
            <span class="eyebrow">Categoría {String(i + 1).padStart(2, '0')}</span>
            <h2>{c.nombre}</h2>
            {c.descripcion && <p class="cat__desc">{c.descripcion}</p>}

            {c.items.length > 0 && (
              <ul class="cat__items">
                {c.items.slice(0, 6).map((it) => <li>{it}</li>)}
              </ul>
            )}

            <a href={`/servicios/${c.id}`} class="btn btn--secondary btn--block">Ver servicio completo →</a>
          </aside>
        </div>
      </Section>
    ))
  )}

  <Section variant="muted" class="section">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">Trayectoria</span>
        <h2>Proyectos destacados</h2>
        <p>Una selección de trabajos ejecutados para clientes del sector industrial, financiero y de infraestructura.</p>
      </div>

      {proyectos.status !== 'ok' ? (
        <StatusMessage resultado={proyectos} vacio="Pronto publicaremos nuestros proyectos aquí." />
      ) : (
        <div class="grid grid--2">
          {proyectos.data.map((p) => (
            <article class="card">
              {p.ejecucion && <span class="tag">{p.ejecucion}</span>}
              <h2 style="font-size:1.2rem;margin-top:0.6rem;">{p.nombre_proyecto}</h2>
              {p.descripcion && <p>{p.descripcion}</p>}
            </article>
          ))}
        </div>
      )}
    </div>
  </Section>

  {contratos.length > 0 && (
    <Section variant="light" class="section">
      <div class="container">
        <div class="section__head">
          <span class="eyebrow">Servicio recurrente</span>
          <h2>Contratos de mantenimiento</h2>
        </div>
        <div class="grid grid--2">
          {contratos.map((c) => (
            <article class="card">
              {c.ejecucion && <span class="tag">{c.ejecucion}</span>}
              <h3 style="margin-top:0.6rem;">{c.nombre_proyecto}</h3>
              {c.descripcion && <p>{c.descripcion}</p>}
            </article>
          ))}
        </div>
      </div>
    </Section>
  )}
</Layout>

<style>
  .section--tight { padding-bottom: 0.5rem; }
  .back-link { font-weight: 600; }

  /* Navegación rápida por categoría */
  .cat-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }
  .cat-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface-muted);
    color: var(--heading);
    font-weight: 600;
    font-size: 0.85rem;
  }
  .cat-nav__link:hover {
    background: var(--heading);
    color: var(--surface);
    text-decoration: none;
    border-color: var(--heading);
  }
  .cat-nav__count {
    display: inline-grid;
    place-items: center;
    min-width: 1.4em;
    height: 1.4em;
    padding: 0 0.3em;
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-muted);
    font-size: 0.75em;
  }
  .cat-nav__link:hover .cat-nav__count { background: var(--surface); color: var(--heading); }

  /* Sección por categoría */
  .cat { scroll-margin-top: calc(var(--header-height) + 1rem); }
  .cat__grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2.5rem;
    align-items: start;
  }
  .cat__aside {
    position: sticky;
    top: calc(var(--header-height) + 1.5rem);
  }
  .cat__aside h2 { margin: 0.35rem 0 0.75rem; font-size: 1.4rem; }
  .cat__desc { color: var(--text-muted); line-height: 1.55; }
  .cat__items {
    margin: 1rem 0 1.5rem;
    padding-left: 1.1rem;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }
  .cat__items li { margin-bottom: 0.2rem; }

  @media (max-width: 900px) {
    .cat__grid { grid-template-columns: 1fr; }
    .cat__aside { position: static; order: -1; }
  }
</style>
