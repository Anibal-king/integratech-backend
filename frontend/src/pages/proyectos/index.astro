---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatusMessage from '../../components/StatusMessage.astro';
import Galeria from '../../components/Galeria.astro';
import { api, dataOr } from '../../lib/api';

// Se renderiza en cada visita: las galerías son las fotos de cada servicio del panel.
export const prerender = false;

const [servicios, proyectos, contratos] = await Promise.all([
  api.servicios(),
  api.proyectos(),
  api.contratosMantenimiento().then((r) => dataOr(r, [])),
]);

const slug = (nombre: string) =>
  nombre
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');

const categorias = dataOr(servicios, [])
  .map((s) => ({ ...s, slug: slug(s.nombre) }))
  .filter((c) => c.fotos.length > 0);

const totalFotos = categorias.reduce((n, c) => n + c.fotos.length, 0);
---

<Layout title="Proyectos — SIIE" description="Galería de proyectos de Servicios Integrales de Ingeniería: data centers, subestaciones, generadores, automatización, iluminación y energía solar en El Salvador.">
  <!-- Encabezado + navegación por categoría -->
  <PageHeader
    eyebrow="Nuestro trabajo"
    titulo="Galería de proyectos"
    descripcion={`${totalFotos} fotografías de instalaciones reales, organizadas por línea de servicio, además de nuestros proyectos destacados y contratos de mantenimiento.`}
    migas={[{ label: 'Proyectos' }]}
  >
    {categorias.length > 0 && (
      <nav class="cat-nav" aria-label="Ir a categoría">
        {categorias.map((c) => (
          <a href={`#${c.slug}`} class="cat-nav__link">
            {c.nombre} <span class="cat-nav__count">{c.fotos.length}</span>
          </a>
        ))}
        <a href="#destacados" class="cat-nav__link">Proyectos destacados</a>
      </nav>
    )}
  </PageHeader>

  <!-- Una sección por categoría: fotos a la izquierda, descripción legible a la derecha -->
  {categorias.length === 0 ? (
    <Section variant="light" class="section">
      <div class="container">
        <StatusMessage
          resultado={servicios.status === 'ok' ? { status: 'empty' } : servicios}
          vacio="Pronto publicaremos aquí la galería de proyectos."
        />
      </div>
    </Section>
  ) : (
    categorias.map((c, i) => (
      <Section variant={i % 2 === 1 ? 'muted' : 'light'} id={c.slug} class="section cat">
        <div class="container cat__grid">
          <div class="cat__photos">
            <Galeria fotos={c.fotos} min={220} />
          </div>

          <aside class="cat__aside">
            <span class="eyebrow">Categoría {String(i + 1).padStart(2, '0')}</span>
            <h2>{c.nombre}</h2>
            {c.descripcion && <p class="cat__desc">{c.descripcion}</p>}

            {c.items.length > 0 && (
              <ul class="cat__items">
                {c.items.slice(0, 6).map((it) => <li>{it}</li>)}
              </ul>
            )}

            <a href={`/servicios/${c.id}`} class="btn btn--secondary btn--block">Ver servicio completo <span class="btn__arrow" aria-hidden="true">→</span></a>
          </aside>
        </div>
      </Section>
    ))
  )}

  <Section variant="dark" class="section" id="destacados">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">Trayectoria</span>
        <h2>Proyectos destacados</h2>
        <p>Una selección de trabajos ejecutados para clientes del sector industrial, financiero y de infraestructura.</p>
      </div>

      {proyectos.status !== 'ok' ? (
        <StatusMessage resultado={proyectos} vacio="Pronto publicaremos nuestros proyectos aquí." />
      ) : (
        <ol class="hitos">
          {proyectos.data.map((p) => (
            <li>
              {p.ejecucion && <span class="hitos__anio">{p.ejecucion}</span>}
              <h3>{p.nombre_proyecto}</h3>
              {p.descripcion && <p>{p.descripcion}</p>}
            </li>
          ))}
        </ol>
      )}
    </div>
  </Section>

  {contratos.length > 0 && (
    <Section variant="light" class="section">
      <div class="container">
        <div class="section__head">
          <span class="eyebrow">Servicio recurrente</span>
          <h2>Contratos de mantenimiento</h2>
        </div>
        <div class="grid grid--2">
          {contratos.map((c) => (
            <article class="card">
              {c.ejecucion && <span class="tag">{c.ejecucion}</span>}
              <h3>{c.nombre_proyecto}</h3>
              {c.descripcion && <p>{c.descripcion}</p>}
            </article>
          ))}
        </div>
      </div>
    </Section>
  )}
</Layout>

<style>
  /* Navegación rápida por categoría (dentro del encabezado oscuro) */
  .cat-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2.25rem;
  }
  .cat-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.95rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: var(--radius);
    color: var(--color-white);
    font-weight: 500;
    font-size: 0.92rem;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  .cat-nav__link:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
  }
  .cat-nav__count {
    display: inline-grid;
    place-items: center;
    min-width: 1.5em;
    height: 1.5em;
    padding: 0 0.35em;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    font-size: 0.78em;
  }

  /* Sección por categoría */
  .cat { scroll-margin-top: calc(var(--header-height) + 1rem); }
  .cat__grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }
  .cat__aside {
    position: sticky;
    top: calc(var(--header-height) + 1.5rem);
  }
  .cat__aside h2 { margin: 0 0 0.85rem; font-size: clamp(1.6rem, 1.3rem + 0.8vw, 2rem); }
  .cat__desc { color: var(--text-muted); line-height: 1.6; }
  .cat__items {
    list-style: none;
    margin: 1.25rem 0 1.75rem;
    padding: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .cat__items li {
    position: relative;
    margin: 0;
    padding: 0.55rem 0 0.55rem 1.6rem;
    border-top: 1px solid var(--border);
  }
  .cat__items li::before {
    content: '';
    position: absolute;
    left: 0.2rem;
    top: 0.8rem;
    width: 0.4rem;
    height: 0.7rem;
    border: solid var(--accent);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  /* Proyectos destacados: rejilla de hitos con año */
  .hitos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .hitos li {
    margin: 0;
    padding: 1.75rem;
    background: var(--surface);
  }
  .hitos__anio {
    display: block;
    margin-bottom: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
  }
  .hitos h3 {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 0 0 0.5rem;
  }
  .hitos p { margin: 0; color: var(--text-muted); font-size: 0.95rem; }

  #destacados { scroll-margin-top: var(--header-height); }
  .card h3 { margin-top: 0.75rem; font-size: 1.2rem; }

  @media (max-width: 900px) {
    .cat__grid { grid-template-columns: 1fr; }
    .cat__aside { position: static; order: -1; }
  }
</style>
