---
import AdminShell from '../../components/admin/AdminShell.astro';
import Vista from '../../components/admin/Vista.astro';
import Icono from '../../components/admin/Icono.astro';
import { ESTADOS, ORIGENES } from '../../lib/admin-ui';
---

<AdminShell activo="mensajes" titulo="Mensajes">
  <form class="admin-card filtros" data-filtros role="search" aria-label="Filtrar solicitudes">
    <label class="filtros__buscar">
      <span class="sr-only">Buscar</span>
      <Icono nombre="buscar" tamano={18} />
      <input type="search" name="q" maxlength="100" placeholder="Buscar por nombre, empresa, correo, teléfono o texto…" autocomplete="off" />
    </label>
    <label>
      <span class="sr-only">Estado</span>
      <select name="estado">
        <option value="">Todos los estados</option>
        {ESTADOS.map((e) => <option value={e.valor}>{e.etiqueta}</option>)}
      </select>
    </label>
    <label>
      <span class="sr-only">Origen</span>
      <select name="origen">
        <option value="">Todos los orígenes</option>
        {ORIGENES.map((o) => <option value={o.valor}>{o.etiqueta}</option>)}
      </select>
    </label>
    <button type="button" class="btn btn--secondary btn--sm" data-limpiar>Limpiar</button>
  </form>

  <section class="admin-card lista" aria-labelledby="lista-titulo">
    <h2 id="lista-titulo" class="sr-only">Solicitudes</h2>
    <Vista id="lista" cargando="Cargando solicitudes…" vacio="Aún no hay solicitudes.">
      <table class="tabla">
        <thead>
          <tr>
            <th scope="col">Fecha</th>
            <th scope="col">Solicitante</th>
            <th scope="col">Contacto</th>
            <th scope="col">Origen</th>
            <th scope="col">Estado</th>
            <th scope="col"><span class="sr-only">Acciones</span></th>
          </tr>
        </thead>
        <tbody data-filas></tbody>
      </table>
      <nav class="paginacion" aria-label="Paginación">
        <p data-pag-info aria-live="polite"></p>
        <div>
          <button type="button" class="btn btn--secondary btn--sm" data-pag="anterior">Anterior</button>
          <button type="button" class="btn btn--secondary btn--sm" data-pag="siguiente">Siguiente</button>
        </div>
      </nav>
    </Vista>
  </section>

  <!-- Detalle de una solicitud: se llena en el navegador al abrirla -->
  <dialog class="detalle" data-detalle aria-labelledby="detalle-titulo">
    <div class="detalle__head">
      <h2 id="detalle-titulo" data-d="nombre">Solicitud</h2>
      <button type="button" class="detalle__cerrar" data-detalle-cerrar aria-label="Cerrar detalle">
        <Icono nombre="cerrar" />
      </button>
    </div>
    <Vista id="detalle" cargando="Cargando solicitud…" vacio="Esta solicitud ya no existe.">
      <div class="detalle__body">
        <p class="detalle__meta">
          <strong class="detalle__ticket" data-d="ticket" hidden></strong>
          <span data-d="origen"></span>
          <span data-d="estado"></span>
          <span class="detalle__fecha" data-d="fecha"></span>
        </p>

        <div class="responder" data-responder>
          <a class="btn btn--primary btn--sm" data-r="correo" hidden><Icono nombre="correo" tamano={16} />Correo</a>
          <a class="btn btn--secondary btn--sm" data-r="telefono" hidden><Icono nombre="telefono" tamano={16} />Llamar</a>
          <a class="btn btn--secondary btn--sm" data-r="whatsapp" target="_blank" rel="noopener noreferrer" hidden><Icono nombre="whatsapp" tamano={16} /><span data-r-texto>WhatsApp</span></a>
          <p class="responder__nada" data-r="nada" hidden>No dejó correo ni teléfono.</p>
          <a class="btn btn--secondary btn--sm responder__agendar" data-agendar><Icono nombre="calendario" tamano={16} />Agendar cita</a>
        </div>

        <dl class="datos">
          <div><dt>Empresa</dt><dd data-d="empresa"></dd></div>
          <div><dt>Correo</dt><dd data-d="correo"></dd></div>
          <div><dt>Teléfono</dt><dd data-d="telefono"></dd></div>
        </dl>

        <section class="detalle__seccion">
          <h3>Mensaje</h3>
          <p class="detalle__mensaje" data-d="mensaje"></p>
          <dl class="datos datos--chatbot" data-d="chatbot" hidden>
            <div><dt data-l="tipo_servicio">Servicio</dt><dd data-d="tipo_servicio"></dd></div>
            <div><dt data-l="alcance">Alcance</dt><dd class="datos__largo" data-d="alcance"></dd></div>
            <div data-fila="ubicacion"><dt>Ubicación</dt><dd data-d="ubicacion"></dd></div>
            <div><dt data-l="plazo">Plazo</dt><dd data-d="plazo"></dd></div>
            <div data-fila="presupuesto"><dt>Presupuesto</dt><dd data-d="presupuesto"></dd></div>
          </dl>
        </section>

        <form class="detalle__seccion seguimiento" data-seguimiento>
          <h3>Seguimiento</h3>
          <label>
            Estado
            <select name="estado">
              {ESTADOS.map((e) => <option value={e.valor}>{e.etiqueta}</option>)}
            </select>
          </label>
          <label>
            Notas internas
            <textarea name="notas" rows="5" maxlength="5000" placeholder="Solo las ve el equipo. Ej.: llamado el lunes, pide visita técnica."></textarea>
          </label>
          <div class="seguimiento__acciones">
            <button type="submit" class="btn btn--primary btn--sm" data-guardar>Guardar cambios</button>
            <p class="seguimiento__estado" data-guardado role="status"></p>
          </div>
          <p class="detalle__actualizado" data-d="actualizado"></p>
          <details class="historial" data-historial hidden>
            <summary>Historial de estados</summary>
            <ol data-historial-lista></ol>
          </details>
        </form>

        <!-- Conversación de WhatsApp exportada (solo cotizaciones) -->
        <section class="detalle__seccion conv" data-conversacion aria-labelledby="conv-titulo" hidden>
          <div class="conv__cabecera">
            <h3 id="conv-titulo">Conversación</h3>
            <button type="button" class="btn btn--secondary btn--sm" data-conv-descargar hidden>
              <Icono nombre="descargar" tamano={16} />Descargar conversación
            </button>
          </div>
          <p class="conv__ayuda">
            Al terminar, exporta el chat desde WhatsApp Business («Exportar chat» → «Sin archivos») y súbelo aquí:
            .txt o .zip, máx. 10 MB. Si subes otra exportación del mismo chat, solo se agregan los mensajes nuevos.
          </p>
          <form class="conv__subir" data-conv-subir>
            <label>
              <span class="sr-only">Archivo del chat</span>
              <input type="file" name="archivo" accept=".txt,.zip,text/plain,application/zip" required />
            </label>
            <button type="submit" class="btn btn--primary btn--sm">Subir chat</button>
          </form>
          <p class="conv__estado" data-conv-estado role="status"></p>
          <form class="conv__autor" data-conv-autor hidden>
            <label>
              ¿Cuál autor del chat es IntegraTech?
              <select name="autor" required></select>
            </label>
            <button type="submit" class="btn btn--primary btn--sm">Guardar</button>
          </form>
          <ol class="conv__mensajes" data-conv-mensajes aria-label="Mensajes de la conversación"></ol>
          <p class="conv__archivos" data-conv-archivos></p>
        </section>
      </div>
    </Vista>
  </dialog>
</AdminShell>

<style>
  /* ---------- Filtros ---------- */
  .filtros {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
  }
  .filtros__buscar { position: relative; flex: 1 1 280px; display: block; }
  .filtros__buscar :global(.icono) {
    position: absolute;
    left: 0.7rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
  }
  .filtros__buscar input { width: 100%; padding-left: 2.2rem !important; }
  .filtros select { min-width: 170px; }

  /* ---------- Tabla ---------- */
  .lista { margin-top: 1rem; overflow: hidden; }
  .tabla { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .tabla th {
    text-align: left;
    padding: 0.7rem 1rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    background: var(--surface-muted);
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  .tabla :global(td) { padding: 0.75rem 1rem; border-bottom: 1px solid var(--border); vertical-align: middle; }
  .tabla :global(tr.is-nuevo td:first-child) { box-shadow: inset 3px 0 0 var(--estado-nuevo); }
  .tabla :global(.c-fecha) { white-space: nowrap; color: var(--text-muted); }
  .tabla :global(.c-nombre strong) { display: block; color: var(--heading); }
  .tabla :global(.c-nombre small),
  .tabla :global(.c-contacto small) { display: block; color: var(--text-muted); font-size: 0.8rem; }
  .tabla :global(.c-contacto) { max-width: 240px; overflow-wrap: anywhere; }
  .tabla :global(.c-accion) { text-align: right; }

  .paginacion {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.8rem 1rem;
  }
  .paginacion p { margin: 0; font-size: 0.85rem; color: var(--text-muted); }
  .paginacion div { display: flex; gap: 0.5rem; }

  /* ---------- Detalle (panel lateral) ---------- */
  .detalle {
    margin: 0 0 0 auto;
    width: min(600px, 100vw);
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
    padding: 0;
    border: 0;
    background: var(--surface-card);
    color: var(--text);
    box-shadow: var(--shadow-lg);
  }
  .detalle::backdrop { background: var(--overlay-backdrop); opacity: 0.55; }
  .detalle[open] { display: flex; flex-direction: column; }
  .detalle__head {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--surface-card);
    border-bottom: 1px solid var(--border);
  }
  .detalle__head h2 { margin: 0; font-size: 1.2rem; overflow-wrap: anywhere; }
  .detalle__cerrar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  .detalle__body { padding: 1.1rem 1.25rem 2rem; display: flex; flex-direction: column; gap: 1.25rem; }
  .detalle__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin: 0; }
  .detalle__fecha { font-size: 0.85rem; color: var(--text-muted); }

  .responder { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .responder__nada { margin: 0; font-size: 0.88rem; color: var(--text-muted); }
  .responder__agendar { margin-left: auto; }

  .datos { margin: 0; display: grid; gap: 0.1rem; }
  .datos div { display: grid; grid-template-columns: 110px 1fr; gap: 0.75rem; padding: 0.45rem 0; border-bottom: 1px solid var(--border); }
  .datos dt { font-size: 0.82rem; font-weight: 600; color: var(--text-muted); }
  .datos dd { margin: 0; font-size: 0.92rem; overflow-wrap: anywhere; }
  .datos--chatbot { margin-top: 0.25rem; }

  .detalle__seccion h3 { font-size: 0.95rem; margin: 0 0 0.5rem; }
  .detalle__mensaje {
    margin: 0;
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
    background: var(--surface-muted);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 0.92rem;
  }

  .seguimiento { display: flex; flex-direction: column; gap: 0.8rem; padding-top: 1rem; border-top: 1px solid var(--border); }
  .seguimiento label { display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.85rem; font-weight: 600; }
  .seguimiento :is(select, textarea) { font-weight: 400; }
  .seguimiento textarea { resize: vertical; }
  .seguimiento__acciones { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .seguimiento__estado { margin: 0; font-size: 0.85rem; color: var(--text-muted); }
  .seguimiento__estado.is-error { color: var(--danger-text); }
  .detalle__actualizado { margin: 0; font-size: 0.8rem; color: var(--text-muted); }

  .tabla :global(.c-nombre .ticket) { color: var(--text-muted); font-weight: 600; margin-right: 0.3rem; }
  .detalle__ticket { font-size: 0.95rem; color: var(--heading); }
  .datos__largo { white-space: pre-wrap; }

  .conv__archivos :global(.conv__cambiar-autor) {
    background: none; border: 0; padding: 0; font: inherit; color: var(--link, var(--color-brand-blue));
    text-decoration: underline; cursor: pointer; margin-left: 0.35rem;
  }
  .historial summary { cursor: pointer; font-size: 0.85rem; font-weight: 600; color: var(--text-muted); }
  .historial ol { margin: 0.5rem 0 0; padding-left: 1.1rem; font-size: 0.85rem; display: grid; gap: 0.3rem; }

  /* ---------- Conversación ---------- */
  .conv { display: flex; flex-direction: column; gap: 0.75rem; padding-top: 1rem; border-top: 1px solid var(--border); }
  .conv__cabecera { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap; }
  .conv__cabecera h3 { margin: 0; }
  .conv__ayuda, .conv__archivos { margin: 0; font-size: 0.82rem; color: var(--text-muted); }
  .conv__subir, .conv__autor { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 0.5rem; }
  .conv__subir label { flex: 1 1 220px; }
  .conv__subir input[type='file'] { width: 100%; font-size: 0.85rem; }
  .conv__autor label { display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.85rem; font-weight: 600; flex: 1 1 220px; }
  .conv__autor { padding: 0.75rem; border-radius: var(--radius); background: color-mix(in srgb, #25d366 12%, var(--surface-card)); }
  .conv__estado { margin: 0; font-size: 0.85rem; white-space: pre-line; }
  .conv__estado:empty { display: none; }
  .conv__estado.is-error { color: var(--danger-text); }
  .conv__mensajes {
    list-style: none;
    margin: 0;
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    max-height: 60vh;
    overflow-y: auto;
    border-radius: var(--radius);
    background: var(--surface-muted);
  }
  .conv__mensajes:empty { display: none; }
  .conv__mensajes :global(.burbuja) {
    max-width: 85%;
    padding: 0.45rem 0.7rem 0.3rem;
    border-radius: 10px;
    font-size: 0.88rem;
    line-height: 1.4;
    background: var(--surface-card);
    border: 1px solid var(--border);
    align-self: flex-start;
    border-bottom-left-radius: 3px;
  }
  .conv__mensajes :global(.burbuja--integratech) {
    align-self: flex-end;
    background: color-mix(in srgb, #25d366 18%, var(--surface-card));
    border-color: color-mix(in srgb, #25d366 40%, var(--border));
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 3px;
  }
  .conv__mensajes :global(.burbuja--sistema) {
    align-self: center;
    max-width: 92%;
    text-align: center;
    font-size: 0.78rem;
    color: var(--text-muted);
    background: transparent;
    border: 0;
  }
  .conv__mensajes :global(.burbuja__autor) { display: block; font-size: 0.75rem; font-weight: 700; color: var(--heading); }
  .conv__mensajes :global(.burbuja__texto) { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
  .conv__mensajes :global(.burbuja__hora) { display: block; text-align: right; font-size: 0.7rem; color: var(--text-muted); margin-top: 0.15rem; }
  .conv__mensajes :global(.conv__dia) {
    align-self: center;
    margin: 0.4rem 0 0.1rem;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--surface-card);
  }

  /* ---------- Móvil ---------- */
  @media (max-width: 760px) {
    .filtros select { flex: 1 1 140px; min-width: 0; }
    .tabla thead { display: none; }
    .tabla :global(tr) {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.35rem 0.5rem;
      padding: 0.85rem 1rem;
      border-bottom: 1px solid var(--border);
    }
    .tabla :global(tr.is-nuevo) { box-shadow: inset 3px 0 0 var(--estado-nuevo); }
    .tabla :global(tr.is-nuevo td:first-child) { box-shadow: none; }
    .tabla :global(td) { padding: 0; border: 0; }
    .tabla :global(.c-nombre) { order: 1; flex: 1 1 0; min-width: 0; }
    .tabla :global(.c-accion) { order: 2; }
    .tabla :global(.c-contacto) { order: 3; flex-basis: 100%; max-width: none; font-size: 0.85rem; }
    .tabla :global(.c-fecha) { order: 4; flex-basis: 100%; font-size: 0.8rem; }
    .tabla :global(.c-chips) { order: 5; }
    .datos div { grid-template-columns: 90px 1fr; }
    .conv__mensajes { max-height: none; }
    .conv__mensajes :global(.burbuja) { max-width: 92%; }
  }
</style>

<script>
  import {
    admin,
    AdminError,
    type ConversacionCotizacion,
    type EstadoSolicitud,
    type OrigenSolicitud,
    type SolicitudAdmin,
  } from '../../lib/admin';
  import {
    panelListo,
    vista,
    mensajeError,
    esSesionExpirada,
    chipEstado,
    chipOrigen,
    claveSolicitud,
    leerClave,
    fechaHora,
    fechaCorta,
    enlaceCorreo,
    enlaceTelefono,
    enlaceWhatsApp,
    etiquetaEstado,
  } from '../../lib/admin-ui';
  import { enlaceWa } from '../../lib/whatsapp';

  const POR_PAGINA = 20;
  const $ = <T extends HTMLElement>(sel: string, raiz: ParentNode = document) => raiz.querySelector<T>(sel)!;

  const form = $<HTMLFormElement>('[data-filtros]');
  const vistaLista = $('[data-vista-de="lista"]');
  const filas = $('[data-filas]');
  const dialogo = $<HTMLDialogElement>('[data-detalle]');
  const vistaDetalle = $('[data-vista-de="detalle"]');
  const formSeg = $<HTMLFormElement>('[data-seguimiento]');
  const guardado = $('[data-guardado]');

  // ---------- Estado de la página (sincronizado con la URL) ----------

  const url = new URL(location.href);
  const estado = {
    q: url.searchParams.get('q') ?? '',
    estado: (url.searchParams.get('estado') ?? '') as EstadoSolicitud | '',
    origen: (url.searchParams.get('origen') ?? '') as OrigenSolicitud | '',
    pagina: Math.max(1, Number(url.searchParams.get('pagina')) || 1),
  };
  let abierta: { origen: OrigenSolicitud; id: number } | null = leerClave(url.searchParams.get('ver'));
  let actual: SolicitudAdmin | null = null;

  (form.elements.namedItem('q') as HTMLInputElement).value = estado.q;
  (form.elements.namedItem('estado') as HTMLSelectElement).value = estado.estado;
  (form.elements.namedItem('origen') as HTMLSelectElement).value = estado.origen;

  function actualizarUrl() {
    const u = new URL(location.pathname, location.origin);
    if (estado.q) u.searchParams.set('q', estado.q);
    if (estado.estado) u.searchParams.set('estado', estado.estado);
    if (estado.origen) u.searchParams.set('origen', estado.origen);
    if (estado.pagina > 1) u.searchParams.set('pagina', String(estado.pagina));
    if (abierta) u.searchParams.set('ver', claveSolicitud(abierta.origen, abierta.id));
    history.replaceState(null, '', u);
  }

  const hayFiltros = () => Boolean(estado.q || estado.estado || estado.origen);

  // ---------- Lista ----------

  function td(clase: string, ...hijos: (Node | string)[]) {
    const c = document.createElement('td');
    c.className = clase;
    c.append(...hijos);
    return c;
  }
  function texto(tag: 'strong' | 'small' | 'span', t: string) {
    const el = document.createElement(tag);
    el.textContent = t;
    return el;
  }

  function fila(s: SolicitudAdmin) {
    const tr = document.createElement('tr');
    if (s.estado === 'nuevo') tr.className = 'is-nuevo';
    const nombre = texto('strong', s.nombre);
    if (s.origen === 'chatbot') {
      const n = texto('span', `#${s.id}`);
      n.className = 'ticket';
      nombre.prepend(n);
    }
    // Marca visible: cotización de WhatsApp que nadie ha atendido.
    if (s.canal === 'whatsapp' && s.estado === 'nuevo') {
      const marca = texto('span', 'Nueva');
      marca.className = 'marca-nueva';
      nombre.append(marca);
    }
    const contacto = [s.correo && texto('span', s.correo), s.telefono && texto('small', s.telefono)].filter(Boolean) as Node[];
    const ver = document.createElement('button');
    ver.type = 'button';
    ver.className = 'btn btn--secondary btn--sm';
    ver.textContent = 'Ver';
    ver.setAttribute('aria-label', `Ver solicitud de ${s.nombre}`);
    ver.addEventListener('click', () => abrirDetalle(s.origen, s.id, ver));
    tr.append(
      td('c-fecha', fechaCorta(s.fecha_creacion)),
      td('c-nombre', nombre, ...(s.empresa ? [texto('small', s.empresa)] : [])),
      td('c-contacto', ...(contacto.length ? contacto : ['—'])),
      td('c-chips c-origen', chipOrigen(s.canal)),
      td('c-chips c-estado', chipEstado(s.estado)),
      td('c-accion', ver)
    );
    return tr;
  }

  let pedido = 0; // descarta respuestas que llegan fuera de orden
  async function cargarLista({ silencioso = false } = {}) {
    const mio = ++pedido;
    if (!silencioso) vista(vistaLista, 'cargando');
    try {
      const r = await admin.solicitudes({ ...estado, por_pagina: POR_PAGINA });
      if (mio !== pedido) return;
      // Página fuera de rango (p. ej. tras filtrar): volver a la última con datos.
      if (r.items.length === 0 && r.total > 0 && estado.pagina > 1) {
        estado.pagina = Math.ceil(r.total / POR_PAGINA);
        actualizarUrl();
        return cargarLista({ silencioso });
      }
      if (r.total === 0) {
        vista(vistaLista, 'vacio', hayFiltros() ? 'No hay solicitudes que coincidan con la búsqueda o los filtros.' : 'Aún no hay solicitudes. Las del formulario de contacto y las cotizaciones por WhatsApp aparecerán aquí.');
        return;
      }
      filas.replaceChildren(...r.items.map(fila));
      const desde = (r.pagina - 1) * r.por_pagina + 1;
      const hasta = desde + r.items.length - 1;
      $('[data-pag-info]').textContent = `Mostrando ${desde}–${hasta} de ${r.total}`;
      $<HTMLButtonElement>('[data-pag="anterior"]').disabled = r.pagina <= 1;
      $<HTMLButtonElement>('[data-pag="siguiente"]').disabled = hasta >= r.total;
      vista(vistaLista, 'listo');
    } catch (err) {
      if (mio === pedido && !esSesionExpirada(err)) vista(vistaLista, 'error', mensajeError(err, 'No se pudieron cargar las solicitudes.'));
    }
  }

  let espera: number | undefined;
  form.addEventListener('input', (e) => {
    const campo = e.target as HTMLInputElement | HTMLSelectElement;
    const aplicar = () => {
      estado.q = (form.elements.namedItem('q') as HTMLInputElement).value.trim();
      estado.estado = (form.elements.namedItem('estado') as HTMLSelectElement).value as EstadoSolicitud | '';
      estado.origen = (form.elements.namedItem('origen') as HTMLSelectElement).value as OrigenSolicitud | '';
      estado.pagina = 1;
      actualizarUrl();
      cargarLista();
    };
    clearTimeout(espera);
    // El texto espera a que se deje de escribir; los selectores aplican al instante.
    if (campo.name === 'q') espera = window.setTimeout(aplicar, 300);
    else aplicar();
  });
  form.addEventListener('submit', (e) => e.preventDefault());

  $('[data-limpiar]').addEventListener('click', () => {
    form.reset();
    Object.assign(estado, { q: '', estado: '', origen: '', pagina: 1 });
    actualizarUrl();
    cargarLista();
  });

  document.querySelectorAll<HTMLButtonElement>('[data-pag]').forEach((b) =>
    b.addEventListener('click', () => {
      estado.pagina += b.dataset.pag === 'siguiente' ? 1 : -1;
      actualizarUrl();
      cargarLista();
      $('.lista').scrollIntoView({ block: 'start', behavior: 'smooth' });
    })
  );

  // ---------- Detalle ----------

  let origenFoco: HTMLElement | null = null;

  function poner(campo: string, valor: string | null) {
    const el = $(`[data-d="${campo}"]`, dialogo);
    el.textContent = valor || '—';
  }

  function enlace(clave: string, href: string | null) {
    const a = $<HTMLAnchorElement>(`[data-r="${clave}"]`, dialogo);
    a.hidden = !href;
    if (href) a.href = href;
  }

  function pintarDetalle(s: SolicitudAdmin) {
    actual = s;
    poner('nombre', s.nombre);
    const ticket = $('[data-d="ticket"]', dialogo);
    ticket.hidden = s.origen !== 'chatbot';
    ticket.textContent = `Cotización #${s.id}`;
    $('[data-d="origen"]', dialogo).replaceChildren(chipOrigen(s.canal));
    $('[data-d="estado"]', dialogo).replaceChildren(chipEstado(s.estado));
    poner('fecha', `Recibida el ${fechaHora(s.fecha_creacion)}`);
    poner('empresa', s.empresa);
    poner('correo', s.correo);
    poner('telefono', s.telefono);

    enlace('correo', s.correo ? enlaceCorreo(s.correo, s.nombre) : null);
    enlace('telefono', s.telefono ? enlaceTelefono(s.telefono) : null);
    // Cotización de WhatsApp: abre el chat con el cliente (sin mensaje; la conversación ya existe).
    const esWa = s.canal === 'whatsapp';
    enlace('whatsapp', s.telefono ? (esWa ? enlaceWa(s.telefono) : enlaceWhatsApp(s.telefono, s.nombre)) : null);
    $('[data-r-texto]', dialogo).textContent = esWa ? 'Abrir chat con el cliente' : 'WhatsApp';
    $('[data-r="whatsapp"]', dialogo).classList.toggle('btn--primary', esWa);
    $('[data-r="whatsapp"]', dialogo).classList.toggle('btn--secondary', !esWa);
    $('[data-r="nada"]', dialogo).hidden = Boolean(s.correo || s.telefono);
    // Abre el calendario con el formulario de cita ya lleno con los datos del cliente.
    $<HTMLAnchorElement>('[data-agendar]', dialogo).href = `/admin/calendario?solicitud=${claveSolicitud(s.origen, s.id)}`;

    const esChatbot = s.chatbot !== null;
    $('[data-d="mensaje"]', dialogo).hidden = esChatbot;
    $('[data-d="chatbot"]', dialogo).hidden = !esChatbot;
    if (esChatbot) {
      const c = s.chatbot!;
      $('[data-l="tipo_servicio"]', dialogo).textContent = esWa ? 'Proyecto' : 'Servicio';
      $('[data-l="alcance"]', dialogo).textContent = esWa ? 'Descripción' : 'Alcance';
      $('[data-l="plazo"]', dialogo).textContent = esWa ? 'Fecha deseada' : 'Plazo';
      $('[data-fila="ubicacion"]', dialogo).hidden = esWa && !c.ubicacion;
      $('[data-fila="presupuesto"]', dialogo).hidden = !esWa && !c.presupuesto;
      poner('tipo_servicio', c.tipo_servicio);
      poner('alcance', c.alcance);
      poner('ubicacion', c.ubicacion);
      poner('plazo', c.plazo);
      poner('presupuesto', c.presupuesto);
    } else {
      poner('mensaje', s.mensaje);
    }

    (formSeg.elements.namedItem('estado') as HTMLSelectElement).value = s.estado;
    (formSeg.elements.namedItem('notas') as HTMLTextAreaElement).value = s.notas ?? '';
    poner('actualizado', s.fecha_actualizacion ? `Último cambio: ${fechaHora(s.fecha_actualizacion)}` : 'Sin cambios desde que llegó.');
    guardado.textContent = '';
    guardado.classList.remove('is-error');
  }

  // ---------- Historial y conversación (solo cotizaciones) ----------

  const secHistorial = $<HTMLDetailsElement>('[data-historial]');
  const secConv = $('[data-conversacion]');
  const convEstado = $('[data-conv-estado]');
  const convLista = $('[data-conv-mensajes]');
  const formSubir = $<HTMLFormElement>('[data-conv-subir]');
  const formAutor = $<HTMLFormElement>('[data-conv-autor]');
  const btnDescargar = $<HTMLButtonElement>('[data-conv-descargar]');

  /** fecha_hora del chat ('YYYY-MM-DD HH:MM:SS', hora del teléfono): se formatea sin zona. */
  const comoUTC = (s: string) => new Date(`${s.replace(' ', 'T')}Z`);
  const fmtDia = new Intl.DateTimeFormat('es-SV', { dateStyle: 'full', timeZone: 'UTC' });
  const fmtHoraChat = new Intl.DateTimeFormat('es-SV', { hour: 'numeric', minute: '2-digit', timeZone: 'UTC' });

  function mostrarEstadoConv(msg: string, error = false) {
    convEstado.textContent = msg;
    convEstado.classList.toggle('is-error', error);
  }

  /** Burbujas: cliente a la izquierda, IntegraTech a la derecha, sistema al centro. Todo con textContent. */
  function pintarConversacion(c: ConversacionCotizacion) {
    const items: HTMLElement[] = [];
    let diaAnterior = '';
    for (const m of c.mensajes) {
      const dia = m.fecha_hora.slice(0, 10);
      if (dia !== diaAnterior) {
        diaAnterior = dia;
        const sep = document.createElement('li');
        sep.className = 'conv__dia';
        sep.textContent = fmtDia.format(comoUTC(m.fecha_hora));
        items.push(sep);
      }
      const li = document.createElement('li');
      const tipo = m.autor === null ? 'sistema' : m.autor === c.autor_integratech ? 'integratech' : 'cliente';
      li.className = `burbuja burbuja--${tipo}`;
      if (m.autor) {
        const a = document.createElement('span');
        a.className = 'burbuja__autor';
        a.textContent = m.autor;
        li.append(a);
      }
      const p = document.createElement('p');
      p.className = 'burbuja__texto';
      p.textContent = m.texto;
      const t = document.createElement('time');
      t.className = 'burbuja__hora';
      t.dateTime = m.fecha_hora.replace(' ', 'T');
      t.textContent = `${m.fecha_hora.slice(8, 10)}/${m.fecha_hora.slice(5, 7)}/${m.fecha_hora.slice(0, 4)} · ${fmtHoraChat.format(comoUTC(m.fecha_hora))}`;
      li.append(p, t);
      items.push(li);
    }
    convLista.replaceChildren(...items);
    btnDescargar.hidden = c.mensajes.length === 0;

    // Selector de autor: obligatorio mientras no se haya elegido uno válido.
    const select = formAutor.elements.namedItem('autor') as HTMLSelectElement;
    const opciones = c.autores.map((a) => {
      const o = document.createElement('option');
      o.value = o.textContent = a;
      return o;
    });
    const vacia = document.createElement('option');
    vacia.value = '';
    vacia.textContent = 'Elige un autor…';
    select.replaceChildren(vacia, ...opciones);
    const valido = c.autor_integratech !== null && c.autores.includes(c.autor_integratech);
    select.value = valido ? c.autor_integratech! : '';
    formAutor.hidden = c.autores.length === 0 || valido;
    // Cambiar el autor después: el mismo formulario, desde el pie.
    const a = c.archivos[0];
    $('[data-conv-archivos]').textContent = a
      ? `${c.archivos.length} ${c.archivos.length === 1 ? 'exportación subida' : 'exportaciones subidas'}; la última: «${a.nombre_original}» el ${fechaHora(a.fecha)}${a.tenia_multimedia ? ' (traía multimedia: solo se guardó el texto)' : ''}.`
      : 'Aún no se ha subido la conversación.';
    if (valido) {
      const cambiar = document.createElement('button');
      cambiar.type = 'button';
      cambiar.className = 'conv__cambiar-autor';
      cambiar.textContent = `IntegraTech = ${c.autor_integratech} (cambiar)`;
      cambiar.addEventListener('click', () => {
        formAutor.hidden = false;
        select.focus();
      });
      $('[data-conv-archivos]').append(cambiar);
    }
  }

  function pintarHistorial(h: import('../../lib/admin').CambioEstado[]) {
    secHistorial.hidden = h.length === 0;
    $('[data-historial-lista]').replaceChildren(
      ...h.map((c) => {
        const li = document.createElement('li');
        li.textContent = `${fechaHora(c.fecha)} · ${c.admin_correo ?? 'usuario eliminado'}: ${c.estado_anterior ? etiquetaEstado(c.estado_anterior) : '—'} → ${etiquetaEstado(c.estado_nuevo)}`;
        return li;
      })
    );
  }

  async function cargarExtrasCotizacion(id: number) {
    try {
      const [conv, hist] = await Promise.all([admin.conversacion(id), admin.historial(id)]);
      if (actual?.origen !== 'chatbot' || actual.id !== id) return; // se abrió otra mientras tanto
      pintarConversacion(conv);
      pintarHistorial(hist);
    } catch (err) {
      if (!esSesionExpirada(err)) mostrarEstadoConv(mensajeError(err, 'No se pudo cargar la conversación.'), true);
    }
  }

  function prepararExtras(s: SolicitudAdmin) {
    const esCotizacion = s.origen === 'chatbot';
    secConv.hidden = !esCotizacion;
    secHistorial.hidden = true;
    secHistorial.open = false;
    convLista.replaceChildren();
    mostrarEstadoConv('');
    formSubir.reset();
    formAutor.hidden = true;
    btnDescargar.hidden = true;
    $('[data-conv-archivos]').textContent = '';
    if (esCotizacion) cargarExtrasCotizacion(s.id);
  }

  formSubir.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!actual) return;
    const input = formSubir.elements.namedItem('archivo') as HTMLInputElement;
    const archivo = input.files?.[0];
    if (!archivo) return mostrarEstadoConv('Elige el archivo .txt o .zip exportado de WhatsApp.', true);
    if (!/\.(txt|zip)$/i.test(archivo.name)) return mostrarEstadoConv('Solo se aceptan archivos .txt o .zip.', true);
    if (archivo.size > 10 * 1024 * 1024) return mostrarEstadoConv('El archivo supera los 10 MB.', true);
    const boton = formSubir.querySelector<HTMLButtonElement>('button')!;
    boton.disabled = true;
    mostrarEstadoConv('Subiendo y leyendo el chat…');
    try {
      const r = await admin.subirConversacion(actual.id, archivo);
      const lineas = [
        r.mensajes_nuevos === 0
          ? `Se leyeron ${r.mensajes_leidos} mensajes; ninguno es nuevo (ya estaban guardados).`
          : `Se leyeron ${r.mensajes_leidos} mensajes; ${r.mensajes_nuevos} nuevo${r.mensajes_nuevos === 1 ? '' : 's'} guardado${r.mensajes_nuevos === 1 ? '' : 's'}.`,
      ];
      if (r.lineas_no_reconocidas > 0) {
        lineas.push(`${r.lineas_no_reconocidas} línea${r.lineas_no_reconocidas === 1 ? '' : 's'} no se reconoci${r.lineas_no_reconocidas === 1 ? 'ó' : 'eron'}: se pegaron al mensaje anterior.`);
      }
      if (r.tenia_multimedia) lineas.push('El chat traía multimedia: por ahora solo se guarda el texto.');
      if (r.necesita_autor) lineas.push('Ahora elige cuál autor es IntegraTech.');
      mostrarEstadoConv(lineas.join('\n'));
      formSubir.reset();
      pintarConversacion(r.conversacion);
      if (r.necesita_autor) (formAutor.elements.namedItem('autor') as HTMLSelectElement).focus();
    } catch (err) {
      if (esSesionExpirada(err)) return;
      mostrarEstadoConv(err instanceof AdminError && err.status >= 400 && err.status < 500 ? err.message : mensajeError(err, 'No se pudo subir el chat.'), true);
    } finally {
      boton.disabled = false;
    }
  });

  formAutor.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!actual) return;
    const autor = (formAutor.elements.namedItem('autor') as HTMLSelectElement).value;
    if (!autor) return;
    try {
      pintarConversacion(await admin.elegirAutorIntegraTech(actual.id, autor));
      mostrarEstadoConv(`Listo: «${autor}» es IntegraTech.`);
    } catch (err) {
      if (!esSesionExpirada(err)) mostrarEstadoConv(mensajeError(err, 'No se pudo guardar el autor.'), true);
    }
  });

  btnDescargar.addEventListener('click', async () => {
    if (!actual) return;
    btnDescargar.disabled = true;
    try {
      const blob = await admin.descargarConversacion(actual.id);
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `cotizacion-${actual.id}.txt`;
      document.body.append(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    } catch (err) {
      if (!esSesionExpirada(err)) mostrarEstadoConv(mensajeError(err, 'No se pudo descargar la conversación.'), true);
    } finally {
      btnDescargar.disabled = false;
    }
  });

  async function abrirDetalle(origen: OrigenSolicitud, id: number, desde?: HTMLElement) {
    origenFoco = desde ?? null;
    abierta = { origen, id };
    actualizarUrl();
    poner('nombre', 'Solicitud');
    if (!dialogo.open) dialogo.showModal();
    vista(vistaDetalle, 'cargando');
    try {
      const s = await admin.solicitud(origen, id);
      pintarDetalle(s);
      prepararExtras(s);
      vista(vistaDetalle, 'listo');
    } catch (err) {
      if (esSesionExpirada(err)) return;
      if ((err as { status?: number }).status === 404) vista(vistaDetalle, 'vacio');
      else vista(vistaDetalle, 'error', mensajeError(err, 'No se pudo cargar la solicitud.'));
    }
  }

  function hayCambiosSinGuardar() {
    if (!actual || vistaDetalle.querySelector('[data-vista="listo"]')?.hasAttribute('hidden')) return false;
    const est = (formSeg.elements.namedItem('estado') as HTMLSelectElement).value;
    const notas = (formSeg.elements.namedItem('notas') as HTMLTextAreaElement).value.trim();
    return est !== actual.estado || notas !== (actual.notas ?? '');
  }

  function cerrarDetalle() {
    if (hayCambiosSinGuardar() && !confirm('Hay cambios sin guardar en esta solicitud. ¿Cerrar de todos modos?')) return;
    dialogo.close();
  }

  dialogo.addEventListener('close', () => {
    abierta = null;
    actual = null;
    actualizarUrl();
    origenFoco?.focus();
  });
  // Escape: el diálogo emite "cancel"; se intercepta para avisar de cambios sin guardar.
  dialogo.addEventListener('cancel', (e) => {
    e.preventDefault();
    cerrarDetalle();
  });
  $('[data-detalle-cerrar]').addEventListener('click', cerrarDetalle);
  // «Agendar cita» sale de la página: avisar si hay estado o notas sin guardar.
  $('[data-agendar]', dialogo).addEventListener('click', (e) => {
    if (hayCambiosSinGuardar() && !confirm('Hay cambios sin guardar en esta solicitud. ¿Ir al calendario de todos modos?')) e.preventDefault();
  });
  // Clic en el fondo (fuera del panel) cierra.
  dialogo.addEventListener('click', (e) => {
    if (e.target === dialogo) cerrarDetalle();
  });

  formSeg.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!actual) return;
    const boton = $<HTMLButtonElement>('[data-guardar]', formSeg);
    boton.disabled = true;
    guardado.classList.remove('is-error');
    guardado.textContent = 'Guardando…';
    try {
      const nuevo = await admin.actualizarSolicitud(actual.origen, actual.id, {
        estado: (formSeg.elements.namedItem('estado') as HTMLSelectElement).value as EstadoSolicitud,
        notas: (formSeg.elements.namedItem('notas') as HTMLTextAreaElement).value,
      });
      pintarDetalle(nuevo);
      guardado.textContent = 'Cambios guardados.';
      cargarLista({ silencioso: true });
      document.dispatchEvent(new Event('avisos:actualizar'));
      if (nuevo.origen === 'chatbot') admin.historial(nuevo.id).then(pintarHistorial).catch(() => {});
    } catch (err) {
      if (esSesionExpirada(err)) return;
      guardado.classList.add('is-error');
      guardado.textContent = mensajeError(err, 'No se pudieron guardar los cambios.');
    } finally {
      boton.disabled = false;
    }
  });

  document.addEventListener('click', (e) => {
    const id = (e.target as HTMLElement).closest<HTMLElement>('[data-reintentar]')?.dataset.reintentar;
    if (id === 'lista') cargarLista();
    if (id === 'detalle' && abierta) abrirDetalle(abierta.origen, abierta.id);
  });

  panelListo().then(() => {
    cargarLista();
    if (abierta) abrirDetalle(abierta.origen, abierta.id);
  });
</script>
