---
import AdminShell from '../../components/admin/AdminShell.astro';
import Vista from '../../components/admin/Vista.astro';
import Icono from '../../components/admin/Icono.astro';

// Las cifras se llenan en el navegador tras confirmar la sesión: el HTML no lleva datos.
const TARJETAS = [
  { id: 'sin_atender', titulo: 'Sin atender', icono: 'alerta', nota: 'en estado Nuevo', href: '/admin/mensajes?estado=nuevo' },
  { id: 'mes', titulo: 'Este mes', icono: 'reloj', nota: '', href: null },
  { id: 'seguimiento', titulo: 'En seguimiento', icono: 'seguimiento', nota: 'contactadas o cotizadas', href: null },
  { id: 'total', titulo: 'Total recibidas', icono: 'bandeja', nota: 'formulario y chatbot', href: '/admin/mensajes' },
  { id: 'citas', titulo: 'Citas (7 días)', icono: 'calendario', nota: 'programadas', href: '/admin/calendario' },
] as const;
---

<AdminShell activo="resumen" titulo="Resumen">
  <!-- Las cifras muestran «—» hasta que llegan los datos -->
  <section class="kpis" aria-label="Cifras clave">
    {TARJETAS.map((t) => (
      <article class="admin-card kpi" data-kpi={t.id}>
        <div class="kpi__icono"><Icono nombre={t.icono} /></div>
        <div class="kpi__txt">
          <h2 class="kpi__titulo">{t.titulo}</h2>
          <p class="kpi__valor" data-kpi-valor>—</p>
          <p class="kpi__nota" data-kpi-nota>{t.nota}</p>
        </div>
        {t.href && <a class="kpi__link" href={t.href} aria-label={`Ver: ${t.titulo}`}>Ver</a>}
      </article>
    ))}
  </section>

  <div class="resumen">
    <!-- Columna principal -->
    <div class="resumen__col">
      <section class="admin-card grafica">
        <div class="admin-card__head">
          <h2>Solicitudes por mes</h2>
          <ul class="leyenda" aria-hidden="true">
            <li><span class="punto punto--formulario"></span>Formulario</li>
            <li><span class="punto punto--chatbot"></span>Chatbot</li>
          </ul>
        </div>
        <Vista id="meses" cargando="Cargando cifras…" vacio="Aún no hay solicitudes. Las del formulario de contacto y el chatbot aparecerán aquí.">
          <div class="admin-card__body">
            <div class="grafica__lienzo grafica__lienzo--barras">
              <canvas data-grafica-meses role="img"></canvas>
            </div>
          </div>
        </Vista>
      </section>

      <section class="admin-card recientes">
        <div class="admin-card__head">
          <h2>Solicitudes recientes</h2>
          <a href="/admin/mensajes" class="btn btn--secondary btn--sm">Ver todas</a>
        </div>
        <Vista id="recientes" cargando="Cargando solicitudes…" vacio="Aún no hay solicitudes.">
          <table class="tabla-recientes">
            <thead>
              <tr>
                <th scope="col">Fecha</th>
                <th scope="col">Nombre</th>
                <th scope="col">Origen</th>
                <th scope="col">Estado</th>
                <th scope="col"><span class="sr-only">Acciones</span></th>
              </tr>
            </thead>
            <tbody data-recientes></tbody>
          </table>
        </Vista>
      </section>
    </div>

    <!-- Columna derecha -->
    <div class="resumen__col">
      <section class="admin-card grafica">
        <div class="admin-card__head"><h2>Por estado</h2></div>
        <Vista id="estados" cargando="Cargando…" vacio="Sin solicitudes todavía.">
          <div class="admin-card__body dona">
            <div class="grafica__lienzo grafica__lienzo--dona">
              <canvas data-grafica-estados role="img"></canvas>
              <p class="dona__centro"><strong data-dona-total></strong><span>total</span></p>
            </div>
            <ul class="dona__leyenda" data-leyenda-estados></ul>
          </div>
        </Vista>
      </section>

      <section class="admin-card citas" aria-labelledby="t-citas">
        <div class="admin-card__head">
          <h2 id="t-citas">Próximas citas</h2>
          <a href="/admin/calendario" class="btn btn--secondary btn--sm">Calendario</a>
        </div>
        <Vista id="citas" cargando="Cargando citas…" vacio="No hay citas programadas." iconoVacio="calendario">
          <ul class="lista-citas" data-citas></ul>
        </Vista>
      </section>
    </div>
  </div>
</AdminShell>

<style>
  /* ---------- Cifras clave ---------- */
  .kpis {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(190px, 100%), 1fr));
    gap: 1rem;
  }
  .kpi {
    position: relative;
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    padding: 1.1rem 1.2rem;
  }
  .kpi__icono {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: var(--color-brand-blue-tint);
    color: var(--color-brand-blue);
  }
  .kpi[data-kpi='sin_atender'] .kpi__icono {
    background: color-mix(in srgb, var(--color-accent) 16%, var(--color-white));
    color: var(--color-navy);
  }
  .kpi__titulo { margin: 0; font-size: 0.85rem; font-weight: 600; color: var(--text-muted); }
  .kpi__valor { margin: 0.1rem 0 0; font-size: 1.9rem; font-weight: 700; line-height: 1.15; color: var(--heading); }
  .kpi__nota { margin: 0.15rem 0 0; font-size: 0.8rem; color: var(--text-muted); }
  .kpi__link { position: absolute; top: 1rem; right: 1.1rem; font-size: 0.82rem; font-weight: 600; }
  .kpi:has(.kpi__link) .kpi__txt { padding-right: 1.6rem; }

  /* ---------- Columnas: principal (gráfica, recientes) y derecha (estados, citas) ---------- */
  .resumen {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 1rem;
    margin-top: 1rem;
    align-items: start;
  }
  .resumen__col { display: flex; flex-direction: column; gap: 1rem; min-width: 0; }
  .leyenda { display: flex; gap: 1rem; list-style: none; margin: 0; padding: 0; font-size: 0.8rem; color: var(--text-muted); }
  .leyenda li { display: flex; align-items: center; gap: 0.4rem; margin: 0; }
  .punto { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }
  .punto--formulario { background: var(--serie-formulario); }
  .punto--chatbot { background: var(--serie-chatbot); }

  .grafica { display: flex; flex-direction: column; }
  .grafica :global(.admin-card__body) { display: flex; }
  .grafica__lienzo { position: relative; }
  .grafica__lienzo--barras { flex: 1; min-height: 280px; }
  .grafica__lienzo--dona { width: 200px; height: 200px; flex-shrink: 0; }
  .dona { display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; justify-content: center; }
  .dona__centro {
    position: absolute;
    inset: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    line-height: 1.1;
  }
  .dona__centro strong { font-size: 1.7rem; color: var(--heading); }
  .dona__centro span { font-size: 0.78rem; color: var(--text-muted); }
  .dona__leyenda { list-style: none; margin: 0; padding: 0; min-width: 150px; flex: 1; }
  .dona__leyenda :global(li) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.88rem;
  }
  .dona__leyenda :global(li:last-child) { border-bottom: 0; }
  .dona__leyenda :global(strong) { color: var(--heading); }

  /* ---------- Recientes ---------- */
  .recientes :global(.vista) { padding: 0.5rem 0 0.25rem; }
  .tabla-recientes { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .tabla-recientes th {
    text-align: left;
    padding: 0.6rem 1.25rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
  }
  .tabla-recientes :global(td) { padding: 0.7rem 1.25rem; border-bottom: 1px solid var(--border); vertical-align: middle; }
  .tabla-recientes :global(tr:last-child td) { border-bottom: 0; }
  .tabla-recientes :global(.c-nombre strong) { display: block; color: var(--heading); }
  .tabla-recientes :global(.c-nombre small) { color: var(--text-muted); }
  .tabla-recientes :global(.c-fecha) { white-space: nowrap; color: var(--text-muted); }
  .tabla-recientes :global(.c-accion) { text-align: right; }

  @media (max-width: 1100px) {
    .resumen { grid-template-columns: minmax(0, 1fr); }
  }
  /* Móvil: cifras en 2 columnas y cada fila de la tabla como tarjeta */
  @media (max-width: 640px) {
    .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
    .kpi:last-child:nth-child(odd) { grid-column: span 2; }
    .kpi { flex-direction: column; gap: 0.5rem; padding: 0.9rem; }
    .kpi__icono { width: 34px; height: 34px; border-radius: 10px; }
    .kpi__valor { font-size: 1.6rem; }
    .kpi__link { top: 0.9rem; right: 0.9rem; }

    .tabla-recientes thead { display: none; }
    .tabla-recientes :global(tr) {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.4rem 0.5rem;
      padding: 0.85rem 1.25rem;
      border-bottom: 1px solid var(--border);
    }
    .tabla-recientes :global(tr:last-child) { border-bottom: 0; }
    .tabla-recientes :global(td) { padding: 0; border: 0; }
    .tabla-recientes :global(.c-nombre) { order: 1; flex: 1 1 0; min-width: 0; }
    .tabla-recientes :global(.c-accion) { order: 2; }
    .tabla-recientes :global(.c-fecha) { order: 3; flex-basis: 100%; font-size: 0.8rem; }
    .tabla-recientes :global(.c-chips) { order: 4; }
    .grafica__lienzo--barras { min-height: 220px; }
  }
</style>

<script>
  import {
    Chart,
    BarController,
    BarElement,
    CategoryScale,
    LinearScale,
    DoughnutController,
    ArcElement,
    Tooltip,
  } from 'chart.js';
  import { admin, type EstadisticasAdmin, type SolicitudAdmin } from '../../lib/admin';
  import {
    panelListo,
    vista,
    mensajeError,
    esSesionExpirada,
    ESTADOS,
    colorEstado,
    chipEstado,
    chipOrigen,
    claveSolicitud,
    fechaCorta,
    mesCorto,
    mesLargo,
    itemCita,
    diaLargo,
    rangoHoras,
  } from '../../lib/admin-ui';

  // Solo los módulos que se usan: el resto de Chart.js no entra al bundle.
  Chart.register(BarController, BarElement, CategoryScale, LinearScale, DoughnutController, ArcElement, Tooltip);

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const vistaMeses = $('[data-vista-de="meses"]');
  const vistaEstados = $('[data-vista-de="estados"]');
  const vistaRec = $('[data-vista-de="recientes"]');
  const vistaCitas = $('[data-vista-de="citas"]');
  const css = (v: string) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();
  const animar = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let graficaMeses: Chart | null = null;
  let graficaEstados: Chart | null = null;

  function kpi(id: string, valor: number, nota?: string) {
    const card = $(`[data-kpi="${id}"]`);
    card.querySelector('[data-kpi-valor]')!.textContent = valor.toLocaleString('es-SV');
    if (nota) card.querySelector('[data-kpi-nota]')!.textContent = nota;
  }

  function llenarKpis(e: EstadisticasAdmin) {
    kpi('sin_atender', e.sin_atender);
    kpi('mes', e.mes_actual.total, mesLargo(e.mes_actual.mes));
    kpi('seguimiento', e.por_estado.contactado + e.por_estado.cotizado);
    kpi('total', e.total);
  }

  function pintarEstadisticas(e: EstadisticasAdmin) {
    // Barras: solicitudes por mes, formulario y chatbot
    const lienzoMeses = $<HTMLCanvasElement>('[data-grafica-meses]');
    lienzoMeses.setAttribute(
      'aria-label',
      'Solicitudes por mes: ' +
        e.por_mes.map((m) => `${mesLargo(m.mes)}, ${m.formulario} del formulario y ${m.chatbot} del chatbot`).join('; ')
    );
    graficaMeses?.destroy();
    graficaMeses = new Chart(lienzoMeses, {
      type: 'bar',
      data: {
        labels: e.por_mes.map((m) => mesCorto(m.mes)),
        datasets: [
          { label: 'Formulario', data: e.por_mes.map((m) => m.formulario), backgroundColor: css('--serie-formulario'), borderRadius: 6, maxBarThickness: 28 },
          { label: 'Chatbot', data: e.por_mes.map((m) => m.chatbot), backgroundColor: css('--serie-chatbot'), borderRadius: 6, maxBarThickness: 28 },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: animar ? undefined : false,
        plugins: { tooltip: { mode: 'index', intersect: false } },
        scales: {
          x: { grid: { display: false }, ticks: { color: css('--text-muted') } },
          y: { beginAtZero: true, ticks: { precision: 0, color: css('--text-muted') }, grid: { color: css('--border') } },
        },
      },
    });

    // Dona: conteo por estado (con leyenda propia, legible y accesible)
    const lienzoEstados = $<HTMLCanvasElement>('[data-grafica-estados]');
    const valores = ESTADOS.map((s) => e.por_estado[s.valor]);
    lienzoEstados.setAttribute('aria-label', 'Solicitudes por estado: ' + ESTADOS.map((s, i) => `${s.etiqueta} ${valores[i]}`).join(', '));
    $('[data-dona-total]').textContent = e.total.toLocaleString('es-SV');
    graficaEstados?.destroy();
    graficaEstados = new Chart(lienzoEstados, {
      type: 'doughnut',
      data: {
        labels: ESTADOS.map((s) => s.etiqueta),
        datasets: [{ data: valores, backgroundColor: ESTADOS.map((s) => colorEstado(s.valor)), borderColor: css('--surface-card'), borderWidth: 2 }],
      },
      options: { responsive: true, maintainAspectRatio: false, cutout: '68%', animation: animar ? undefined : false },
    });

    $('[data-leyenda-estados]').replaceChildren(
      ...ESTADOS.map((s, i) => {
        const li = document.createElement('li');
        const n = document.createElement('strong');
        n.textContent = String(valores[i]);
        li.append(chipEstado(s.valor), n);
        return li;
      })
    );
  }

  function filaReciente(s: SolicitudAdmin) {
    const tr = document.createElement('tr');
    const td = (clase: string, ...hijos: (Node | string)[]) => {
      const c = document.createElement('td');
      c.className = clase;
      c.append(...hijos);
      return c;
    };
    const nombre = document.createElement('strong');
    nombre.textContent = s.nombre;
    const empresa = document.createElement('small');
    empresa.textContent = s.empresa ?? '';
    const ver = document.createElement('a');
    ver.className = 'btn btn--secondary btn--sm';
    ver.href = `/admin/mensajes?ver=${claveSolicitud(s.origen, s.id)}`;
    ver.textContent = 'Ver';
    ver.setAttribute('aria-label', `Ver solicitud de ${s.nombre}`);

    tr.append(
      td('c-fecha', fechaCorta(s.fecha_creacion)),
      td('c-nombre', nombre, empresa),
      td('c-chips c-origen', chipOrigen(s.origen)),
      td('c-chips c-estado', chipEstado(s.estado)),
      td('c-accion', ver)
    );
    return tr;
  }

  async function cargarEstadisticas() {
    vista(vistaMeses, 'cargando');
    vista(vistaEstados, 'cargando');
    try {
      const e = await admin.estadisticas();
      llenarKpis(e);
      if (e.total === 0) {
        vista(vistaMeses, 'vacio');
        vista(vistaEstados, 'vacio');
        return;
      }
      // Se muestra antes de dibujar: Chart.js necesita el lienzo visible para medirlo.
      vista(vistaMeses, 'listo');
      vista(vistaEstados, 'listo');
      pintarEstadisticas(e);
    } catch (err) {
      if (esSesionExpirada(err)) return;
      vista(vistaMeses, 'error', mensajeError(err, 'No se pudieron cargar las cifras.'));
      vista(vistaEstados, 'error', mensajeError(err, 'No se pudieron cargar las cifras.'));
    }
  }

  async function cargarCitas() {
    vista(vistaCitas, 'cargando');
    try {
      const r = await admin.citasProximas(5);
      kpi('citas', r.proximos_7_dias);
      if (r.items.length === 0) return vista(vistaCitas, 'vacio');
      $('[data-citas]').replaceChildren(
        ...r.items.map((c) => {
          const { li, control } = itemCita(c, `/admin/calendario?mes=${c.inicio_local.slice(0, 7)}&cita=${c.id}`);
          control.setAttribute('aria-label', `${c.titulo}, ${diaLargo(c.inicio_local.slice(0, 10))}, ${rangoHoras(c.inicio, c.fin)}`);
          return li;
        })
      );
      vista(vistaCitas, 'listo');
    } catch (err) {
      if (!esSesionExpirada(err)) vista(vistaCitas, 'error', mensajeError(err, 'No se pudieron cargar las citas.'));
    }
  }

  async function cargarRecientes() {
    vista(vistaRec, 'cargando');
    try {
      const { items } = await admin.solicitudes({ por_pagina: 6 });
      if (items.length === 0) return vista(vistaRec, 'vacio');
      $('[data-recientes]').replaceChildren(...items.map(filaReciente));
      vista(vistaRec, 'listo');
    } catch (err) {
      if (!esSesionExpirada(err)) vista(vistaRec, 'error', mensajeError(err, 'No se pudieron cargar las solicitudes.'));
    }
  }

  document.addEventListener('click', (e) => {
    const id = (e.target as HTMLElement).closest<HTMLElement>('[data-reintentar]')?.dataset.reintentar;
    if (id === 'meses' || id === 'estados') cargarEstadisticas();
    if (id === 'recientes') cargarRecientes();
    if (id === 'citas') cargarCitas();
  });

  panelListo().then(() => {
    cargarEstadisticas();
    cargarRecientes();
    cargarCitas();
  });
</script>
