---
import { Image } from 'astro:assets';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { logoBlanco } from '../../lib/imagenes';
---

<AdminLayout title="Iniciar sesión">
  <main class="login">
    <!-- Panel de marca (decorativo en móvil: se reduce a una franja) -->
    <section class="login__marca" aria-label="Servicios Integrales de Ingeniería">
      <Image src={logoBlanco} alt="Servicios Integrales de Ingeniería" widths={[260, 520]} sizes="260px" loading="eager" class="login__logo" />
      <div class="login__lema">
        <span class="login__eyebrow">Panel de administración</span>
        <p>Mensajes, citas y servicios del sitio web, en un solo lugar.</p>
      </div>
      <svg class="login__circulos" viewBox="0 0 200 200" aria-hidden="true">
        <circle cx="100" cy="100" r="96" />
        <circle cx="100" cy="100" r="74" />
      </svg>
    </section>

    <div class="login__lado">
      <p class="admin-cargando" data-verificando>Verificando sesión…</p>

      <form class="login__card" data-login-form hidden novalidate>
        <h1>Iniciar sesión</h1>
        <p class="login__sub">Acceso para el equipo de SIIE.</p>

        <label>
          Correo
          <input name="correo" type="email" autocomplete="username" required maxlength="200" />
        </label>
        <label>
          Contraseña
          <input name="password" type="password" autocomplete="current-password" required maxlength="200" />
        </label>

        <p class="admin-alert" data-login-error role="alert" hidden></p>

        <button type="submit" class="btn btn--primary btn--block btn--lg" data-login-submit>Ingresar</button>
        <a href="/" class="login__volver">← Volver al sitio</a>
      </form>
    </div>
  </main>
</AdminLayout>

<style>
  .login {
    min-height: 100vh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    background: var(--color-white);
  }

  /* ---------- Panel de marca ---------- */
  .login__marca {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(2rem, 5vw, 4rem);
    color: var(--color-text-on-dark);
    background:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px) 0 0 / 56px 56px,
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px) 0 0 / 56px 56px,
      radial-gradient(ellipse 80% 70% at 100% 100%, color-mix(in srgb, var(--color-brand-blue) 60%, transparent), transparent 70%),
      linear-gradient(160deg, var(--color-navy) 0%, var(--color-navy-deep) 100%);
  }
  .login__logo { position: relative; width: min(260px, 70%); height: auto; }
  .login__lema { position: relative; max-width: 30ch; }
  .login__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.9rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent-light);
  }
  .login__eyebrow::before { content: ''; width: 28px; height: 2px; background: currentColor; }
  .login__lema p {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem);
    font-weight: 600;
    line-height: 1.15;
    color: var(--color-white);
  }
  .login__circulos {
    position: absolute;
    width: 70%;
    right: -18%;
    top: 18%;
    fill: none;
    stroke: rgba(255, 255, 255, 0.22);
    stroke-width: 1.2;
    stroke-dasharray: 4 5;
  }

  /* ---------- Formulario ---------- */
  .login__lado {
    display: grid;
    place-items: center;
    padding: clamp(2rem, 5vw, 4rem) 1.25rem;
  }
  .login .admin-cargando { min-height: 0; }
  .login__card {
    width: min(400px, 100%);
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .login__card[hidden] { display: none; }
  .login__card h1 { font-size: 2.25rem; margin: 0; }
  .login__sub { margin: -0.5rem 0 0.75rem; color: var(--text-muted); }
  .login__card label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .login__card input { min-height: 48px; font-size: 1rem; }
  .login__volver { align-self: center; font-size: 0.92rem; color: var(--text-muted); }
  .login__volver:hover { color: var(--link); }

  @media (max-width: 860px) {
    .login { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }
    .login__marca { padding: 1.5rem 1.25rem; }
    .login__lema, .login__circulos { display: none; }
    .login__logo { width: 200px; }
  }
</style>

<script>
  import { admin, AdminError, DASHBOARD_PATH } from '../../lib/admin';

  const form = document.querySelector<HTMLFormElement>('[data-login-form]')!;
  const verificando = document.querySelector<HTMLElement>('[data-verificando]')!;
  const errorBox = document.querySelector<HTMLElement>('[data-login-error]')!;
  const submit = document.querySelector<HTMLButtonElement>('[data-login-submit]')!;

  function mostrarError(msg: string) {
    errorBox.textContent = msg;
    errorBox.hidden = false;
  }

  function mostrarFormulario() {
    verificando.hidden = true;
    form.hidden = false;
    form.querySelector<HTMLInputElement>('input[name="correo"]')?.focus();
  }

  function mensajeLogin(err: unknown): string {
    if (!(err instanceof AdminError)) return 'Ocurrió un error inesperado. Intenta de nuevo.';
    if (err.status === 0) return 'No se pudo conectar con el servidor. Revisa tu conexión e intenta de nuevo.';
    if (err.status === 401) return 'Correo o contraseña incorrectos.';
    if (err.status === 429) return 'Demasiados intentos. Espera unos minutos antes de volver a intentar.';
    if (err.status === 403) return 'Este sitio no tiene permiso para acceder al panel (origen no permitido).';
    return 'El servidor no pudo procesar el inicio de sesión. Intenta más tarde.';
  }

  // Con una sesión activa no tiene sentido mostrar el formulario.
  admin
    .sesion()
    .then((usuario) => (usuario ? location.replace(DASHBOARD_PATH) : mostrarFormulario()))
    .catch((err) => {
      mostrarFormulario();
      mostrarError(mensajeLogin(err));
    });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const correo = String(fd.get('correo') ?? '').trim();
    const password = String(fd.get('password') ?? '');
    if (!correo || !password) {
      mostrarError('Escribe tu correo y tu contraseña.');
      return;
    }

    errorBox.hidden = true;
    submit.disabled = true;
    submit.textContent = 'Ingresando…';
    try {
      await admin.login(correo, password);
      location.replace(DASHBOARD_PATH);
    } catch (err) {
      mostrarError(mensajeLogin(err));
      submit.disabled = false;
      submit.textContent = 'Ingresar';
      form.querySelector<HTMLInputElement>('input[name="password"]')!.value = '';
    }
  });
</script>
