---
import AdminShell from '../../components/admin/AdminShell.astro';
import Vista from '../../components/admin/Vista.astro';
import Icono from '../../components/admin/Icono.astro';
import { ESTADOS_CITA } from '../../lib/admin-ui';

// Página estática: el mes, las citas y el formulario se llenan en el navegador
// tras confirmar la sesión. Parámetros: ?mes=YYYY-MM, ?cita=ID (abre una cita),
// ?nueva=YYYY-MM-DD (cita nueva ese día), ?solicitud=formulario-12 (cita nueva con
// los datos de esa solicitud).
const DIAS = ['lun', 'mar', 'mié', 'jue', 'vie', 'sáb', 'dom'];
---

<AdminShell activo="calendario" titulo="Calendario">
  <div class="barra">
    <div class="barra__mes">
      <button type="button" class="icono-btn" data-mes="-1" aria-label="Mes anterior"><Icono nombre="izquierda" tamano={18} /></button>
      <h2 class="barra__titulo" data-titulo-mes aria-live="polite">&nbsp;</h2>
      <button type="button" class="icono-btn" data-mes="1" aria-label="Mes siguiente"><Icono nombre="derecha" tamano={18} /></button>
      <button type="button" class="btn btn--secondary btn--sm" data-hoy>Hoy</button>
    </div>
    <button type="button" class="btn btn--primary" data-nueva><Icono nombre="mas" tamano={18} />Nueva cita</button>
  </div>

  <div class="calendario-layout">
    <section class="admin-card cal" aria-label="Calendario del mes">
      <Vista id="mes" cargando="Cargando citas…">
        <!-- Escritorio: cuadrícula mensual -->
        <div class="mes" data-mes-grid>
          <div class="mes__cabecera" aria-hidden="true">
            {DIAS.map((d) => <span>{d}</span>)}
          </div>
          <div class="mes__dias" data-dias></div>
        </div>
        <!-- Móvil: lista por día -->
        <div class="agenda" data-agenda></div>
      </Vista>
    </section>

    <aside class="admin-card proximas" aria-labelledby="t-proximas">
      <div class="admin-card__head"><h2 id="t-proximas">Próximas citas</h2></div>
      <Vista id="proximas" cargando="Cargando…" vacio="No hay citas programadas." iconoVacio="calendario">
        <ul class="lista-citas" data-proximas></ul>
      </Vista>
    </aside>
  </div>

  <p class="leyenda">
    <span class="chip chip--programada">Programada</span>
    <span class="chip chip--completada">Completada</span>
    <span class="chip chip--cancelada">Cancelada</span>
    <span class="leyenda__ayuda">Haz clic en un día para agendar una cita, o en una cita para editarla.</span>
  </p>

  <!-- Formulario de cita -->
  <dialog class="detalle" data-dialogo aria-labelledby="t-cita">
    <div class="detalle__head">
      <h2 id="t-cita" data-dialogo-titulo>Nueva cita</h2>
      <button type="button" class="detalle__cerrar" data-cerrar aria-label="Cerrar"><Icono nombre="cerrar" /></button>
    </div>
    <form class="cita-form" data-form novalidate>
      <p class="cita-form__origen" data-origen hidden></p>

      <div class="campo">
        <label for="c-titulo">Título <span aria-hidden="true">*</span></label>
        <input id="c-titulo" name="titulo" type="text" maxlength="150" required placeholder="Ej.: Visita técnica, Instalación de UPS…" />
        <p class="campo__error" data-error="titulo"></p>
      </div>

      <div class="campo-fila">
        <div class="campo">
          <label for="c-inicio">Inicio <span aria-hidden="true">*</span></label>
          <input id="c-inicio" name="inicio_local" type="datetime-local" required step="900" />
          <p class="campo__error" data-error="inicio_local"></p>
        </div>
        <div class="campo">
          <label for="c-fin">Fin <span aria-hidden="true">*</span></label>
          <input id="c-fin" name="fin_local" type="datetime-local" required step="900" />
          <p class="campo__error" data-error="fin_local"></p>
        </div>
      </div>
      <p class="campo__ayuda">Hora de El Salvador.</p>

      <div class="campo">
        <label for="c-cliente">Cliente o empresa</label>
        <input id="c-cliente" name="cliente" type="text" maxlength="150" />
        <p class="campo__error" data-error="cliente"></p>
      </div>
      <div class="campo-fila">
        <div class="campo">
          <label for="c-telefono">Teléfono</label>
          <input id="c-telefono" name="telefono" type="tel" maxlength="40" />
          <p class="campo__error" data-error="telefono"></p>
        </div>
        <div class="campo">
          <label for="c-correo">Correo</label>
          <input id="c-correo" name="correo" type="email" maxlength="200" />
          <p class="campo__error" data-error="correo"></p>
        </div>
      </div>

      <div class="campo">
        <label for="c-servicio">Servicio relacionado</label>
        <select id="c-servicio" name="servicio_id">
          <option value="">Ninguno</option>
        </select>
        <p class="campo__error" data-error="servicio_id"></p>
      </div>
      <div class="campo">
        <label for="c-lugar">Lugar</label>
        <input id="c-lugar" name="lugar" type="text" maxlength="200" placeholder="Dirección o referencia" />
        <p class="campo__error" data-error="lugar"></p>
      </div>
      <div class="campo">
        <label for="c-notas">Notas</label>
        <textarea id="c-notas" name="notas" rows="4" maxlength="5000"></textarea>
        <p class="campo__error" data-error="notas"></p>
      </div>
      <div class="campo" data-campo-estado hidden>
        <label for="c-estado">Estado</label>
        <select id="c-estado" name="estado">
          {ESTADOS_CITA.map((e) => <option value={e.valor}>{e.etiqueta}</option>)}
        </select>
      </div>

      <!-- Advertencia de traslape: se muestra tras el 409 del servidor -->
      <div class="traslape" data-traslape role="alert" hidden>
        <p class="traslape__titulo"><Icono nombre="alerta" tamano={18} /><span data-traslape-texto></span></p>
        <ul data-traslape-lista></ul>
        <p class="traslape__pregunta">Puedes cambiar la hora o guardarla de todos modos.</p>
        <button type="button" class="btn btn--secondary btn--sm" data-forzar>Guardar de todos modos</button>
      </div>

      <div class="cita-form__acciones">
        <button type="submit" class="btn btn--primary" data-guardar>Guardar cita</button>
        <button type="button" class="btn btn--secondary" data-cerrar>Cerrar</button>
        <button type="button" class="btn cita-form__cancelar" data-cancelar-cita hidden>Cancelar cita</button>
        <p class="cita-form__estado" data-estado role="status"></p>
      </div>
    </form>
  </dialog>

  <!-- Plantillas (sin datos) -->
  <template data-plantilla-dia>
    <div class="dia" role="group">
      <button type="button" class="dia__num" data-dia-nueva></button>
      <ul class="dia__citas" data-dia-citas></ul>
      <button type="button" class="dia__mas" data-dia-mas hidden></button>
    </div>
  </template>
</AdminShell>

<style>
  .barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .barra__mes { display: flex; align-items: center; gap: 0.5rem; }
  .barra__titulo { margin: 0 0.25rem; min-width: 11ch; font-size: 1.3rem; }
  :global(.icono-btn) {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface-card);
    color: var(--text);
    cursor: pointer;
  }
  :global(.icono-btn:hover) { background: var(--surface-muted); }

  .calendario-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 1rem;
    align-items: start;
  }
  .cal { overflow: hidden; }

  /* ---------- Cuadrícula mensual ---------- */
  .mes__cabecera {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    background: var(--surface-muted);
    border-bottom: 1px solid var(--border);
  }
  .mes__cabecera span {
    padding: 0.55rem 0.6rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
  .mes__dias { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); }
  .mes__dias :global(.dia) {
    position: relative;
    min-height: 118px;
    padding: 0.35rem 0.4rem 0.45rem;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }
  .mes__dias :global(.dia:nth-child(7n)) { border-right: 0; }
  .mes__dias :global(.dia:hover) { background: color-mix(in srgb, var(--color-accent) 5%, var(--surface-card)); }
  .mes__dias :global(.dia.is-fuera) { background: var(--surface-muted); }
  .mes__dias :global(.dia.is-fuera .dia__num) { color: var(--placeholder-border); }
  .mes__dias :global(.dia__num) {
    align-self: flex-start;
    display: grid;
    place-items: center;
    min-width: 28px;
    height: 28px;
    padding: 0 0.35rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }
  .mes__dias :global(.dia__num:hover) { background: var(--color-brand-blue-tint); }
  .mes__dias :global(.dia.is-hoy .dia__num) { background: var(--color-brand-blue); color: var(--color-on-brand-blue); }
  .mes__dias :global(.dia__citas) { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
  .mes__dias :global(.dia__citas li) { margin: 0; min-width: 0; }
  .mes__dias :global(.dia:not(.is-expandido) .dia__citas li:nth-child(n + 4)) { display: none; }
  .mes__dias :global(.dia__mas) {
    align-self: flex-start;
    border: 0;
    background: transparent;
    padding: 0 0.3rem;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--link);
    cursor: pointer;
  }

  /* Cita dentro del día */
  .cal :global(.cita-chip) {
    display: block;
    width: 100%;
    padding: 0.2rem 0.4rem;
    border: 0;
    border-left: 3px solid var(--cita-color);
    border-radius: 4px;
    background: color-mix(in srgb, var(--cita-color) 14%, var(--surface-card));
    color: var(--color-navy);
    font: inherit;
    font-size: 0.75rem;
    line-height: 1.3;
    text-align: left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    cursor: pointer;
  }
  .cal :global(.cita-chip:hover) { background: color-mix(in srgb, var(--cita-color) 24%, var(--surface-card)); }
  .cal :global(.cita-chip strong) { font-weight: 700; margin-right: 0.25rem; }
  /* En la cuadrícula la hora va en su propia línea: deja todo el ancho al título */
  .mes__dias :global(.cita-chip strong) { display: block; margin: 0; font-size: 0.68rem; font-weight: 600; color: var(--text-muted); }
  :global(.cita--programada) { --cita-color: var(--cita-programada); }
  :global(.cita--completada) { --cita-color: var(--cita-completada); }
  :global(.cita--cancelada) { --cita-color: var(--cita-cancelada); }
  .cal :global(.cita-chip.cita--cancelada) { text-decoration: line-through; color: var(--text-muted); }

  /* ---------- Agenda (móvil) ---------- */
  .agenda { display: none; }
  .agenda :global(.agenda__dia) { padding: 0.85rem 1rem; border-bottom: 1px solid var(--border); }
  .agenda :global(.agenda__dia:last-child) { border-bottom: 0; }
  .agenda :global(.agenda__dia.is-hoy h3) { color: var(--color-brand-blue); }
  .agenda :global(.agenda__dia h3) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
    font-size: 0.92rem;
  }
  .agenda :global(.agenda__dia ul) { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .agenda :global(.agenda__dia li) { margin: 0; }
  .agenda :global(.agenda__dia .cita-chip) { white-space: normal; font-size: 0.85rem; padding: 0.5rem 0.65rem; }
  .agenda :global(.agenda__vacio) { padding: 1.5rem 1rem; text-align: center; color: var(--text-muted); font-size: 0.9rem; }

  .leyenda { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin: 1rem 0 0; }
  .leyenda__ayuda { font-size: 0.82rem; color: var(--text-muted); margin-left: 0.25rem; }

  /* ---------- Formulario (panel lateral) ---------- */
  .detalle {
    margin: 0 0 0 auto;
    width: min(520px, 100vw);
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
    padding: 0;
    border: 0;
    background: var(--surface-card);
    color: var(--text);
    box-shadow: var(--shadow-lg);
  }
  .detalle::backdrop { background: var(--overlay-backdrop); opacity: 0.55; }
  .detalle[open] { display: flex; flex-direction: column; }
  .detalle__head {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--surface-card);
    border-bottom: 1px solid var(--border);
  }
  .detalle__head h2 { margin: 0; font-size: 1.2rem; }
  .detalle__cerrar {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  .cita-form { padding: 1.1rem 1.25rem 2rem; display: flex; flex-direction: column; gap: 0.9rem; }
  .cita-form__origen {
    margin: 0;
    padding: 0.6rem 0.8rem;
    border-radius: var(--radius);
    background: var(--color-brand-blue-tint);
    font-size: 0.85rem;
  }
  .campo { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
  .campo label { font-size: 0.85rem; font-weight: 600; }
  .campo label span { color: var(--danger-text); }
  .campo :is(input, select, textarea) { width: 100%; font-weight: 400; }
  .campo textarea { resize: vertical; }
  .campo :is(input, select, textarea)[aria-invalid='true'] { border-color: var(--danger-text); }
  .campo-fila { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .campo__error { margin: 0; font-size: 0.8rem; color: var(--danger-text); }
  .campo__error:empty { display: none; }
  .campo__ayuda { margin: -0.5rem 0 0; font-size: 0.78rem; color: var(--text-muted); }

  .traslape {
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--estado-cotizado);
    background: color-mix(in srgb, var(--estado-cotizado) 10%, var(--surface-card));
    font-size: 0.88rem;
  }
  .traslape__titulo { display: flex; align-items: center; gap: 0.45rem; margin: 0 0 0.4rem; font-weight: 700; color: var(--color-navy); }
  .traslape ul { margin: 0 0 0.5rem; padding-left: 1.2rem; }
  .traslape__pregunta { margin: 0 0 0.6rem; color: var(--text-muted); }

  .cita-form__acciones { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; padding-top: 0.5rem; border-top: 1px solid var(--border); }
  .cita-form__cancelar { margin-left: auto; background: transparent; color: var(--danger-text); border-color: var(--danger-text); }
  .cita-form__estado { flex-basis: 100%; margin: 0; font-size: 0.85rem; color: var(--text-muted); }
  .cita-form__estado:empty { display: none; }
  .cita-form__estado.is-error { color: var(--danger-text); }

  @media (max-width: 1100px) {
    /* minmax(0, …): la columna no crece al ancho del texto más largo */
    .calendario-layout { grid-template-columns: minmax(0, 1fr); }
  }
  /* Móvil: la cuadrícula se reemplaza por la lista por día */
  @media (max-width: 760px) {
    .mes { display: none; }
    .agenda { display: block; }
    .barra { gap: 0.6rem; }
    .barra [data-nueva] { width: 100%; justify-content: center; }
    .barra__titulo { font-size: 1.1rem; min-width: 0; flex: 1; text-align: center; }
    .barra__mes { width: 100%; }
    .campo-fila { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { admin, AdminError, type Cita, type CitaDatos, type ServicioAdmin } from '../../lib/admin';
  import {
    panelListo,
    vista,
    mensajeError,
    esSesionExpirada,
    hoyLocal,
    sumarDiasLocal,
    horaCita,
    rangoHoras,
    diaLargo,
    diaCorto,
    mesLargo,
    etiquetaEstadoCita,
    leerClave,
    claveSolicitud,
    fechaCorta,
    itemCita,
    mayuscula,
  } from '../../lib/admin-ui';

  const $ = <T extends HTMLElement>(sel: string, raiz: ParentNode = document) => raiz.querySelector<T>(sel)!;

  const vistaMes = $('[data-vista-de="mes"]');
  const vistaProximas = $('[data-vista-de="proximas"]');
  const dias = $('[data-dias]');
  const agenda = $('[data-agenda]');
  const plantillaDia = $<HTMLTemplateElement>('[data-plantilla-dia]');
  const dialogo = $<HTMLDialogElement>('[data-dialogo]');
  const form = $<HTMLFormElement>('[data-form]');
  const estadoForm = $('[data-estado]');
  const caja = $('[data-traslape]');

  const campo = <T extends HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement = HTMLInputElement>(n: string) =>
    form.elements.namedItem(n) as T;

  // ---------- Estado ----------

  const params = new URL(location.href).searchParams;
  let mes = /^\d{4}-\d{2}$/.test(params.get('mes') ?? '') ? params.get('mes')! : hoyLocal().slice(0, 7);
  let citas: Cita[] = [];
  let servicios: ServicioAdmin[] | null = null;
  /** Cita abierta en el formulario (null = nueva). */
  let editando: Cita | null = null;
  /** Solicitud de origen de la cita del formulario (y el nombre de quien la envió). */
  let solicitudOrigen: CitaDatos['solicitud'] = null;
  let solicitudNombre: string | null = null;
  let inicial = '';
  let duracionMin = 60;
  let pedido = 0;

  function actualizarUrl() {
    const u = new URL(location.pathname, location.origin);
    if (mes !== hoyLocal().slice(0, 7)) u.searchParams.set('mes', mes);
    if (dialogo.open && editando) u.searchParams.set('cita', String(editando.id));
    history.replaceState(null, '', u);
  }

  // ---------- Fechas ----------

  /** Días visibles del mes: de lunes a domingo, semanas completas. */
  function diasVisibles(ym: string) {
    const primero = `${ym}-01`;
    const dSemana = (new Date(`${primero}T12:00:00Z`).getUTCDay() + 6) % 7; // lunes = 0
    const inicio = sumarDiasLocal(primero, -dSemana);
    const siguienteMes = new Date(`${primero}T12:00:00Z`);
    siguienteMes.setUTCMonth(siguienteMes.getUTCMonth() + 1);
    const ultimo = sumarDiasLocal(siguienteMes.toISOString().slice(0, 10), -1);
    const lista: string[] = [];
    for (let d = inicio; d <= ultimo || lista.length % 7 !== 0; d = sumarDiasLocal(d, 1)) lista.push(d);
    return lista;
  }

  /** Días locales que ocupa una cita (las de varios días aparecen en cada uno). */
  function diasDeCita(c: Cita) {
    const ini = c.inicio_local.slice(0, 10);
    // Una cita que termina justo a las 00:00 no ocupa ese día.
    const fin = c.fin_local.endsWith('T00:00') ? sumarDiasLocal(c.fin_local.slice(0, 10), -1) : c.fin_local.slice(0, 10);
    const lista: string[] = [];
    for (let d = ini; d <= fin && lista.length < 15; d = sumarDiasLocal(d, 1)) lista.push(d);
    return lista;
  }

  const mesDe = (ym: string, delta: number) => {
    const d = new Date(`${ym}-01T12:00:00Z`);
    d.setUTCMonth(d.getUTCMonth() + delta);
    return d.toISOString().slice(0, 7);
  };

  // ---------- Pintar ----------

  function chip(c: Cita, conHora = true) {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = `cita-chip cita--${c.estado}`;
    if (conHora) {
      const h = document.createElement('strong');
      h.textContent = horaCita(c.inicio);
      b.append(h);
    }
    b.append(c.titulo);
    b.title = `${c.titulo} · ${rangoHoras(c.inicio, c.fin)}${c.cliente ? ` · ${c.cliente}` : ''} · ${etiquetaEstadoCita(c.estado)}`;
    b.setAttribute('aria-label', `${c.titulo}, ${rangoHoras(c.inicio, c.fin)}, ${etiquetaEstadoCita(c.estado)}. Editar`);
    b.addEventListener('click', (e) => {
      e.stopPropagation();
      abrirCita(c, b);
    });
    return b;
  }

  function porDia() {
    const mapa = new Map<string, Cita[]>();
    for (const c of citas) for (const d of diasDeCita(c)) mapa.set(d, [...(mapa.get(d) ?? []), c]);
    return mapa;
  }

  function pintarMes() {
    const hoy = hoyLocal();
    const mapa = porDia();
    $('[data-titulo-mes]').textContent = mayuscula(mesLargo(mes));

    // Cuadrícula
    dias.replaceChildren(
      ...diasVisibles(mes).map((d) => {
        const celda = plantillaDia.content.firstElementChild!.cloneNode(true) as HTMLElement;
        celda.dataset.dia = d;
        celda.classList.toggle('is-fuera', !d.startsWith(mes));
        celda.classList.toggle('is-hoy', d === hoy);
        celda.setAttribute('aria-label', diaLargo(d));
        const num = $<HTMLButtonElement>('[data-dia-nueva]', celda);
        num.textContent = String(Number(d.slice(8)));
        num.setAttribute('aria-label', `Agendar cita el ${diaLargo(d)}`);
        const delDia = mapa.get(d) ?? [];
        $('[data-dia-citas]', celda).replaceChildren(
          ...delDia.map((c) => {
            const li = document.createElement('li');
            li.append(chip(c));
            return li;
          })
        );
        const mas = $<HTMLButtonElement>('[data-dia-mas]', celda);
        mas.hidden = delDia.length <= 3;
        mas.textContent = `+ ${delDia.length - 3} más`;
        return celda;
      })
    );

    // Agenda (móvil): solo los días del mes con citas, más hoy
    const diasMes = diasVisibles(mes).filter((d) => d.startsWith(mes) && (mapa.has(d) || d === hoy));
    const conCitas = diasMes.filter((d) => mapa.has(d));
    agenda.replaceChildren(
      ...(conCitas.length === 0
        ? [Object.assign(document.createElement('p'), { className: 'agenda__vacio', textContent: 'No hay citas este mes. Usa «Nueva cita» para agendar una.' })]
        : diasMes.map((d) => {
            const sec = document.createElement('section');
            sec.className = `agenda__dia${d === hoy ? ' is-hoy' : ''}`;
            const h = document.createElement('h3');
            h.textContent = d === hoy ? `Hoy, ${diaLargo(d)}` : mayuscula(diaLargo(d));
            const agendar = document.createElement('button');
            agendar.type = 'button';
            agendar.className = 'btn btn--secondary btn--sm';
            agendar.textContent = 'Agendar';
            agendar.setAttribute('aria-label', `Agendar cita el ${diaLargo(d)}`);
            agendar.addEventListener('click', () => nuevaCita(d, agendar));
            h.append(agendar);
            const ul = document.createElement('ul');
            const delDia = mapa.get(d) ?? [];
            ul.append(
              ...(delDia.length
                ? delDia.map((c) => {
                    const li = document.createElement('li');
                    const b = chip(c);
                    b.firstElementChild!.textContent = `${rangoHoras(c.inicio, c.fin)} · `;
                    if (c.cliente) b.append(` — ${c.cliente}`);
                    li.append(b);
                    return li;
                  })
                : [Object.assign(document.createElement('li'), { className: 'agenda__vacio', textContent: 'Sin citas.' })])
            );
            sec.append(h, ul);
            return sec;
          }))
    );
  }

  // Clic en el fondo de un día o en su número: cita nueva ese día.
  dias.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const celda = t.closest<HTMLElement>('.dia');
    if (!celda) return;
    if (t.closest('[data-dia-mas]')) {
      celda.classList.add('is-expandido');
      t.closest('[data-dia-mas]')!.setAttribute('hidden', '');
      return;
    }
    nuevaCita(celda.dataset.dia!, celda.querySelector<HTMLElement>('[data-dia-nueva]'));
  });

  function itemProxima(c: Cita) {
    const { li, control } = itemCita(c);
    control.setAttribute('aria-label', `${c.titulo}, ${diaLargo(c.inicio_local.slice(0, 10))}, ${rangoHoras(c.inicio, c.fin)}. Editar`);
    control.addEventListener('click', () => {
      // Lleva el calendario al mes de la cita y la abre.
      const dia = c.inicio_local.slice(0, 10);
      if (!dia.startsWith(mes)) {
        mes = dia.slice(0, 7);
        cargarMes();
      }
      abrirCita(c, control);
    });
    return li;
  }

  // ---------- Cargar ----------

  async function cargarMes() {
    const mio = ++pedido;
    vista(vistaMes, 'cargando');
    actualizarUrl();
    $('[data-titulo-mes]').textContent = mayuscula(mesLargo(mes));
    const visibles = diasVisibles(mes);
    try {
      const r = await admin.citas(visibles[0], visibles[visibles.length - 1]);
      if (mio !== pedido) return;
      citas = r;
      pintarMes();
      vista(vistaMes, 'listo');
    } catch (err) {
      if (mio === pedido && !esSesionExpirada(err)) vista(vistaMes, 'error', mensajeError(err, 'No se pudieron cargar las citas.'));
    }
  }

  async function cargarProximas() {
    vista(vistaProximas, 'cargando');
    try {
      const r = await admin.citasProximas(8);
      if (r.items.length === 0) return vista(vistaProximas, 'vacio');
      $('[data-proximas]').replaceChildren(...r.items.map(itemProxima));
      vista(vistaProximas, 'listo');
    } catch (err) {
      if (!esSesionExpirada(err)) vista(vistaProximas, 'error', mensajeError(err, 'No se pudieron cargar las próximas citas.'));
    }
  }

  async function cargarServicios() {
    if (servicios) return servicios;
    try {
      servicios = await admin.servicios();
    } catch {
      servicios = []; // el formulario funciona igual, sin lista de servicios
    }
    const select = campo<HTMLSelectElement>('servicio_id');
    select.replaceChildren(
      Object.assign(document.createElement('option'), { value: '', textContent: 'Ninguno' }),
      ...servicios.map((s) => Object.assign(document.createElement('option'), { value: String(s.id), textContent: s.publicado ? s.nombre : `${s.nombre} (oculto)` }))
    );
    return servicios;
  }

  // ---------- Formulario ----------

  let origenFoco: HTMLElement | null = null;

  function leer(): CitaDatos {
    const v = (n: string) => campo(n).value.trim();
    return {
      titulo: v('titulo'),
      cliente: v('cliente') || null,
      telefono: v('telefono') || null,
      correo: v('correo') || null,
      servicio_id: v('servicio_id') ? Number(v('servicio_id')) : null,
      solicitud: solicitudOrigen,
      inicio_local: v('inicio_local'),
      fin_local: v('fin_local'),
      lugar: v('lugar') || null,
      notas: v('notas') || null,
      estado: editando ? (campo<HTMLSelectElement>('estado').value as CitaDatos['estado']) : 'programada',
    };
  }
  const hayCambios = () => dialogo.open && JSON.stringify(leer()) !== inicial;

  function marcar(nombre: string, mensaje: string | null) {
    const p = form.querySelector<HTMLElement>(`[data-error="${nombre}"]`);
    if (p) p.textContent = mensaje ?? '';
    const el = form.elements.namedItem(nombre) as HTMLElement | null;
    if (el && 'setAttribute' in el) mensaje ? el.setAttribute('aria-invalid', 'true') : el.removeAttribute('aria-invalid');
  }
  const limpiarErrores = () => form.querySelectorAll<HTMLElement>('[data-error]').forEach((p) => marcar(p.dataset.error!, null));

  function validar(d: CitaDatos) {
    const e: Record<string, string> = {};
    if (!d.titulo) e.titulo = 'Escribe un título para la cita.';
    if (!d.inicio_local) e.inicio_local = 'Indica la fecha y hora de inicio.';
    if (!d.fin_local) e.fin_local = 'Indica la fecha y hora de fin.';
    else if (d.inicio_local && d.fin_local <= d.inicio_local) e.fin_local = 'La hora de fin debe ser posterior a la de inicio.';
    if (d.correo && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(d.correo)) e.correo = 'El correo no tiene un formato válido.';
    return e;
  }

  const minutos = (local: string) => new Date(`${local}:00Z`).getTime() / 60000;
  const sumarMin = (local: string, m: number) => new Date(new Date(`${local}:00Z`).getTime() + m * 60000).toISOString().slice(0, 16);

  /** Abre el formulario con los valores dados (cita existente o nueva). */
  async function abrir(valores: Partial<CitaDatos> & { inicio_local: string; fin_local: string }, cita: Cita | null, desde: HTMLElement | null) {
    await cargarServicios();
    editando = cita;
    origenFoco = desde;
    solicitudOrigen = valores.solicitud ?? null;
    form.reset();
    limpiarErrores();
    caja.hidden = true;
    estadoForm.textContent = '';
    estadoForm.classList.remove('is-error');

    for (const n of ['titulo', 'cliente', 'telefono', 'correo', 'lugar', 'notas', 'inicio_local', 'fin_local'] as const) {
      campo(n).value = (valores[n] as string | null | undefined) ?? '';
    }
    campo<HTMLSelectElement>('servicio_id').value = valores.servicio_id ? String(valores.servicio_id) : '';
    campo<HTMLSelectElement>('estado').value = valores.estado ?? 'programada';
    duracionMin = Math.max(15, minutos(valores.fin_local) - minutos(valores.inicio_local));

    $('[data-dialogo-titulo]').textContent = cita ? 'Editar cita' : 'Nueva cita';
    $('[data-campo-estado]').hidden = !cita;
    $('[data-cancelar-cita]').hidden = !cita || cita.estado === 'cancelada';
    const origen = $('[data-origen]');
    origen.hidden = !solicitudOrigen;
    if (solicitudOrigen) {
      const nombre = cita?.solicitud?.nombre ?? solicitudNombre ?? '';
      const a = document.createElement('a');
      a.href = `/admin/mensajes?ver=${claveSolicitud(solicitudOrigen.origen, solicitudOrigen.id)}`;
      a.textContent = 'Ver solicitud';
      origen.replaceChildren(`Agendada desde la solicitud de ${nombre || 'un cliente'} (${solicitudOrigen.origen === 'chatbot' ? 'chatbot' : 'formulario'}). `, a);
    }

    inicial = JSON.stringify(leer());
    if (!dialogo.open) dialogo.showModal();
    actualizarUrl();
    campo('titulo').focus();
  }

  function abrirCita(c: Cita, desde: HTMLElement | null) {
    abrir(
      {
        titulo: c.titulo,
        cliente: c.cliente,
        telefono: c.telefono,
        correo: c.correo,
        servicio_id: c.servicio?.id ?? null,
        solicitud: c.solicitud ? { origen: c.solicitud.origen, id: c.solicitud.id } : null,
        inicio_local: c.inicio_local,
        fin_local: c.fin_local,
        lugar: c.lugar,
        notas: c.notas,
        estado: c.estado,
      },
      c,
      desde
    );
  }

  /** Cita nueva el día indicado, de 9:00 a 10:00. */
  function nuevaCita(dia: string, desde: HTMLElement | null, extra: Partial<CitaDatos> = {}) {
    abrir({ inicio_local: `${dia}T09:00`, fin_local: `${dia}T10:00`, ...extra }, null, desde);
  }

  /** Cita nueva con los datos de una solicitud (botón «Agendar cita» de Mensajes). */
  async function nuevaDesdeSolicitud(clave: string) {
    const ref = leerClave(clave);
    if (!ref) return;
    try {
      const [s, lista] = await Promise.all([admin.solicitud(ref.origen, ref.id), cargarServicios()]);
      // Siguiente día hábil (lunes a sábado).
      let dia = sumarDiasLocal(hoyLocal(), 1);
      if (new Date(`${dia}T12:00:00Z`).getUTCDay() === 0) dia = sumarDiasLocal(dia, 1);
      solicitudNombre = s.nombre;
      const tipo = s.chatbot?.tipo_servicio?.toLowerCase();
      const servicio = tipo ? lista.find((x) => x.nombre.toLowerCase() === tipo) : undefined;
      nuevaCita(dia, null, {
        titulo: `Visita técnica: ${s.nombre}`.slice(0, 150),
        cliente: (s.empresa ? `${s.empresa} (${s.nombre})` : s.nombre).slice(0, 150),
        telefono: s.telefono,
        correo: s.correo,
        servicio_id: servicio?.id ?? null,
        lugar: s.chatbot?.ubicacion ?? null,
        notas: `Solicitud del ${fechaCorta(s.fecha_creacion)}:\n${s.mensaje}`.slice(0, 5000),
        solicitud: { origen: s.origen, id: s.id },
      });
    } catch (err) {
      if (esSesionExpirada(err)) return;
      vista(vistaMes, 'error', mensajeError(err, 'No se pudo cargar la solicitud para agendar la cita.'));
    }
  }

  // Al mover el inicio, el fin se corre para mantener la duración.
  campo('inicio_local').addEventListener('change', () => {
    const ini = campo('inicio_local').value;
    if (ini) campo('fin_local').value = sumarMin(ini, duracionMin);
  });
  campo('fin_local').addEventListener('change', () => {
    const ini = campo('inicio_local').value;
    const fin = campo('fin_local').value;
    if (ini && fin && fin > ini) duracionMin = minutos(fin) - minutos(ini);
  });
  form.addEventListener('input', (e) => {
    const t = e.target as HTMLElement;
    if (t.getAttribute('aria-invalid')) marcar((t as HTMLInputElement).name, null);
    caja.hidden = true; // un cambio invalida la advertencia de traslape
  });

  async function guardar(confirmar = false) {
    const datos = leer();
    limpiarErrores();
    const errores = validar(datos);
    if (Object.keys(errores).length) {
      for (const [k, m] of Object.entries(errores)) marcar(k, m);
      (form.elements.namedItem(Object.keys(errores)[0]) as HTMLElement).focus();
      estadoForm.textContent = 'Revisa los campos marcados.';
      estadoForm.classList.add('is-error');
      return;
    }
    const boton = $<HTMLButtonElement>('[data-guardar]');
    boton.disabled = true;
    estadoForm.classList.remove('is-error');
    estadoForm.textContent = 'Guardando…';
    try {
      const cuerpo = { ...datos, confirmar_traslape: confirmar };
      const guardada = editando ? await admin.editarCita(editando.id, cuerpo) : await admin.crearCita(cuerpo);
      inicial = JSON.stringify(leer());
      dialogo.close();
      mes = guardada.inicio_local.slice(0, 7);
      await Promise.all([cargarMes(), cargarProximas()]);
    } catch (err) {
      if (esSesionExpirada(err)) return;
      if (err instanceof AdminError && err.status === 409 && err.traslapes.length) {
        $('[data-traslape-texto]').textContent = err.message;
        $('[data-traslape-lista]').replaceChildren(
          ...err.traslapes.map((c) => {
            const li = document.createElement('li');
            li.textContent = `${c.titulo} — ${diaCorto(c.inicio_local.slice(0, 10))}, ${rangoHoras(c.inicio, c.fin)}${c.cliente ? ` (${c.cliente})` : ''}`;
            return li;
          })
        );
        caja.hidden = false;
        estadoForm.textContent = '';
        $('[data-forzar]').focus();
      } else if (err instanceof AdminError && Object.keys(err.campos).length) {
        for (const [k, m] of Object.entries(err.campos)) marcar(k, m);
        estadoForm.textContent = err.message;
        estadoForm.classList.add('is-error');
      } else {
        estadoForm.textContent = mensajeError(err, 'No se pudo guardar la cita.');
        estadoForm.classList.add('is-error');
      }
    } finally {
      boton.disabled = false;
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    guardar(false);
  });
  $('[data-forzar]').addEventListener('click', () => guardar(true));

  $('[data-cancelar-cita]').addEventListener('click', async () => {
    if (!editando) return;
    if (!confirm(`¿Cancelar la cita «${editando.titulo}»? Quedará en el calendario marcada como cancelada.`)) return;
    try {
      await admin.cancelarCita(editando.id);
      inicial = JSON.stringify(leer());
      dialogo.close();
      await Promise.all([cargarMes(), cargarProximas()]);
    } catch (err) {
      if (esSesionExpirada(err)) return;
      estadoForm.textContent = mensajeError(err, 'No se pudo cancelar la cita.');
      estadoForm.classList.add('is-error');
    }
  });

  function cerrar() {
    if (hayCambios() && !confirm('Hay cambios sin guardar en esta cita. ¿Cerrar de todos modos?')) return;
    inicial = '';
    dialogo.close();
  }
  form.querySelectorAll('[data-cerrar]').forEach((b) => b.addEventListener('click', cerrar));
  $('.detalle__head [data-cerrar]').addEventListener('click', cerrar);
  dialogo.addEventListener('cancel', (e) => {
    e.preventDefault();
    cerrar();
  });
  dialogo.addEventListener('click', (e) => {
    if (e.target === dialogo) cerrar();
  });
  dialogo.addEventListener('close', () => {
    editando = null;
    solicitudNombre = null;
    actualizarUrl();
    origenFoco?.focus();
  });
  window.addEventListener('beforeunload', (e) => {
    if (hayCambios()) e.preventDefault();
  });

  // ---------- Navegación ----------

  document.querySelectorAll<HTMLButtonElement>('[data-mes]').forEach((b) =>
    b.addEventListener('click', () => {
      mes = mesDe(mes, Number(b.dataset.mes));
      cargarMes();
    })
  );
  $('[data-hoy]').addEventListener('click', () => {
    mes = hoyLocal().slice(0, 7);
    cargarMes();
  });
  $('[data-nueva]').addEventListener('click', (e) => {
    const hoy = hoyLocal();
    nuevaCita(mes === hoy.slice(0, 7) ? hoy : `${mes}-01`, e.currentTarget as HTMLElement);
  });
  document.addEventListener('click', (e) => {
    const id = (e.target as HTMLElement).closest<HTMLElement>('[data-reintentar]')?.dataset.reintentar;
    if (id === 'mes') cargarMes();
    if (id === 'proximas') cargarProximas();
  });

  panelListo().then(async () => {
    cargarProximas();
    await cargarMes();
    const citaId = Number(params.get('cita'));
    const nueva = params.get('nueva');
    const solicitud = params.get('solicitud');
    if (citaId > 0) {
      try {
        abrirCita(await admin.cita(citaId), null);
      } catch (err) {
        if (!esSesionExpirada(err)) vista(vistaMes, 'error', mensajeError(err, 'No se encontró la cita.'));
      }
    } else if (solicitud) {
      nuevaDesdeSolicitud(solicitud);
    } else if (nueva && /^\d{4}-\d{2}-\d{2}$/.test(nueva)) {
      nuevaCita(nueva, null);
    }
  });
</script>
