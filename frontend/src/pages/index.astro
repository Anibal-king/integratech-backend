---
import Layout from '../layouts/Layout.astro';
import { api } from '../lib/api';

const [empresa, servicios, proyectos] = await Promise.all([
  api.empresa(),
  api.servicios(),
  api.proyectos(),
]);

const serviciosDestacados = servicios.slice(0, 3);
const proyectosDestacados = proyectos.slice(0, 3);
---

<Layout>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <span class="eyebrow">Servicios Integrales de Ingeniería</span>
        <h1>Ingeniería especializada para la industria y el sector corporativo</h1>
        <p>
          {empresa?.mision ??
            'Satisfacemos la demanda de servicios profesionales y especializados que requiere el mercado corporativo y empresarial de El Salvador.'}
        </p>
        <div class="hero__actions">
          <a href="/servicios" class="btn btn--primary">Ver servicios</a>
          <a href="/contacto" class="btn btn--ghost btn--light">Solicitar cotización</a>
        </div>
      </div>
      <div class="hero__panel" aria-hidden="true">
        <div class="hero__badge">Desde 2003</div>
        <ul class="hero__stats">
          <li><strong>20+</strong><span>años de experiencia</span></li>
          <li><strong>{servicios.length || '8'}</strong><span>líneas de servicio</span></li>
          <li><strong>{proyectos.length || '30+'}</strong><span>proyectos destacados</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Servicios -->
  <section class="section section--surface">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">Qué hacemos</span>
        <h2>Descripción de servicios</h2>
        <p>Soluciones de ingeniería en automatización, energía, infraestructura y calidad, ejecutadas por un staff especializado.</p>
      </div>

      {serviciosDestacados.length === 0 ? (
        <div class="notice">
          No se pudo cargar el catálogo de servicios. Verifica que el backend esté corriendo en
          <code>{api.baseUrl}</code>.
        </div>
      ) : (
        <div class="grid grid--3">
          {serviciosDestacados.map((s) => (
            <a href={`/servicios/${s.id}`} class="card card--link">
              <h3>{s.nombre}</h3>
              <p>{s.descripcion}</p>
            </a>
          ))}
        </div>
      )}

      <p style="margin-top:1.75rem;">
        <a href="/servicios" class="btn btn--ghost">Ver todos los servicios →</a>
      </p>
    </div>
  </section>

  <!-- Proyectos -->
  {proyectosDestacados.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section__head">
          <span class="eyebrow">Trayectoria</span>
          <h2>Proyectos destacados</h2>
        </div>
        <div class="grid grid--3">
          {proyectosDestacados.map((p) => (
            <article class="card">
              {p.ejecucion && <span class="tag">{p.ejecucion}</span>}
              <h3 style="margin-top:0.6rem;">{p.nombre_proyecto}</h3>
              {p.descripcion && <p>{p.descripcion}</p>}
            </article>
          ))}
        </div>
        <p style="margin-top:1.75rem;">
          <a href="/proyectos" class="btn btn--ghost">Ver todos los proyectos →</a>
        </p>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="cta">
    <div class="container cta__inner">
      <div>
        <h2 style="color:#fff;">¿Tienes un proyecto en mente?</h2>
        <p style="color:#cfe0f0;margin:0;">Cuéntanos qué necesitas y te preparamos una propuesta.</p>
      </div>
      <a href="/contacto" class="btn btn--primary">Contáctanos</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-400));
    color: #fff;
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .hero__text h1 { color: #fff; }
  .hero__text p { color: #d6e4f2; font-size: 1.1rem; max-width: 46ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 1.75rem; }

  .hero__panel {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-lg);
    padding: 2rem;
  }
  .hero__badge {
    display: inline-block;
    background: var(--color-accent);
    color: #fff;
    font-weight: 700;
    font-size: 0.8rem;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    margin-bottom: 1.5rem;
  }
  .hero__stats { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; }
  .hero__stats li { display: flex; flex-direction: column; }
  .hero__stats strong { font-size: 1.8rem; color: #fff; }
  .hero__stats span { color: #b9cbe0; font-size: 0.9rem; }

  .cta { background: var(--color-primary-600); padding-block: 3rem; }
  .cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  code {
    background: rgba(0,0,0,0.06);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    font-size: 0.9em;
  }

  @media (max-width: 820px) {
    .hero__inner { grid-template-columns: 1fr; }
  }
</style>
