---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Galeria from '../components/Galeria.astro';
import { api } from '../lib/api';
import { heroHome, galeriaHome, portadaDeCategoria } from '../lib/imagenes';

const [empresa, servicios, proyectos] = await Promise.all([
  api.empresa(),
  api.servicios(),
  api.proyectos(),
]);

const serviciosDestacados = servicios.slice(0, 3);
const proyectosDestacados = proyectos.slice(0, 3);
---

<Layout>
  <!-- Hero -->
  <section class="hero">
    <Image class="hero__bg" src={heroHome} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" />
    <div class="hero__scrim"></div>
    <div class="container hero__inner">
      <div class="hero__text">
        <span class="eyebrow" style="color:#7fe3e3;">Servicios Integrales de Ingeniería</span>
        <h1>Ingeniería especializada para la industria y el sector corporativo</h1>
        <p>
          {empresa?.mision ??
            'Satisfacemos la demanda de servicios profesionales y especializados que requiere el mercado corporativo y empresarial de El Salvador.'}
        </p>
        <div class="hero__actions">
          <a href="/servicios" class="btn btn--primary">Ver servicios</a>
          <a href="/contacto" class="btn btn--light">Solicitar cotización</a>
        </div>
        <ul class="hero__stats">
          <li><strong>20+</strong><span>años de experiencia</span></li>
          <li><strong>{servicios.length || '8'}</strong><span>líneas de servicio</span></li>
          <li><strong>{proyectos.length || '30+'}</strong><span>proyectos destacados</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Servicios -->
  <section class="section section--surface">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">Qué hacemos</span>
        <h2>Descripción de servicios</h2>
        <p>Soluciones de ingeniería en automatización, energía, infraestructura y calidad, ejecutadas por un staff especializado.</p>
      </div>

      {serviciosDestacados.length === 0 ? (
        <div class="notice">
          No se pudo cargar el catálogo de servicios. Verifica que el backend esté corriendo en
          <code>{api.baseUrl}</code>.
        </div>
      ) : (
        <div class="svc-grid">
          {serviciosDestacados.map((s) => {
            const portada = portadaDeCategoria(s.nombre);
            return (
              <a href={`/servicios/${s.id}`} class="svc-card">
                {portada && (
                  <div class="svc-card__media">
                    <Image src={portada} alt={s.nombre} widths={[320, 640]} sizes="(max-width:700px) 90vw, 33vw" loading="lazy" />
                  </div>
                )}
                <div class="svc-card__body">
                  <h3>{s.nombre}</h3>
                  <p>{s.descripcion}</p>
                  <span class="svc-card__cta">Ver detalle →</span>
                </div>
              </a>
            );
          })}
        </div>
      )}

      <p style="margin-top:1.75rem;">
        <a href="/servicios" class="btn btn--ghost">Ver todos los servicios →</a>
      </p>
    </div>
  </section>

  <!-- Galería de proyectos -->
  {galeriaHome.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section__head">
          <span class="eyebrow">Nuestro trabajo</span>
          <h2>Proyectos en imágenes</h2>
          <p>Data centers, subestaciones, automatización, iluminación y energía renovable en instalaciones reales.</p>
        </div>
        <Galeria fotos={galeriaHome} min={280} />
        <p style="margin-top:1.75rem;">
          <a href="/proyectos" class="btn btn--ghost">Ver galería completa →</a>
        </p>
      </div>
    </section>
  )}

  <!-- Proyectos destacados (texto) -->
  {proyectosDestacados.length > 0 && (
    <section class="section section--surface">
      <div class="container">
        <div class="section__head">
          <span class="eyebrow">Trayectoria</span>
          <h2>Proyectos destacados</h2>
        </div>
        <div class="grid grid--3">
          {proyectosDestacados.map((p) => (
            <article class="card">
              {p.ejecucion && <span class="tag">{p.ejecucion}</span>}
              <h3 style="margin-top:0.6rem;">{p.nombre_proyecto}</h3>
              {p.descripcion && <p>{p.descripcion}</p>}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="cta">
    <div class="container cta__inner">
      <div>
        <h2 style="color:#fff;">¿Tienes un proyecto en mente?</h2>
        <p style="color:#cfe0f0;margin:0;">Cuéntanos qué necesitas y te preparamos una propuesta.</p>
      </div>
      <a href="/contacto" class="btn btn--primary">Contáctanos</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    color: #fff;
    overflow: hidden;
    background: var(--color-primary);
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, rgba(8, 26, 46, 0.94) 0%, rgba(8, 26, 46, 0.78) 45%, rgba(8, 26, 46, 0.45) 100%);
  }
  .hero__inner {
    position: relative;
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .hero__text { max-width: 640px; }
  .hero__text h1 { color: #fff; }
  .hero__text p { color: #d6e4f2; font-size: 1.1rem; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 1.75rem; }
  .hero__stats {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
  }
  .hero__stats li { display: flex; flex-direction: column; }
  .hero__stats strong { font-size: 1.9rem; color: #fff; }
  .hero__stats span { color: #a9c1da; font-size: 0.85rem; }

  /* Tarjetas de servicio (compartido con /servicios) */
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }
  .svc-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #fff;
    box-shadow: var(--shadow-sm);
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .svc-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); text-decoration: none; }
  .svc-card__media { aspect-ratio: 16 / 9; overflow: hidden; background: var(--color-surface-2); }
  .svc-card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .svc-card:hover .svc-card__media img { transform: scale(1.06); }
  .svc-card__body { padding: 1.3rem 1.4rem 1.5rem; display: flex; flex-direction: column; flex: 1; }
  .svc-card__body h3 { margin-bottom: 0.4rem; }
  .svc-card__body p { color: var(--color-text-muted); }
  .svc-card__cta { margin-top: auto; padding-top: 0.75rem; font-weight: 700; color: var(--color-accent-600); }

  .cta { background: var(--color-primary-600); padding-block: 3rem; }
  .cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  code { background: rgba(0,0,0,0.06); padding: 0.1rem 0.35rem; border-radius: 4px; }
</style>
