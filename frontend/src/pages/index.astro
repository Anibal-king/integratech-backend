---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { api } from '../lib/api';
import {
  heroHome,
  bandaProyectos,
  todasLasFotos,
  portadaDeCategoria,
  marcaLogo,
} from '../lib/imagenes';

const [empresa, servicios, proyectos, marcas] = await Promise.all([
  api.empresa(),
  api.servicios(),
  api.proyectos(),
  api.marcas(),
]);

// Primeras 4 líneas de servicio para el "recorrido" foto/texto
const soluciones = servicios.slice(0, 4);
const proyectosDestacados = proyectos.slice(0, 3);
const logos = marcas
  .map((m) => ({ nombre: m.nombre, img: marcaLogo(m.nombre) }))
  .filter((m): m is { nombre: string; img: NonNullable<typeof m.img> } => m.img !== null);
---

<Layout>
  <!-- ░░ Hero ░░ -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__text">
        <span class="eyebrow" style="color:#7fe3e3;">Servicios Integrales de Ingeniería</span>
        <h1>Ingeniería especializada para la industria y el sector corporativo</h1>
        <p>
          {empresa?.mision ??
            'Satisfacemos la demanda de servicios profesionales y especializados que requiere el mercado corporativo y empresarial de El Salvador.'}
        </p>
        <div class="hero__actions">
          <a href="/servicios" class="btn btn--primary">Ver servicios</a>
          <a href="/contacto" class="btn btn--light">Solicitar cotización</a>
        </div>
        <ul class="hero__stats">
          <li><strong>20+</strong><span>años de experiencia</span></li>
          <li><strong>{servicios.length || 8}</strong><span>líneas de servicio</span></li>
          <li><strong>{proyectos.length || '30'}+</strong><span>proyectos ejecutados</span></li>
        </ul>
      </div>

      <figure class="hero__photo">
        <Image src={heroHome.img} alt={heroHome.descripcion} widths={[480, 760, 1100]} sizes="(max-width: 900px) 92vw, 46vw" loading="eager" />
        <figcaption>{heroHome.descripcion}</figcaption>
      </figure>
    </div>
    <a href="#soluciones" class="hero__scroll" aria-label="Ver soluciones">▾</a>
  </section>

  <!-- ░░ Recorrido de soluciones (foto + texto alternado) ░░ -->
  <section class="section" id="soluciones">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">Qué hacemos</span>
        <h2>Nuestras soluciones</h2>
        <p>Cuatro líneas de trabajo que cubren automatización, energía, infraestructura y calidad — ejecutadas con personal propio y marcas representadas.</p>
      </div>

      {soluciones.length === 0 ? (
        <div class="notice">
          No se pudo cargar el catálogo de servicios. Verifica que el backend esté corriendo en <code>{api.baseUrl}</code>.
        </div>
      ) : (
        <div class="soluciones">
          {soluciones.map((s, i) => {
            const portada = portadaDeCategoria(s.nombre);
            return (
              <article class="sol">
                <a class="sol__media" href={`/servicios/${s.id}`} aria-label={s.nombre}>
                  {portada && (
                    <Image src={portada} alt={s.nombre} widths={[420, 720]} sizes="(max-width: 860px) 92vw, 48vw" loading="lazy" />
                  )}
                </a>
                <div class="sol__body">
                  <span class="eyebrow">Servicio {String(i + 1).padStart(2, '0')}</span>
                  <h3>{s.nombre}</h3>
                  <p>{s.descripcion}</p>
                  {s.items.length > 0 && (
                    <ul class="sol__items">
                      {s.items.slice(0, 4).map((it) => <li>{it}</li>)}
                    </ul>
                  )}
                  <a href={`/servicios/${s.id}`} class="sol__link">Ver detalle del servicio →</a>
                </div>
              </article>
            );
          })}
        </div>
      )}

      <p class="center" style="margin-top:2.5rem;">
        <a href="/servicios" class="btn btn--ghost">Ver todas las líneas de servicio →</a>
      </p>
    </div>
  </section>

  <!-- ░░ Franja de proyectos ░░ -->
  {bandaProyectos.length > 0 && (
    <section class="band">
      <div class="container">
        <div class="band__head">
          <div>
            <span class="eyebrow" style="color:#7fe3e3;">Nuestro trabajo</span>
            <h2>Proyectos en instalaciones reales</h2>
            <p>Data centers, subestaciones, tableros de automatización, iluminación y energía renovable.</p>
          </div>
          <a href="/proyectos" class="btn btn--light">Ver las {todasLasFotos.length} fotos →</a>
        </div>
        <div class="band__grid">
          {bandaProyectos.map((f, i) => (
            <a href="/proyectos" class="band__item" style={`--i:${i}`} aria-label={f.descripcion}>
              <Image src={f.img} alt={f.descripcion} widths={[320, 560]} sizes="(max-width: 700px) 45vw, 22vw" loading="lazy" />
              <span>{f.descripcion}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ░░ Marcas ░░ -->
  {logos.length > 0 && (
    <section class="section marcas-strip">
      <div class="container">
        <p class="marcas-strip__title">Representamos marcas líderes en energía, automatización y protección eléctrica</p>
        <div class="marcas-strip__logos">
          {logos.map((m) => (
            <span class="marcas-strip__logo" title={m.nombre}>
              <Image src={m.img} alt={m.nombre} widths={[120, 240]} sizes="140px" loading="lazy" />
            </span>
          ))}
        </div>
        <p class="center"><a href="/nosotros" class="sol__link">Conocer más sobre la empresa →</a></p>
      </div>
    </section>
  )}

  <!-- ░░ Proyectos destacados (texto desde la API) ░░ -->
  {proyectosDestacados.length > 0 && (
    <section class="section section--surface">
      <div class="container">
        <div class="section__head">
          <span class="eyebrow">Trayectoria</span>
          <h2>Proyectos destacados</h2>
        </div>
        <div class="grid grid--3">
          {proyectosDestacados.map((p) => (
            <article class="card">
              {p.ejecucion && <span class="tag">{p.ejecucion}</span>}
              <h3 style="margin-top:0.6rem;">{p.nombre_proyecto}</h3>
              {p.descripcion && <p>{p.descripcion}</p>}
            </article>
          ))}
        </div>
        <p style="margin-top:1.75rem;">
          <a href="/proyectos" class="btn btn--ghost">Ver todos los proyectos →</a>
        </p>
      </div>
    </section>
  )}

  <!-- ░░ CTA ░░ -->
  <section class="cta">
    <div class="container cta__inner">
      <div>
        <h2 style="color:#fff;">¿Tienes un proyecto en mente?</h2>
        <p style="color:#cfe0f0;margin:0;">Cuéntanos qué necesitas y te preparamos una propuesta.</p>
      </div>
      <a href="/contacto" class="btn btn--primary">Contáctanos</a>
    </div>
  </section>
</Layout>

<style>
  .center { text-align: center; }
  code { background: rgba(0, 0, 0, 0.06); padding: 0.1rem 0.35rem; border-radius: 4px; }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    background: linear-gradient(135deg, #0a1c2e 0%, var(--color-primary) 45%, var(--color-primary-400) 100%);
    color: #fff;
    padding-block: clamp(3rem, 8vw, 5.5rem);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .hero__text h1 { color: #fff; }
  .hero__text p { color: #d6e4f2; font-size: 1.1rem; max-width: 46ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 1.75rem; }
  .hero__stats {
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    display: flex;
    flex-wrap: wrap;
    gap: 2.25rem;
  }
  .hero__stats li { display: flex; flex-direction: column; }
  .hero__stats strong { font-size: 1.7rem; color: #fff; }
  .hero__stats span { color: #a9c1da; font-size: 0.82rem; }

  .hero__photo {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #0a1c2e;
  }
  .hero__photo img { width: 100%; height: 100%; object-fit: cover; display: block; aspect-ratio: 4 / 3; }
  .hero__photo figcaption {
    padding: 0.7rem 1rem;
    font-size: 0.8rem;
    color: #bcd3ea;
    background: rgba(0, 0, 0, 0.25);
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 0.75rem;
    transform: translateX(-50%);
    color: rgba(255, 255, 255, 0.7);
    font-size: 1.3rem;
    text-decoration: none;
    animation: bob 1.8s ease-in-out infinite;
  }
  @keyframes bob { 0%, 100% { transform: translateX(-50%) translateY(0); } 50% { transform: translateX(-50%) translateY(5px); } }

  /* ---------- Recorrido de soluciones ---------- */
  .soluciones { display: flex; flex-direction: column; gap: clamp(2.5rem, 6vw, 4.5rem); }
  .sol {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }
  .sol:nth-child(even) .sol__media { order: 2; }

  .sol__media {
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--color-surface-2);
    box-shadow: var(--shadow-md);
  }
  .sol__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .sol__media:hover img { transform: scale(1.05); }

  .sol__body h3 { font-size: 1.4rem; margin: 0.3rem 0 0.5rem; }
  .sol__body p { color: var(--color-text-muted); }
  .sol__items { margin: 0.75rem 0 1rem; padding-left: 1.1rem; }
  .sol__items li { margin-bottom: 0.3rem; color: var(--color-text); }
  .sol__link { font-weight: 700; color: var(--color-accent-600); }

  /* ---------- Franja de proyectos ---------- */
  .band {
    background: linear-gradient(180deg, var(--color-primary) 0%, #0a2038 100%);
    color: #fff;
    padding-block: clamp(3rem, 7vw, 4.5rem);
  }
  .band__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .band__head h2 { color: #fff; margin-bottom: 0.35rem; }
  .band__head p { color: #bcd3ea; margin: 0; }

  .band__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.9rem;
  }
  .band__item {
    position: relative;
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: #0a1c2e;
  }
  .band__item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; opacity: 0.9; }
  .band__item:hover img { transform: scale(1.06); opacity: 1; }
  .band__item span {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 1.4rem 0.7rem 0.6rem;
    font-size: 0.72rem;
    line-height: 1.3;
    color: #fff;
    background: linear-gradient(to top, rgba(6, 20, 35, 0.95), transparent);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .band__item:hover span { opacity: 1; }

  /* ---------- Marcas ---------- */
  .marcas-strip { padding-block: clamp(2.5rem, 5vw, 3.5rem); }
  .marcas-strip__title {
    text-align: center;
    color: var(--color-text-muted);
    font-weight: 600;
    max-width: 52ch;
    margin: 0 auto 1.75rem;
  }
  .marcas-strip__logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.5rem 2.5rem;
    margin-bottom: 1.5rem;
  }
  .marcas-strip__logo {
    display: grid;
    place-items: center;
    width: 120px;
    height: 52px;
  }
  .marcas-strip__logo img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.6;
    transition: filter 0.2s ease, opacity 0.2s ease;
  }
  .marcas-strip__logo:hover img { filter: grayscale(0); opacity: 1; }

  /* ---------- CTA ---------- */
  .cta { background: var(--color-primary-600); padding-block: 3rem; }
  .cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 900px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__photo { order: -1; max-width: 520px; }
    .band__grid { grid-template-columns: repeat(3, 1fr); }
    .band__item:nth-child(4), .band__item:nth-child(5) { display: none; }
  }
  @media (max-width: 720px) {
    .sol { grid-template-columns: 1fr; }
    .sol:nth-child(even) .sol__media { order: 0; }
    .band__grid { grid-template-columns: repeat(2, 1fr); }
    .band__item:nth-child(3) { display: none; }
    .band__head .btn { width: 100%; justify-content: center; }
  }
</style>
