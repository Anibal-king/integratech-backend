---
import '../styles/tokens.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Section from '../components/Section.astro';
import Header from '../components/Header.astro';
import Lightbox from '../components/Lightbox.astro';
import ChatWidget from '../components/ChatWidget.tsx';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'IntegraTech — Servicios Integrales de Ingeniería',
  description = 'Servicios profesionales y especializados de ingeniería para el sector corporativo e industrial de El Salvador: automatización, energía, mantenimiento de infraestructura y más.',
} = Astro.props;

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <!-- Oculta las secciones .reveal solo si hay JS (sin JS todo queda visible) -->
    <script is:inline>
      document.documentElement.classList.add('js');
      document.addEventListener('astro:after-swap', () => document.documentElement.classList.add('js'));
    </script>
    <ClientRouter />
  </head>
  <body>
    <Header />

    <div class="shell">
      <main class="main">
        <slot />
      </main>

      <Section as="footer" variant="dark" class="footer">
        <div class="container footer__inner">
          <p><strong>Servicios Integrales de Ingeniería El Salvador, S.A. de C.V.</strong></p>
          <p>
            Av. Las Palmeras y Calle Las Azucenas, Políg. «F», Urb. La Sultana #21, Antiguo Cuscatlán.
            &nbsp;·&nbsp; Tel. 2556-1756 &nbsp;·&nbsp; Cel. 7986-2065
          </p>
          <p class="footer__legal">© {year} IntegraTech / SIIE. Todos los derechos reservados.</p>
        </div>
      </Section>
    </div>

    <Lightbox />
    <ChatWidget client:idle transition:persist="chat" />

    <style>
      .shell {
        min-height: calc(100vh - var(--header-height));
        display: flex;
        flex-direction: column;
      }
      .main { flex: 1; }

      .footer {
        color: var(--text-muted);
        padding-block: 2.25rem;
        font-size: 0.9rem;
      }
      .footer__inner p { margin: 0 0 0.35rem; }
      .footer strong { color: var(--heading); }
      .footer__legal { margin-top: 0.75rem; color: var(--text-muted); font-size: 0.82rem; }
    </style>
  </body>
</html>
