---
/**
 * Layout base del panel de administración: sin header público, footer, chatbot
 * ni View Transitions. noindex y sin enlaces desde el sitio público.
 *
 * El HTML de estas páginas es estático y por tanto público: nunca lleva datos.
 * Todo lo sensible lo pide el navegador a la API, que valida la sesión.
 * Las páginas internas usan además <AdminShell> (barra lateral + barra superior).
 */
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Panel SIIE</title>
  </head>
  <body class="admin surface-muted">
    <slot />

    <style is:global>
      /* Colores de estado del panel. Acentos de marca (tokens.css) para nuevo y
         contactado; los demás son propios del panel y cumplen AA en las etiquetas. */
      :root {
        --estado-nuevo: var(--color-accent);
        --estado-contactado: var(--color-brand-blue);
        --estado-cotizado: #c98500;
        --estado-cerrado: #2f855a;
        --estado-descartado: var(--color-brand-gray);

        --cita-programada: var(--color-accent);
        --cita-completada: var(--estado-cerrado);
        --cita-cancelada: var(--color-brand-gray);

        --serie-formulario: var(--color-brand-blue);
        --serie-chatbot: var(--color-accent);

        --admin-sidebar: 248px;
        --admin-topbar: 64px;
      }

      /* hidden siempre gana, aunque la clase defina display */
      .admin [hidden] { display: none !important; }

      .admin { min-height: 100vh; }

      /* ---------- Tarjetas ---------- */
      .admin-card {
        background: var(--surface-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
      }
      .admin-card__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.1rem 1.25rem 0;
      }
      .admin-card__head h2 { font-size: 1.05rem; margin: 0; }
      .admin-card__body { padding: 1.1rem 1.25rem 1.25rem; }

      .admin-alert {
        margin: 0;
        padding: 0.75rem 1rem;
        border-radius: var(--radius);
        border: 1px solid var(--danger-text);
        color: var(--danger-text);
        background: var(--surface-card);
        font-size: 0.92rem;
      }

      .admin-cargando {
        display: grid;
        place-items: center;
        min-height: 60vh;
        color: var(--text-muted);
      }

      /* ---------- Estados de vista (cargando / vacío / error) ---------- */
      .estado-vista {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        min-height: 160px;
        padding: 1.5rem 1rem;
        text-align: center;
        color: var(--text-muted);
        font-size: 0.92rem;
      }
      .estado-vista p { margin: 0; max-width: 40ch; }
      .estado-vista .icono { color: var(--placeholder-border); }
      .estado-vista--error { color: var(--danger-text); }
      .estado-vista--error .icono { color: var(--danger-text); }
      .estado-vista .btn { padding: 0.45rem 1rem; font-size: 0.88rem; }
      .spinner {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        border: 2px solid var(--border);
        border-top-color: var(--color-accent);
        animation: girar 0.8s linear infinite;
      }
      @keyframes girar { to { transform: rotate(360deg); } }
      @media (prefers-reduced-motion: reduce) { .spinner { animation-duration: 2.4s; } }

      /* ---------- Etiquetas ---------- */
      .chip {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.15rem 0.6rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 700;
        white-space: nowrap;
        color: var(--color-navy);
        background: color-mix(in srgb, var(--chip-color) 16%, var(--color-white));
      }
      .chip::before {
        content: '';
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--chip-color);
      }
      .chip--nuevo { --chip-color: var(--estado-nuevo); }
      .chip--contactado { --chip-color: var(--estado-contactado); }
      .chip--cotizado { --chip-color: var(--estado-cotizado); }
      .chip--cerrado { --chip-color: var(--estado-cerrado); }
      .chip--descartado { --chip-color: var(--estado-descartado); }
      /* Estados de cita */
      .chip--programada { --chip-color: var(--cita-programada); }
      .chip--completada { --chip-color: var(--cita-completada); }
      .chip--cancelada { --chip-color: var(--cita-cancelada); }

      .chip-origen {
        display: inline-block;
        padding: 0.1rem 0.5rem;
        border-radius: 6px;
        font-size: 0.74rem;
        font-weight: 600;
        white-space: nowrap;
        border: 1px solid var(--border-strong);
        color: var(--text);
      }
      .chip-origen--chatbot { border-color: var(--serie-chatbot); }

      /* ---------- Controles ---------- */
      .admin input[type='search'],
      .admin input[type='text'],
      .admin input[type='email'],
      .admin input[type='password'],
      .admin input[type='tel'],
      .admin input[type='number'],
      .admin input[type='date'],
      .admin input[type='time'],
      .admin input[type='datetime-local'],
      .admin select,
      .admin textarea {
        font: inherit;
        font-size: 0.92rem;
        padding: 0.55rem 0.7rem;
        border: 1px solid var(--border-strong);
        border-radius: 8px;
        background: var(--input-bg);
        color: var(--text);
      }
      .admin select { padding-right: 1.8rem; }
      .admin :is(input, select, textarea, button, a):focus-visible {
        outline: 2px solid var(--focus-ring);
        outline-offset: 2px;
      }
      .btn--sm { padding: 0.4rem 0.85rem; font-size: 0.85rem; }

      /* ---------- Lista de próximas citas (calendario y Resumen) ---------- */
      .lista-citas { list-style: none; margin: 0; padding: 0.25rem 0 0.5rem; }
      .lista-citas li { margin: 0; }
      .cita-item {
        display: flex;
        gap: 0.75rem;
        width: 100%;
        padding: 0.7rem 1.25rem;
        border: 0;
        border-bottom: 1px solid var(--border);
        background: transparent;
        color: var(--text);
        font: inherit;
        text-align: left;
        cursor: pointer;
      }
      .lista-citas li:last-child .cita-item { border-bottom: 0; }
      .cita-item:hover { background: var(--surface-muted); text-decoration: none; }
      .cita-item__fecha {
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 46px;
        height: 50px;
        border-radius: 10px;
        background: var(--color-brand-blue-tint);
        color: var(--color-brand-blue);
        line-height: 1.05;
      }
      .cita-item__fecha small { font-size: 0.68rem; font-weight: 700; text-transform: uppercase; }
      .cita-item__fecha strong { font-size: 1.15rem; }
      .cita-item__txt { min-width: 0; display: flex; flex-direction: column; gap: 0.1rem; }
      .cita-item__txt strong { color: var(--heading); font-size: 0.9rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .cita-item__txt span { font-size: 0.8rem; color: var(--text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
    </style>
  </body>
</html>
