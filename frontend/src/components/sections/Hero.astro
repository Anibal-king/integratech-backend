---
/**
 * Inicio de la página: titular a la izquierda y una foto enmarcada a la derecha.
 * Ocupa exactamente la primera pantalla (bajo el encabezado); la franja de cifras
 * (StatsBar) sube 4.5rem sobre su borde inferior, por eso ese espacio queda
 * debajo del pliegue y no se ve al cargar.
 *
 * La foto de origen es pequeña (623 × 467), por eso va en un marco de su misma
 * proporción y no a pantalla completa (se vería borrosa).
 * El texto y la foto se editan en HERO (lib/imagenes.ts).
 */
import { Image } from 'astro:assets';
import Section from '../Section.astro';
import { HERO } from '../../lib/imagenes';

interface Props {
  /** Misión de la empresa (API); se usa si HERO.frase es null. */
  descripcion?: string | null;
}

const RESPALDO =
  'Diseñamos, suministramos, instalamos y mantenemos infraestructura eléctrica, electromecánica y de automatización para empresas e instituciones de El Salvador.';
const frase = HERO.frase ?? (Astro.props.descripcion || RESPALDO);

// Tamaños adaptados al marco, sin pasar del ancho original de la foto.
const anchos = [...[400, 560].filter((w) => w < HERO.foto.width), HERO.foto.width];
---

<Section variant="dark" id="inicio" class="hero" aria-labelledby="inicio-title" tabindex="-1">
  <div class="container hero__grid">
    <div class="hero__texto">
      <h1 id="inicio-title" class="hero__titulo hero__entra">{HERO.titulo}</h1>
      <p class="hero__frase hero__entra">{frase}</p>
      <div class="hero__acciones hero__entra">
        <a href="/#contacto" class="btn btn--primary btn--lg">Solicitar cotización <span class="btn__arrow" aria-hidden="true">→</span></a>
        <a href="/#servicios" class="btn btn--secondary btn--lg">Ver servicios</a>
      </div>
    </div>

    <div class="hero__visual hero__entra">
      <div class="hero__marco">
        <Image
          class="hero__foto"
          src={HERO.foto}
          alt={HERO.alt}
          widths={anchos}
          sizes="(max-width: 1023px) 92vw, 600px"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
        />
      </div>
      <p class="hero__sello">
        <span>En servicio<br />desde</span>
        <strong>2003</strong>
      </p>
    </div>
  </div>
</Section>

<style>
  .hero {
    /* Alto visible = pantalla menos el encabezado (y la barra superior en escritorio) */
    --hero-arriba: var(--header-height);
    /* Lo que la franja de cifras sube sobre el hero (StatsBar: margin-top -4.5rem) */
    --hero-solape: 4.5rem;
    position: relative;
    overflow: hidden;
    background: var(--color-navy-deep);
  }
  @media (min-width: 1024px) {
    .hero { --hero-arriba: calc(var(--header-height) + 40px); }
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    min-height: calc(100svh - var(--hero-arriba) + var(--hero-solape));
    padding-block: clamp(2.5rem, 6vh, 4rem) calc(var(--hero-solape) + clamp(2.5rem, 6vh, 4rem));
  }

  /* ---------- Texto ---------- */
  .hero__titulo {
    margin: 0 0 1.25rem;
    max-width: 16ch;
    color: var(--overlay-text);
    font-size: clamp(2.3rem, 1.2rem + 3.4vw, 4rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.015em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }
  .hero__frase {
    margin: 0;
    max-width: 52ch;
    color: var(--color-text-on-dark);
    font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.25rem);
    line-height: 1.6;
  }
  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.25rem;
  }
  .hero__acciones .btn:focus-visible {
    outline: 3px solid var(--overlay-text);
    outline-offset: 3px;
  }

  /* ---------- Foto ---------- */
  .hero__visual {
    position: relative;
    justify-self: end;
    width: min(100%, 600px);
  }
  .hero__marco {
    position: relative;
    aspect-ratio: 4 / 3; /* la proporción de la foto: no se recorta ni se agranda de más */
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-navy);
  }
  .hero__foto {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* El dato duro de la primera pantalla, sobre la esquina de la foto */
  .hero__sello {
    position: absolute;
    left: -2rem;
    bottom: -1.75rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin: 0;
    padding: 1rem 1.35rem;
    border-radius: var(--radius-lg);
    background: var(--color-white);
    color: var(--color-ink);
    box-shadow: var(--shadow-lg);
  }
  .hero__sello span { font-size: 0.9rem; line-height: 1.25; font-weight: 500; }
  .hero__sello strong {
    font-family: var(--font-display);
    font-size: 2.4rem;
    line-height: 1;
    font-weight: 600;
    color: var(--color-brand-blue);
  }

  /* ---------- Entrada (una sola vez, al cargar) ---------- */
  .hero__entra {
    animation: hero-entra 0.7s var(--ease, ease-out) both;
  }
  .hero__frase.hero__entra { animation-delay: 0.08s; }
  .hero__acciones.hero__entra { animation-delay: 0.16s; }
  .hero__visual.hero__entra { animation-delay: 0.12s; }
  @keyframes hero-entra {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__entra { animation: none; }
  }

  /* ---------- Tableta y móvil: texto arriba, la foto ocupa lo que queda ---------- */
  @media (max-width: 1023px) {
    .hero__grid {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 2rem;
      padding-block: clamp(2rem, 5vh, 3rem) calc(var(--hero-solape) + 1.5rem);
    }
    .hero__visual {
      flex: 1 1 auto;
      display: flex;
      justify-self: stretch;
      width: 100%;
      min-height: 180px;
      max-height: 460px;
    }
    .hero__marco { flex: 1; aspect-ratio: auto; }
    .hero__sello { left: 1rem; bottom: 1rem; padding: 0.75rem 1rem; }
    .hero__sello strong { font-size: 1.9rem; }
  }
  @media (max-width: 640px) {
    .hero__grid { gap: 1.5rem; }
    .hero__acciones { flex-direction: column; align-items: stretch; margin-top: 1.75rem; }
  }
</style>
