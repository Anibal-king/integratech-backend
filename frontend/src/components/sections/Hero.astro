---
/**
 * Inicio de la página: titular a la izquierda y carrusel de fotos enmarcado a la
 * derecha, con fundido. Las fotos de origen son pequeñas (≈ 600–900 px), por eso
 * se muestran en un marco y no a pantalla completa (se verían borrosas).
 * Las diapositivas (textos y fotos) se editan en DIAPOSITIVAS_HERO (lib/imagenes.ts).
 *
 * Sin librerías: el HTML trae todas las diapositivas (sin JS se ve la primera) y un
 * script pequeño hace el avance automático, los puntos, el teclado y el deslizamiento.
 */
import { Image } from 'astro:assets';
import Section from '../Section.astro';
import { DIAPOSITIVAS_HERO } from '../../lib/imagenes';

interface Props {
  /** Misión de la empresa (API); si falta se usa el texto de respaldo. */
  descripcion?: string | null;
}

const RESPALDO =
  'Diseñamos, suministramos, instalamos y mantenemos infraestructura eléctrica, electromecánica y de automatización para empresas e instituciones de El Salvador.';
const descripcion = Astro.props.descripcion || RESPALDO;

const diapositivas = DIAPOSITIVAS_HERO.map((d) => ({ ...d, frase: d.frase ?? descripcion }));
const total = diapositivas.length;

// Tamaños adaptados al marco, sin pasar del ancho original de la foto.
const anchos = (ancho: number) => [...[400, 560].filter((w) => w < ancho), ancho];
---

<Section variant="dark" id="inicio" class="hero" aria-labelledby="inicio-title" tabindex="-1">
  <!-- Trama técnica de fondo (decorativa) -->
  <div class="hero__trama" aria-hidden="true"></div>

  <div
    class="container hero__carrusel"
    data-hero
    role="region"
    aria-roledescription="carrusel"
    aria-label="Destacados de Servicios Integrales de Ingeniería"
  >
    <div class="hero__contenido">
      <span class="eyebrow">Desde 2003 · El Salvador</span>

      <div class="hero__textos" data-hero-textos aria-live="off">
        {diapositivas.map((d, i) => (
          <div
            class:list={['hero__slide', { 'is-activa': i === 0 }]}
            data-hero-slide
            role="group"
            aria-roledescription="diapositiva"
            aria-label={`${i + 1} de ${total}`}
            aria-hidden={i === 0 ? undefined : 'true'}
            inert={i === 0 ? undefined : true}
          >
            {i === 0 ? <h1 id="inicio-title" class="hero__titulo">{d.titulo}</h1> : <h2 class="hero__titulo">{d.titulo}</h2>}
            <p class="hero__frase">{d.frase}</p>
          </div>
        ))}
      </div>

      <!-- Mismos botones y destinos en todas las diapositivas -->
      <div class="hero__acciones">
        <a href="/#contacto" class="btn btn--primary btn--lg">Solicitar cotización <span class="btn__arrow" aria-hidden="true">→</span></a>
        <a href="/#servicios" class="btn btn--secondary btn--lg">Ver servicios</a>
      </div>

      <div class="hero__controles">
        <span class="hero__contador" aria-hidden="true"><b data-hero-actual>01</b> / {String(total).padStart(2, '0')}</span>
        <div class="hero__puntos">
          {diapositivas.map((d, i) => (
            <button
              type="button"
              class="hero__punto"
              data-hero-punto={i}
              aria-label={`Ir a la diapositiva ${i + 1} de ${total}: ${d.titulo}`}
              aria-current={i === 0 ? 'true' : undefined}
            ></button>
          ))}
        </div>
        <!-- Detener el avance automático (WCAG 2.2.2); se oculta si no hay avance automático -->
        <button type="button" class="hero__pausa" data-hero-pausa aria-label="Pausar el carrusel" hidden>
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" data-icono-pausa><path d="M7 5h3v14H7zM14 5h3v14h-3z" fill="currentColor" /></svg>
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" data-icono-play><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
        </button>
      </div>
    </div>

    <!-- Fotos (decorativas para el lector: el texto de cada diapositiva lleva el mensaje) -->
    <div class="hero__visual" aria-hidden="true">
      <svg class="hero__circulos" viewBox="0 0 200 200">
        <circle cx="100" cy="100" r="96" />
        <circle cx="100" cy="100" r="74" />
      </svg>
      <div class="hero__marco">
        {diapositivas.map((d, i) => (
          <Image
            class:list={['hero__foto', { 'is-activa': i === 0 }]}
            data-hero-foto
            src={d.foto}
            alt={d.alt}
            widths={anchos(d.foto.width)}
            sizes="(max-width: 1023px) 92vw, 560px"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'low'}
            decoding={i === 0 ? 'sync' : 'async'}
          />
        ))}
      </div>
      <div class="hero__sello">
        <strong>+20</strong>
        <span>años de<br />experiencia</span>
      </div>
    </div>
  </div>
</Section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 90% at 85% 40%, color-mix(in srgb, var(--color-brand-blue) 55%, transparent) 0%, transparent 70%),
      linear-gradient(160deg, var(--color-navy) 0%, var(--color-navy-deep) 100%);
  }
  /* Cuadrícula técnica muy tenue, como papel de plano */
  .hero__trama {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: linear-gradient(90deg, transparent 0%, #000 45%, #000 100%);
  }

  .hero__carrusel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    min-height: clamp(560px, calc(100svh - var(--header-height) - 40px), 820px);
    padding-block: clamp(3.5rem, 8vh, 5.5rem) clamp(7rem, 12vh, 8.5rem); /* abajo: espacio para la franja de cifras */
    touch-action: pan-y; /* el deslizamiento horizontal lo maneja el carrusel */
  }

  /* ---------- Texto ---------- */
  /* Todas las diapositivas en la misma celda: el bloque mide lo que la más alta */
  .hero__textos { display: grid; }
  .hero__slide {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.8s ease, transform 0.8s var(--ease);
  }
  .hero__slide.is-activa { opacity: 1; transform: none; }
  .hero__titulo {
    margin: 0 0 1.25rem;
    max-width: 18ch;
    color: var(--overlay-text);
    font-size: clamp(2.3rem, 1.2rem + 3.4vw, 4rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.015em;
    overflow-wrap: break-word;
  }
  .hero__frase {
    margin: 0;
    max-width: 52ch;
    color: var(--color-text-on-dark);
    font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.25rem);
    line-height: 1.6;
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.25rem;
  }

  /* ---------- Controles ---------- */
  .hero__controles {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2.75rem;
  }
  .hero__contador {
    font-family: var(--font-display);
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    color: var(--color-text-on-dark);
  }
  .hero__contador b { color: var(--overlay-text); font-weight: 600; }
  .hero__puntos { display: flex; gap: 0.15rem; }
  /* Botón de 32 px (área táctil) con una barra dibujada en el centro */
  .hero__punto {
    position: relative;
    width: 36px;
    height: 32px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .hero__punto::before {
    content: '';
    position: absolute;
    inset: 50% 4px auto 4px;
    height: 3px;
    border-radius: 2px;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.28);
    transition: background-color 0.3s ease;
  }
  .hero__punto[aria-current='true']::before { background: var(--color-accent-light); }
  .hero__punto:hover::before { background: var(--overlay-text); }
  .hero__pausa {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: transparent;
    color: var(--overlay-text);
    cursor: pointer;
  }
  .hero__pausa:hover { background: var(--overlay-control-bg); }
  .hero__pausa[hidden] { display: none; }
  .hero__pausa [data-icono-play],
  .hero__pausa.is-detenido [data-icono-pausa] { display: none; }
  .hero__pausa.is-detenido [data-icono-play] { display: block; }
  .hero__acciones .btn:focus-visible,
  .hero__punto:focus-visible,
  .hero__pausa:focus-visible {
    outline: 3px solid var(--overlay-text);
    outline-offset: 3px;
  }

  /* ---------- Fotos ---------- */
  .hero__visual {
    position: relative;
    justify-self: end;
    width: min(100%, 540px);
  }
  /* Círculos punteados: el motivo del logo */
  .hero__circulos {
    position: absolute;
    width: 78%;
    right: -22%;
    top: -16%;
    fill: none;
    stroke: rgba(255, 255, 255, 0.28);
    stroke-width: 1.2;
    stroke-dasharray: 4 5;
  }
  .hero__marco {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-navy-deep);
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.6);
  }
  .hero__marco::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: inherit;
    background: linear-gradient(180deg, transparent 60%, color-mix(in srgb, var(--color-navy-deep) 55%, transparent));
    pointer-events: none;
  }
  .hero__foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 0.9s ease, transform 6s linear;
  }
  .hero__foto.is-activa { opacity: 1; transform: scale(1); }

  /* Sello sobre la esquina de la foto */
  .hero__sello {
    position: absolute;
    left: -2.25rem;
    bottom: 2.5rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1.1rem 1.4rem;
    border-radius: var(--radius-lg);
    background: var(--color-white);
    color: var(--color-ink);
    box-shadow: var(--shadow-lg);
  }
  .hero__sello strong {
    font-family: var(--font-display);
    font-size: 2.6rem;
    line-height: 1;
    font-weight: 600;
    color: var(--color-brand-blue);
  }
  .hero__sello span { font-size: 0.9rem; line-height: 1.25; font-weight: 500; }

  @media (prefers-reduced-motion: reduce) {
    .hero__foto, .hero__slide, .hero__punto::before { transition: none; transform: none; }
  }

  /* ---------- Tableta y móvil ---------- */
  @media (max-width: 1023px) {
    .hero__carrusel {
      grid-template-columns: 1fr;
      min-height: 0;
      padding-block: 3rem 7rem;
    }
    .hero__visual { justify-self: stretch; width: 100%; max-width: 640px; }
    .hero__marco { aspect-ratio: 16 / 10; }
    .hero__circulos { display: none; }
    .hero__sello { left: 1rem; bottom: 1rem; padding: 0.8rem 1rem; }
    .hero__sello strong { font-size: 2rem; }
  }
  @media (max-width: 640px) {
    .hero__acciones { flex-direction: column; align-items: stretch; }
    .hero__controles { margin-top: 2rem; }
  }
</style>

<script>
  /*
   * Carrusel del inicio. Se reinicia en cada astro:page-load (View Transitions).
   * - Fundido entre diapositivas; avance cada 6 s, salvo con «reducir movimiento».
   * - Pausa al pasar el mouse o al enfocar un control; botón para detenerlo.
   * - Puntos, flechas ← → (con el foco dentro del carrusel) y deslizamiento táctil.
   */
  const INTERVALO_MS = 6000;
  let limpiar: (() => void) | null = null;

  function iniciar() {
    limpiar?.();
    limpiar = null;
    const raiz = document.querySelector<HTMLElement>('[data-hero]');
    if (!raiz) return;

    const fotos = [...raiz.querySelectorAll<HTMLElement>('[data-hero-foto]')];
    const slides = [...raiz.querySelectorAll<HTMLElement>('[data-hero-slide]')];
    const puntos = [...raiz.querySelectorAll<HTMLButtonElement>('[data-hero-punto]')];
    const textos = raiz.querySelector<HTMLElement>('[data-hero-textos]')!;
    const pausa = raiz.querySelector<HTMLButtonElement>('[data-hero-pausa]')!;
    const contador = raiz.querySelector<HTMLElement>('[data-hero-actual]');
    const total = slides.length;
    if (total < 2) return;

    const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let actual = 0;
    let temporizador: number | undefined;
    let encima = false; // mouse o foco dentro
    let detenido = sinMovimiento; // por el usuario (botón) o por preferencia

    function mostrar(i: number) {
      actual = (i + total) % total;
      slides.forEach((s, n) => {
        const activa = n === actual;
        s.classList.toggle('is-activa', activa);
        s.toggleAttribute('inert', !activa);
        if (activa) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
      });
      fotos.forEach((f, n) => f.classList.toggle('is-activa', n === actual));
      puntos.forEach((p, n) => (n === actual ? p.setAttribute('aria-current', 'true') : p.removeAttribute('aria-current')));
      if (contador) contador.textContent = String(actual + 1).padStart(2, '0');
    }

    function programar() {
      clearInterval(temporizador);
      temporizador = undefined;
      const corre = !detenido && !encima && !document.hidden;
      // Mientras avanza solo, el lector no anuncia cada cambio; al manejarlo a mano, sí.
      textos.setAttribute('aria-live', corre ? 'off' : 'polite');
      if (corre) temporizador = window.setInterval(() => mostrar(actual + 1), INTERVALO_MS);
    }

    /** Cambio hecho por el usuario: reinicia la cuenta de 6 s. */
    function ir(i: number) {
      mostrar(i);
      programar();
    }

    puntos.forEach((p, n) => p.addEventListener('click', () => ir(n)));

    // Botón de pausa (solo tiene sentido si hay avance automático)
    pausa.hidden = sinMovimiento;
    pausa.addEventListener('click', () => {
      detenido = !detenido;
      pausa.setAttribute('aria-label', detenido ? 'Reanudar el carrusel' : 'Pausar el carrusel');
      pausa.classList.toggle('is-detenido', detenido);
      programar();
    });

    const alEntrar = () => { encima = true; programar(); };
    const alSalir = () => { encima = raiz.matches(':hover') || raiz.contains(document.activeElement); programar(); };
    raiz.addEventListener('mouseenter', alEntrar);
    raiz.addEventListener('mouseleave', alSalir);
    raiz.addEventListener('focusin', alEntrar);
    raiz.addEventListener('focusout', (e) => {
      if (!raiz.contains(e.relatedTarget as Node | null)) {
        encima = raiz.matches(':hover');
        programar();
      }
    });

    // Flechas del teclado con el foco dentro del carrusel
    raiz.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      ir(actual + (e.key === 'ArrowRight' ? 1 : -1));
      // Si el foco está en un punto, lo lleva al punto de la diapositiva nueva
      if ((e.target as HTMLElement).matches('[data-hero-punto]')) puntos[actual].focus();
    });

    // Deslizar en pantallas táctiles
    let x0 = 0;
    let y0 = 0;
    raiz.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
    raiz.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - x0;
      const dy = e.changedTouches[0].clientY - y0;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) ir(actual + (dx < 0 ? 1 : -1));
    }, { passive: true });

    // Pestaña oculta: no avanzar
    const alCambiarVisibilidad = () => programar();
    document.addEventListener('visibilitychange', alCambiarVisibilidad);

    programar();
    limpiar = () => {
      clearInterval(temporizador);
      document.removeEventListener('visibilitychange', alCambiarVisibilidad);
    };
  }

  document.addEventListener('astro:page-load', iniciar);
  document.addEventListener('astro:before-swap', () => limpiar?.());
</script>
