---
/**
 * Referencias de clientes: lista de clientes (pestañas) y, a la derecha, todos
 * los trabajos realizados para el cliente elegido. Sin JavaScript se ven todos
 * los paneles uno tras otro (las pestañas solo aparecen con <html class="js">).
 */
import Section, { type SectionVariant } from '../Section.astro';
import StatusMessage from '../StatusMessage.astro';
import { api, dataOr } from '../../lib/api';

interface Props {
  variant: SectionVariant;
}

const { variant } = Astro.props;
const [clientes, otros] = await Promise.all([
  api.clientes(),
  api.otrosClientes().then((r) => dataOr(r, [])),
]);
const lista = clientes.status === 'ok' ? clientes.data.filter((c) => c.servicios.length > 0) : [];
const totalTrabajos = (n: number) => (n === 1 ? '1 trabajo realizado' : `${n} trabajos realizados`);
---

<Section variant={variant} id="clientes" class="section reveal" aria-labelledby="clientes-title" tabindex="-1">
  <div class="container">
    <div class="section__head section__head--split">
      <div>
        <span class="eyebrow">Referencias</span>
        <h2 id="clientes-title">Clientes que respaldan nuestro trabajo</h2>
      </div>
      <p>
        Banca, industria avícola y alimenticia, energía, gobierno e instituciones: estos son algunos de los trabajos
        que hemos realizado para ellos.
      </p>
    </div>

    {clientes.status !== 'ok' ? (
      <StatusMessage resultado={clientes} vacio="Pronto publicaremos aquí las empresas que confían en nosotros." />
    ) : (
      <div class="ref" data-ref>
        <div class="ref__tabs" role="tablist" aria-label="Clientes" aria-orientation="vertical">
          {lista.map((c, i) => (
            <button
              type="button"
              role="tab"
              id={`ref-tab-${i}`}
              class="ref__tab"
              aria-controls={`ref-panel-${i}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-ref-tab
            >
              <span>{c.nombre}</span>
              <span class="ref__cuenta" aria-hidden="true">{c.servicios.length}</span>
            </button>
          ))}
        </div>

        <div class="ref__paneles">
          {lista.map((c, i) => (
            <article
              class:list={['ref__panel', { 'is-activa': i === 0 }]}
              id={`ref-panel-${i}`}
              role="tabpanel"
              aria-labelledby={`ref-tab-${i}`}
              data-ref-panel
            >
              <p class="ref__total">{totalTrabajos(c.servicios.length)}</p>
              <h3>{c.nombre}</h3>
              <ul>
                {c.servicios.map((s) => <li>{s}</li>)}
              </ul>
              <a href="/#contacto" class="link-arrow">Solicitar un proyecto similar</a>
            </article>
          ))}
        </div>
      </div>
    )}

    {otros.length > 0 && (
      <div class="otros">
        <h3>También han trabajado con nosotros</h3>
        <ul class="chips">
          {otros.map((o) => <li>{o.nombre}</li>)}
        </ul>
      </div>
    )}
  </div>
</Section>

<style>
  .ref {
    display: grid;
    grid-template-columns: minmax(260px, 0.8fr) minmax(0, 1.6fr);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-card);
    box-shadow: var(--shadow-sm);
  }

  /* ---------- Pestañas ---------- */
  .ref__tabs {
    display: none;
    flex-direction: column;
    padding: 0.75rem;
    background: var(--surface-muted);
    border-right: 1px solid var(--border);
  }
  :global(.js) .ref__tabs { display: flex; }
  .ref__tab {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 0.85rem 1rem;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.98rem;
    font-weight: 500;
    line-height: 1.3;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .ref__tab:hover { background: var(--surface-card); color: var(--link); }
  .ref__tab[aria-selected='true'] {
    background: var(--color-brand-blue);
    color: var(--color-white);
  }
  .ref__tab:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
  .ref__cuenta {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    min-width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    background: var(--surface-card);
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 600;
  }
  .ref__tab[aria-selected='true'] .ref__cuenta { background: rgba(255, 255, 255, 0.18); color: var(--color-white); }

  /* ---------- Paneles ---------- */
  .ref__paneles { padding: clamp(1.75rem, 4vw, 3rem); }
  :global(.js) .ref__panel:not(.is-activa) { display: none; }
  .ref__panel + .ref__panel { margin-top: 2.5rem; }
  :global(.js) .ref__panel + .ref__panel { margin-top: 0; }
  .ref__panel.is-activa { animation: ref-entra 0.4s var(--ease); }
  @keyframes ref-entra {
    from { opacity: 0; transform: translateY(8px); }
  }
  .ref__total {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--eyebrow);
  }
  .ref__panel h3 { font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.1rem); margin-bottom: 1.5rem; }
  .ref__panel ul { list-style: none; margin: 0 0 2rem; padding: 0; }
  .ref__panel li {
    position: relative;
    margin: 0;
    padding: 0.9rem 0 0.9rem 2.25rem;
    border-top: 1px solid var(--border);
    line-height: 1.5;
  }
  .ref__panel li::before {
    content: '';
    position: absolute;
    left: 0.35rem;
    top: 1.15rem;
    width: 0.45rem;
    height: 0.8rem;
    border: solid var(--accent);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  /* ---------- Otros clientes ---------- */
  .otros { margin-top: clamp(2.5rem, 5vw, 3.5rem); }
  .otros h3 {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }
  .chips { display: flex; flex-wrap: wrap; gap: 0.6rem; list-style: none; margin: 0; padding: 0; }
  .chips li {
    margin: 0;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-card);
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--heading);
  }

  @media (prefers-reduced-motion: reduce) {
    .ref__panel.is-activa { animation: none; }
  }
  /* Móvil: pestañas en fila con desplazamiento horizontal */
  @media (max-width: 860px) {
    .ref { grid-template-columns: 1fr; }
    .ref__tabs {
      flex-direction: row;
      overflow-x: auto;
      gap: 0.4rem;
      border-right: 0;
      border-bottom: 1px solid var(--border);
      scrollbar-width: thin;
    }
    .ref__tab { width: auto; flex-shrink: 0; white-space: nowrap; }
  }
</style>

<script>
  /*
   * Pestañas de referencias (patrón WAI-ARIA Tabs, activación automática):
   * clic o flechas ↑↓←→ / Inicio / Fin. Se reinicia en cada astro:page-load.
   */
  function iniciarReferencias() {
    const raiz = document.querySelector<HTMLElement>('[data-ref]');
    if (!raiz) return;
    const tabs = [...raiz.querySelectorAll<HTMLButtonElement>('[data-ref-tab]')];
    const paneles = [...raiz.querySelectorAll<HTMLElement>('[data-ref-panel]')];

    function activar(i: number, enfocar = false) {
      tabs.forEach((t, n) => {
        const on = n === i;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        paneles[n].classList.toggle('is-activa', on);
      });
      if (enfocar) {
        tabs[i].focus();
        tabs[i].scrollIntoView({ block: 'nearest', inline: 'nearest' });
      }
    }

    tabs.forEach((t, i) => t.addEventListener('click', () => activar(i)));
    raiz.querySelector('[role="tablist"]')!.addEventListener('keydown', (e) => {
      const ev = e as KeyboardEvent;
      const actual = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
      const destino: Record<string, number> = {
        ArrowDown: actual + 1,
        ArrowRight: actual + 1,
        ArrowUp: actual - 1,
        ArrowLeft: actual - 1,
        Home: 0,
        End: tabs.length - 1,
      };
      if (!(ev.key in destino)) return;
      ev.preventDefault();
      activar((destino[ev.key] + tabs.length) % tabs.length, true);
    });
  }

  document.addEventListener('astro:page-load', iniciarReferencias);
</script>
