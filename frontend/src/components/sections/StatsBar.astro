---
import Section, { type SectionVariant } from '../Section.astro';

interface Props {
  /** Servicios publicados; null si la API no respondió (la cifra no se muestra). */
  servicios: number | null;
  /** Proyectos destacados; null si la API no respondió. */
  proyectos: number | null;
  variant: SectionVariant;
}

const { servicios, proyectos, variant } = Astro.props;

// Nada de cifras inventadas: lo que no se pudo leer de la API se omite.
const stats = [
  { valor: '20+', label: 'años de experiencia' },
  servicios ? { valor: String(servicios), label: servicios === 1 ? 'línea de servicio' : 'líneas de servicio' } : null,
  proyectos ? { valor: `${proyectos}+`, label: 'proyectos ejecutados' } : null,
].filter((s) => s !== null);
---

<Section variant={variant} aria-label="La empresa en cifras">
  <ul class="container stats__list">
    {stats.map((s) => (
      <li>
        <strong>{s.valor}</strong>
        <span>{s.label}</span>
      </li>
    ))}
  </ul>
</Section>

<style>
  .stats__list {
    list-style: none;
    margin-block: 0;
    padding-block: 1.75rem;
    display: grid;
    /* 2 o 3 cifras según lo que haya: columnas iguales */
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 1.5rem;
  }
  .stats__list li {
    margin: 0;
    display: flex;
    flex-direction: column;
    text-align: center;
  }
  .stats__list strong {
    font-size: clamp(1.5rem, 1rem + 2vw, 2rem);
    color: var(--heading);
    line-height: 1.2;
  }
  .stats__list span {
    font-size: 0.85rem;
    color: var(--text);
  }
</style>
