---
import Section, { type SectionVariant } from '../Section.astro';

interface Props {
  servicios?: number;
  proyectos?: number;
  variant: SectionVariant;
}

const { servicios = 0, proyectos = 0, variant } = Astro.props;

const stats = [
  { valor: '20+', label: 'años de experiencia' },
  { valor: String(servicios || 8), label: 'líneas de servicio' },
  { valor: `${proyectos || 30}+`, label: 'proyectos ejecutados' },
];
---

<Section variant={variant} aria-label="La empresa en cifras">
  <ul class="container stats__list">
    {stats.map((s) => (
      <li>
        <strong>{s.valor}</strong>
        <span>{s.label}</span>
      </li>
    ))}
  </ul>
</Section>

<style>
  .stats__list {
    list-style: none;
    margin-block: 0;
    padding-block: 1.75rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .stats__list li {
    margin: 0;
    display: flex;
    flex-direction: column;
    text-align: center;
  }
  .stats__list strong {
    font-size: clamp(1.5rem, 1rem + 2vw, 2rem);
    color: var(--heading);
    line-height: 1.2;
  }
  .stats__list span {
    font-size: 0.85rem;
    color: var(--text);
  }
</style>
