---
import { Image } from 'astro:assets';
import Section, { type SectionVariant } from '../Section.astro';
import { api } from '../../lib/api';
import { bandaProyectos, todasLasFotos } from '../../lib/imagenes';

interface Props {
  variant: SectionVariant;
}

const { variant } = Astro.props;
const proyectos = await api.proyectos();
const proyectosDestacados = proyectos.slice(0, 3);
---

<Section variant={variant} id="proyectos" class="section reveal" aria-labelledby="proyectos-title" tabindex="-1">
  <div class="container">
    <div class="band__head">
      <div>
        <span class="eyebrow">Nuestro trabajo</span>
        <h2 id="proyectos-title">Proyectos en instalaciones reales</h2>
        <p>Data centers, subestaciones, tableros de automatización, iluminación y energía renovable.</p>
      </div>
      <a href="/proyectos" class="btn btn--secondary">Ver las {todasLasFotos.length} fotos →</a>
    </div>

    {bandaProyectos.length > 0 && (
      <div class="band__grid">
        {bandaProyectos.map((f) => (
          <a href="/proyectos" class="band__item" aria-label={f.descripcion}>
            <Image src={f.img} alt={f.descripcion} widths={[320, 560]} sizes="(max-width: 700px) 45vw, 22vw" loading="lazy" />
            <span>{f.descripcion}</span>
          </a>
        ))}
      </div>
    )}

    {proyectosDestacados.length > 0 && (
      <div class="destacados">
        <h3>Proyectos destacados</h3>
        <div class="grid grid--3">
          {proyectosDestacados.map((p) => (
            <article class="card">
              {p.ejecucion && <span class="tag">{p.ejecucion}</span>}
              <h4>{p.nombre_proyecto}</h4>
              {p.descripcion && <p>{p.descripcion}</p>}
            </article>
          ))}
        </div>
        <p class="destacados__more">
          <a href="/proyectos" class="btn btn--secondary">Ver todos los proyectos →</a>
        </p>
      </div>
    )}
  </div>
</Section>

<style>
  .band__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .band__head h2 { margin-bottom: 0.35rem; }
  .band__head p { color: var(--text-muted); margin: 0; }

  .band__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.9rem;
  }
  .band__item {
    position: relative;
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: var(--surface-muted);
  }
  .band__item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; opacity: 0.9; }
  .band__item:hover img { transform: scale(1.06); opacity: 1; }
  .band__item span {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 1.4rem 0.7rem 0.6rem;
    font-size: 0.72rem;
    line-height: 1.3;
    color: var(--overlay-text);
    background: linear-gradient(to top, var(--overlay-scrim), transparent);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .band__item:hover span,
  .band__item:focus-visible span { opacity: 1; }

  .destacados { margin-top: clamp(2.5rem, 5vw, 3.5rem); }
  .destacados h3 { font-size: 1.4rem; margin-bottom: 1.25rem; }
  .destacados .card h4 { font-size: 1.1rem; margin: 0.6rem 0 0.4rem; }
  .destacados__more { margin: 1.75rem 0 0; }

  @media (max-width: 900px) {
    .band__grid { grid-template-columns: repeat(3, 1fr); }
    .band__item:nth-child(4), .band__item:nth-child(5) { display: none; }
  }
  @media (max-width: 720px) {
    .band__grid { grid-template-columns: repeat(2, 1fr); }
    .band__item:nth-child(3) { display: none; }
    .band__head .btn { width: 100%; justify-content: center; }
  }
</style>
