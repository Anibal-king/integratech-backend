---
import { Image } from 'astro:assets';
import Section, { type SectionVariant } from '../Section.astro';
import Carrusel from '../Carrusel.astro';
import { api, dataOr } from '../../lib/api';
import { marcaLogo } from '../../lib/imagenes';

interface Props {
  variant: SectionVariant;
}

const { variant } = Astro.props;
const marcas = dataOr(await api.marcas(), []);
// Más lento que «Han confiado en nosotros» (~80 px/s): las tarjetas tienen texto que leer.
// Cada tarjeta (ancho + separación) tarda 4,5 s en pasar: ~60 px/s en escritorio.
const duracion = `calc(${marcas.length} * 4.5s)`;
---

{marcas.length > 0 && (
  <Section variant={variant} id="marcas" class="section" aria-labelledby="marcas-title">
    <div class="container">
      <div class="section__head section__head--center">
        <span class="eyebrow">Respaldo internacional</span>
        <h2 id="marcas-title">Marcas que representamos</h2>
        <p>Trabajamos con fabricantes reconocidos en generación, respaldo de energía, protección y automatización.</p>
      </div>

      <!-- Mismo carrusel que «Han confiado en nosotros», en dirección contraria -->
      <Carrusel
        class="marcas"
        duracion={duracion}
        reverso
        separacion="16px"
        quieto="deslizar"
        etiqueta="Marcas que representamos"
        continuo
      >
        {marcas.map((m) => {
          const logo = marcaLogo(m.nombre);
          return (
            <li class="marca">
              <div class="marca__logo">
                {logo ? (
                  <Image src={logo} alt={m.nombre} widths={[200, 400]} sizes="200px" loading="lazy" />
                ) : (
                  <span class="marca__nombre">{m.nombre}</span>
                )}
              </div>
              <div class="marca__txt">
                <h3>{m.nombre}</h3>
                {m.funcion && <p>{m.funcion}</p>}
              </div>
            </li>
          );
        })}
      </Carrusel>
    </div>
  </Section>
)}

<style>
  /* Aire arriba y abajo para que la sombra de las tarjetas no se recorte */
  .marcas { padding-block: 0.5rem 1rem; }
  .marca {
    flex-shrink: 0;
    align-self: stretch;
    width: 256px;
    margin: 0;
    display: flex;
    flex-direction: column;
    background: var(--media-plate);
    border: 1px solid var(--border);
    border-radius: 0;
    box-shadow: var(--sombra-tarjeta);
  }
  .marca__logo {
    display: grid;
    place-items: center;
    height: 120px;
    padding: 1.25rem 1.5rem;
  }
  .marca__logo img {
    max-width: 100%;
    max-height: 64px;
    width: auto;
    object-fit: contain;
  }
  .marca__nombre { font-weight: 700; text-align: center; color: var(--media-plate-text); }
  .marca__txt {
    flex: 1;
    padding: 0 1.25rem 1.4rem;
    text-align: center;
  }
  .marca__txt h3 {
    margin: 0 0 0.3rem;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--media-plate-text);
  }
  .marca__txt p { margin: 0; font-size: 0.85rem; line-height: 1.45; color: var(--color-navy-soft); }

  @media (max-width: 640px) {
    .marca { width: 224px; }
    .marca__logo { height: 96px; padding: 1rem; }
  }
</style>
