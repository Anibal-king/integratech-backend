---
import Section, { type SectionVariant } from '../Section.astro';
import StatusMessage from '../StatusMessage.astro';
import ServiciosCatalogo from '../ServiciosCatalogo.astro';
import { api, type ApiResult, type CategoriaServicio } from '../../lib/api';

interface Props {
  variant: SectionVariant;
  /** Resultado ya pedido por la página (evita repetir la consulta). */
  servicios?: ApiResult<CategoriaServicio[]>;
}

const { variant } = Astro.props;
// Se lee en cada visita (la página se renderiza en el servidor): refleja el panel al instante.
// Si la API falla, solo esta sección muestra el aviso; el resto de la página sigue normal.
const servicios = Astro.props.servicios ?? (await api.servicios());
---

<Section variant={variant} id="servicios" class="section reveal" aria-labelledby="servicios-title" tabindex="-1">
  <div class="container">
    <div class="section__head">
      <span class="eyebrow">Catálogo</span>
      <h2 id="servicios-title">Productos y servicios</h2>
      <p>Nuestras líneas de trabajo. Cada categoría agrupa capacidades específicas que ejecutamos con personal propio y marcas representadas.</p>
    </div>

    {servicios.status !== 'ok' ? (
      <StatusMessage resultado={servicios} vacio="Pronto publicaremos nuestros servicios aquí." />
    ) : (
      // 5 servicios + «Ver más» (si hay más de 6); el buscador busca en todos
      <ServiciosCatalogo servicios={servicios.data} limite={5} />
    )}
  </div>
</Section>
