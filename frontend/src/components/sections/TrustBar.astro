---
/**
 * Franja «Han confiado en nosotros»: nombres de clientes (principales + otros)
 * en desplazamiento continuo con el carrusel compartido (Carrusel.astro). Con
 * «reducir movimiento» la lista queda quieta y se ajusta en varias líneas.
 */
import Section, { type SectionVariant } from '../Section.astro';
import Carrusel from '../Carrusel.astro';

interface Props {
  nombres: string[];
  variant: SectionVariant;
}

const { nombres, variant } = Astro.props;
// Nombres cortos para la franja: sin la razón social (", S.A. de C.V.").
const cortos = nombres.map((n) => n.replace(/,?\s*S\.?\s*A\.?(\s*de\s*C\.?\s*V\.?)?\s*$/i, '').trim());
---

{cortos.length > 0 && (
  <Section variant={variant} class="trust" aria-labelledby="trust-title">
    <div class="container trust__inner">
      <h2 id="trust-title" class="trust__titulo">Han confiado <br />en nosotros</h2>
      <Carrusel duracion="60s" quieto="envolver">
        {cortos.map((n) => <li class="trust__nombre">{n}</li>)}
      </Carrusel>
    </div>
  </Section>
)}

<style>
  .trust { padding-block: clamp(2.5rem, 5vw, 3.5rem); }
  .trust__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .trust__titulo {
    margin: 0;
    padding-right: clamp(1.5rem, 4vw, 3rem);
    border-right: 1px solid var(--border);
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .trust__nombre {
    margin: 0;
    padding-inline: 1.6rem;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--heading);
    opacity: 0.72;
    position: relative;
  }
  /* Separador: cuadro pequeño en el azul de acento */
  .trust__nombre::after {
    content: '';
    position: absolute;
    right: -3px;
    top: 50%;
    width: 5px;
    height: 5px;
    background: var(--accent);
    transform: translateY(-50%);
    opacity: 0.6;
  }
  @media (max-width: 720px) {
    .trust__inner { grid-template-columns: 1fr; }
    .trust__titulo { border-right: 0; padding-right: 0; }
    .trust__titulo br { display: none; }
  }
</style>
