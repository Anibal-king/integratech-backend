---
/**
 * Franja «Han confiado en nosotros»: nombres de clientes (principales + otros)
 * en desplazamiento continuo. La segunda copia de la lista es solo visual
 * (aria-hidden) para que el bucle no tenga cortes. Con «reducir movimiento»
 * la lista queda quieta y se ajusta en varias líneas.
 */
import Section, { type SectionVariant } from '../Section.astro';

interface Props {
  nombres: string[];
  variant: SectionVariant;
}

const { nombres, variant } = Astro.props;
// Nombres cortos para la franja: sin la razón social (", S.A. de C.V.").
const cortos = nombres.map((n) => n.replace(/,?\s*S\.?\s*A\.?(\s*de\s*C\.?\s*V\.?)?\s*$/i, '').trim());
---

{cortos.length > 0 && (
  <Section variant={variant} class="trust" aria-labelledby="trust-title">
    <div class="container trust__inner">
      <h2 id="trust-title" class="trust__titulo">Han confiado <br />en nosotros</h2>
      <div class="trust__pista">
        <ul class="trust__lista">
          {cortos.map((n) => <li>{n}</li>)}
        </ul>
        <ul class="trust__lista" aria-hidden="true">
          {cortos.map((n) => <li>{n}</li>)}
        </ul>
      </div>
    </div>
  </Section>
)}

<style>
  .trust { padding-block: clamp(2.5rem, 5vw, 3.5rem); }
  .trust__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .trust__titulo {
    margin: 0;
    padding-right: clamp(1.5rem, 4vw, 3rem);
    border-right: 1px solid var(--border);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .trust__pista {
    display: flex;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .trust__lista {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    animation: trust-avance 60s linear infinite;
  }
  .trust__pista:hover .trust__lista { animation-play-state: paused; }
  .trust__lista li {
    margin: 0;
    padding-inline: 1.6rem;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--heading);
    opacity: 0.72;
    position: relative;
  }
  /* Separador: punto en el azul de acento */
  .trust__lista li::after {
    content: '';
    position: absolute;
    right: -3px;
    top: 50%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    transform: translateY(-50%);
    opacity: 0.6;
  }
  @keyframes trust-avance {
    to { transform: translateX(-100%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .trust__pista { mask-image: none; }
    .trust__lista { flex-wrap: wrap; flex-shrink: 1; animation: none; row-gap: 0.5rem; }
    .trust__lista[aria-hidden] { display: none; }
  }
  @media (max-width: 720px) {
    .trust__inner { grid-template-columns: 1fr; }
    .trust__titulo { border-right: 0; padding-right: 0; }
    .trust__titulo br { display: none; }
  }
</style>
