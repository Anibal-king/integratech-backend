---
import { Image } from 'astro:assets';
import Section, { type SectionVariant } from '../Section.astro';
import StatusMessage from '../StatusMessage.astro';
import Icono, { type NombreIcono } from '../Icono.astro';
import { api, dataOr } from '../../lib/api';
import { documentosLegales, fotosNosotros } from '../../lib/imagenes';

interface Props {
  variant: SectionVariant;
}

const { variant } = Astro.props;
const [empresaRes, legal] = await Promise.all([
  api.empresa(),
  api.legal().then((r) => dataOr(r, [])),
]);
const empresa = dataOr(empresaRes, null);

// Icono por valor (por nombre); los valores nuevos del panel usan el escudo.
const ICONO_VALOR: Record<string, NombreIcono> = {
  responsabilidad: 'escudo',
  honestidad: 'medalla',
  cooperacion: 'apreton',
};
const iconoValor = (nombre: string) =>
  ICONO_VALOR[nombre.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim()] ?? 'escudo';
const [fotoPrincipal, fotoSecundaria] = fotosNosotros;
---

<Section variant={variant} id="nosotros" class="section reveal" aria-labelledby="nosotros-title" tabindex="-1">
  <div class="container">
    <div class="about">
      <div class="about__fotos">
        {fotoPrincipal && (
          <Image class="about__foto about__foto--a" src={fotoPrincipal.img} alt={fotoPrincipal.descripcion} widths={[400, fotoPrincipal.img.width]} sizes="(max-width: 900px) 70vw, 380px" loading="lazy" />
        )}
        {fotoSecundaria && (
          <Image class="about__foto about__foto--b" src={fotoSecundaria.img} alt={fotoSecundaria.descripcion} widths={[320, fotoSecundaria.img.width]} sizes="(max-width: 900px) 50vw, 300px" loading="lazy" />
        )}
        <div class="about__anio">
          <span>Desde</span>
          <strong>2003</strong>
        </div>
      </div>

      <div class="about__texto">
        <span class="eyebrow">Quiénes somos</span>
        <h2 id="nosotros-title">Profesionales especializados, con experiencia comprobada</h2>

        {empresa ? (
          <>
            {empresa.resena_historica && <p class="lead">{empresa.resena_historica}</p>}

            {empresa.valores?.length > 0 && (
              <ul class="valores">
                {empresa.valores.map((v) => (
                  <li>
                    <span class="valores__icono"><Icono nombre={iconoValor(v.nombre)} tamano={22} /></span>
                    <div>
                      <h3>{v.nombre}</h3>
                      {v.descripcion && <p>{v.descripcion}</p>}
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </>
        ) : (
          empresaRes.status !== 'ok' && (
            <StatusMessage resultado={empresaRes} vacio="Pronto publicaremos aquí la información de la empresa." />
          )
        )}
      </div>
    </div>

    {empresa && (empresa.mision || empresa.vision) && (
      <div class="mv">
        {empresa.mision && (
          <article>
            <span class="mv__etiqueta">Misión</span>
            <p>{empresa.mision}</p>
          </article>
        )}
        {empresa.vision && (
          <article>
            <span class="mv__etiqueta">Visión</span>
            <p>{empresa.vision}</p>
          </article>
        )}
      </div>
    )}

    {(legal.length > 0 || empresa) && (
      <details class="legal-box">
        <summary><Icono nombre="documento" tamano={20} /> Información legal de la empresa</summary>
        <table class="legal">
          <tbody>
            {empresa?.nombre && <tr><th>Razón social</th><td>Servicios Integrales de Ingeniería El Salvador, S.A. de C.V.</td></tr>}
            {empresa?.nit && <tr><th>NIT</th><td>{empresa.nit}</td></tr>}
            {empresa?.registro_fiscal && <tr><th>Registro fiscal (NRC)</th><td>{empresa.registro_fiscal}</td></tr>}
            {empresa?.direccion && <tr><th>Dirección</th><td>{empresa.direccion}</td></tr>}
            {empresa?.telefono && <tr><th>Teléfono</th><td>{empresa.telefono}</td></tr>}
            {empresa?.celular && <tr><th>Celular</th><td>{empresa.celular}</td></tr>}
            {legal.map((d) => (
              <tr><th>{d.tipo}</th><td>{d.numero}{d.descripcion ? ` — ${d.descripcion}` : ''}</td></tr>
            ))}
          </tbody>
        </table>

        {documentosLegales.length > 0 && (
          <div class="docs">
            {documentosLegales.map((d) => (
              <figure class="doc">
                <Image src={d.img} alt={d.alt} widths={[240, 480]} sizes="240px" loading="lazy" />
                <figcaption>{d.alt}</figcaption>
              </figure>
            ))}
          </div>
        )}
      </details>
    )}
  </div>
</Section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(3rem, 7vw, 6rem);
    align-items: center;
  }

  /* ---------- Collage ---------- */
  .about__fotos {
    position: relative;
    aspect-ratio: 1 / 1.05;
  }
  .about__foto {
    position: absolute;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }
  .about__foto--a { left: 0; top: 0; width: 72%; height: 78%; }
  .about__foto--b {
    right: 0;
    bottom: 0;
    width: 52%;
    height: 54%;
    border: 6px solid var(--surface);
  }
  .about__anio {
    position: absolute;
    left: 8%;
    bottom: 4%;
    display: flex;
    flex-direction: column;
    padding: 1.1rem 1.4rem;
    border-radius: var(--radius-lg);
    background: var(--color-brand-blue);
    color: var(--color-white);
    box-shadow: var(--shadow-lg);
  }
  .about__anio span { font-size: 0.8rem; letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.85; }
  .about__anio strong { font-family: var(--font-display); font-size: 2.6rem; font-weight: 600; line-height: 1; }

  /* ---------- Texto ---------- */
  .about__texto h2 { margin-bottom: 1.25rem; }
  .about__texto .lead { margin-bottom: 2rem; }

  .valores { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  .valores li {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 1.1rem;
    margin: 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
  .valores__icono {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius);
    background: var(--color-brand-blue-tint);
    color: var(--color-brand-blue);
  }
  .valores h3 { font-size: 1.25rem; margin: 0 0 0.2rem; }
  .valores p { margin: 0; color: var(--text-muted); }

  /* ---------- Misión y visión ---------- */
  .mv {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 1.5rem;
    margin-top: clamp(3.5rem, 7vw, 5rem);
  }
  .mv article {
    position: relative;
    padding: 2rem 2rem 2rem 2.25rem;
    border-radius: var(--radius-lg);
    background: var(--surface-muted);
    border-left: 3px solid var(--color-brand-blue);
  }
  .mv__etiqueta {
    display: block;
    margin-bottom: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--heading);
  }
  .mv p { margin: 0; color: var(--text-muted); font-size: 1.05rem; }

  /* ---------- Datos legales (desplegable) ---------- */
  .legal-box {
    margin-top: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1rem 1.4rem;
  }
  .legal-box summary {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
    font-weight: 600;
    color: var(--heading);
  }
  .legal-box summary svg { color: var(--accent); }
  .legal {
    border-collapse: collapse;
    width: 100%;
    max-width: 720px;
    margin-top: 1rem;
    font-size: 0.95rem;
  }
  .legal th, .legal td {
    text-align: left;
    padding: 0.6rem 0.8rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .legal th { width: 36%; color: var(--heading); font-weight: 600; }

  .docs {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 1.75rem;
  }
  .doc { margin: 0; width: min(240px, 100%); }
  .doc img {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .doc figcaption {
    margin-top: 0.4rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.35;
  }

  @media (max-width: 900px) {
    .about { grid-template-columns: 1fr; }
    .about__fotos { max-width: 520px; width: 100%; }
  }
</style>
