---
/**
 * Tarjetas de servicios con buscador. Lo usan la sección Servicios del inicio
 * (las primeras `limite` tarjetas y la invitación a pedir un servicio personalizado) y el
 * catálogo /servicios (todas).
 *
 * Todas las tarjetas van en el HTML (visibles para buscadores). Las que pasan del
 * límite llevan `hidden` y solo aparecen al buscar; sin JavaScript se ven las
 * primeras (el catálogo completo sigue en /servicios).
 *
 * Cada tarjeta es un <article>: el enlace del título la cubre entera (toda la
 * tarjeta es clicable) y «+N servicios más» es un enlace propio encima de él.
 */
import { mediaUrl, mediaSrcset, type CategoriaServicio } from '../lib/api';

interface Props {
  servicios: CategoriaServicio[];
  /** Tarjetas visibles sin buscar, con la invitación «Solicitar servicio personalizado» debajo (y el contador al buscar). Sin límite: todas. */
  limite?: number;
  /** Nivel del título de cada tarjeta (3 bajo el h2 de la sección; 2 bajo el h1 del catálogo). */
  nivelTitulo?: 2 | 3;
}

const { servicios, limite, nivelTitulo = 3 } = Astro.props;
const total = servicios.length;
const visibles = limite === undefined ? total : Math.min(limite, total);
const conPie = limite !== undefined;
/** Ítems que se ven en cada tarjeta; el resto se resume en «+N servicios más». */
const ITEMS_VISIBLES = 4;
const Titulo = `h${nivelTitulo}` as 'h2' | 'h3';

/**
 * Texto en el que busca el filtro: título, descripción y TODOS los ítems (también
 * los que la tarjeta no muestra), sin mayúsculas, tildes, símbolos ni espacios
 * repetidos. El script normaliza lo que escribe el visitante con la misma función.
 */
const normalizar = (t: string) =>
  t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9ñ]+/g, ' ').trim();
const textoBusqueda = (s: CategoriaServicio) => normalizar([s.nombre, s.descripcion ?? '', ...s.items].join(' '));

/**
 * Sugerencias: títulos de todos los servicios (también los que no se ven en la
 * portada) y sus ítems, sin repetidos. Van como JSON en la página: el navegador
 * las filtra sin llamar al backend.
 */
const sugerencias: { t: string; s: string | null }[] = [];
const vistas = new Set<string>();
for (const sv of servicios) {
  for (const [t, de] of [[sv.nombre, null], ...sv.items.map((it) => [it, sv.nombre])] as [string, string | null][]) {
    const clave = normalizar(t);
    if (clave && !vistas.has(clave)) {
      vistas.add(clave);
      sugerencias.push({ t, s: de });
    }
  }
}
---

<div class="svc-catalogo" data-svc-raiz>
  <!-- Buscador: oculto hasta que carga el script (sin JS no hace falta) -->
  <div class="svc-buscar" role="search" data-svc-buscador hidden>
    <label for="svc-q" class="svc-sr">Buscar un servicio</label>
    <div class="svc-buscar__campo">
      <svg class="svc-buscar__icono" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
      <input
        id="svc-q"
        type="search"
        placeholder="¿Qué necesita? Ej.: generador, UPS, subestación…"
        autocomplete="off"
        spellcheck="false"
        enterkeyhint="search"
        maxlength="80"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="false"
        aria-controls="svc-sugerencias"
        aria-describedby="svc-ayuda"
        data-svc-q
      />
      <button type="button" class="svc-buscar__limpiar" aria-label="Limpiar búsqueda" data-svc-limpiar hidden>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
      </button>
      <ul id="svc-sugerencias" class="svc-sugerencias" role="listbox" aria-label="Sugerencias" data-svc-lista hidden></ul>
    </div>
    <p id="svc-ayuda" class="svc-sr">Escriba para ver sugerencias; use las flechas para recorrerlas y Enter para elegir una.</p>
    <script type="application/json" data-svc-sugerencias set:html={JSON.stringify(sugerencias).replace(/</g, '\\u003c')} />
    <p class="svc-sr" aria-live="polite" data-svc-estado></p>
  </div>

  <div class="svc-vacio" data-svc-vacio hidden>
    <p class="svc-vacio__titulo">Su proyecto merece una solución a la medida</p>
    <p>
      Aún no tenemos “<span data-svc-texto></span>” en nuestro catálogo, pero diseñamos soluciones a la medida
      todos los días. Su proyecto suena como un caso especial y nos encantaría conocerlo: cuéntenos qué
      necesita y le preparamos una cotización sin compromiso.
    </p>
    <a href="/#contacto" class="btn btn--primary" data-svc-cotizar>Solicitar cotización</a>
  </div>

  <div class="svc-grid">
    {servicios.map((s, i) => {
      // Portada administrada desde el panel (/admin/servicios), servida por el backend
      const portada = s.portada;
      const extra = i >= visibles;
      return (
        <article
          class="svc-card"
          data-svc-card
          data-svc-extra={extra ? '' : undefined}
          data-buscar={textoBusqueda(s)}
          hidden={extra}
        >
          <span class="svc-card__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          {portada ? (
            <div class="svc-card__media">
              <img
                src={mediaUrl(portada.src)}
                srcset={mediaSrcset(portada.srcset)}
                sizes="(max-width: 639px) 92vw, (max-width: 1023px) 46vw, 31vw"
                width={portada.ancho}
                height={portada.alto}
                alt={portada.alt}
                loading="lazy"
                decoding="async"
              />
            </div>
          ) : (
            // Sin foto en el panel: la misma lámina de plano del hero ocupa su lugar
            <div class="svc-card__media svc-card__media--vacia" aria-hidden="true" />
          )}
          <div class="svc-card__body">
            <Titulo class="svc-card__titulo">
              <a href={`/servicios/${s.id}`} class="svc-card__enlace">{s.nombre}</a>
            </Titulo>
            <p>{s.descripcion}</p>
            {s.items.length > 0 && (
              <ul class="svc-items">
                {s.items.slice(0, ITEMS_VISIBLES).map((it) => <li>{it}</li>)}
                {s.items.length > ITEMS_VISIBLES && (
                  <li class="svc-items__mas">
                    <a href={`/servicios/${s.id}`} class="svc-mas">
                      +{s.items.length - ITEMS_VISIBLES} {s.items.length - ITEMS_VISIBLES === 1 ? 'servicio' : 'servicios'} más<span class="svc-sr"> de {s.nombre}</span>
                      <span aria-hidden="true">→</span>
                    </a>
                  </li>
                )}
              </ul>
            )}
            <span class="svc-card__cta" aria-hidden="true">Ver detalle <span>→</span></span>
          </div>
        </article>
      );
    })}
  </div>

  {conPie && (
    <div class="svc-pie">
      <!-- Contador: solo mientras hay una búsqueda activa (el script lo llena y lo muestra) -->
      <p class="svc-pie__texto" data-svc-contador hidden></p>
      <!-- Invitación a pedir un servicio que no está en la lista: mismo flujo que
           «Solicitar cotización» del hero (formulario de contacto), marcado como personalizado -->
      <div class="svc-pie__invitacion" data-svc-invitacion>
        <p class="svc-pie__titulo">¿Necesita un servicio que no aparece aquí?</p>
        <p class="svc-pie__texto">Cuéntenos qué necesita y le preparamos una propuesta a la medida.</p>
        <a href="/#contacto" class="btn btn--primary svc-pie__boton" data-svc-personalizado>
          Solicitar servicio personalizado <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  )}
</div>

<style>
  /* ---------- Buscador ---------- */
  /* Centrada en la sección; en móvil ocupa todo el ancho */
  .svc-buscar { margin: -0.75rem auto 1.75rem; max-width: 560px; }
  .svc-buscar[hidden] { display: none; }
  .svc-buscar__campo { position: relative; }
  .svc-buscar__icono {
    position: absolute;
    left: 0.9rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
  }
  .svc-buscar input {
    width: 100%;
    min-height: 48px;
    padding: 0.7rem 3rem 0.7rem 2.7rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-btn);
    background: var(--input-bg);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
    /* Al enfocarlo en móvil queda sobre el botón flotante del chat */
    scroll-margin-block: calc(var(--header-height) + 1rem) 7rem;
  }
  .svc-buscar input::placeholder { color: var(--text-muted); opacity: 1; }
  .svc-buscar input:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
  /* La X propia reemplaza la del navegador */
  .svc-buscar input::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; }
  .svc-buscar__limpiar {
    position: absolute;
    right: 0.4rem;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: var(--radius-btn);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }
  .svc-buscar__limpiar:hover { color: var(--text); background: var(--surface-muted); }
  .svc-buscar__limpiar:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 1px; }
  .svc-buscar__limpiar[hidden] { display: none; }

  .svc-vacio {
    margin-bottom: 1.75rem;
    padding: 1.5rem;
    border: 1px dashed var(--placeholder-border);
    border-radius: var(--radius-lg);
    background: var(--placeholder-bg);
    color: var(--text);
  }
  .svc-vacio[hidden] { display: none; }

  /* ---------- Sugerencias ---------- */
  .svc-sugerencias {
    position: absolute;
    top: calc(100% + 0.4rem);
    left: 0;
    right: 0;
    z-index: 20;
    margin: 0;
    padding: 0.35rem;
    list-style: none;
    max-height: min(22rem, 60vh);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--surface-card);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
  }
  .svc-sugerencias[hidden] { display: none; }
  .svc-sugerencias :global(li) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.4rem;
    min-height: 44px; /* área táctil */
    margin: 0;
    padding: 0.6rem 0.75rem;
    border-radius: calc(var(--radius) - 4px);
    color: var(--text);
    line-height: 1.35;
    cursor: pointer;
  }
  .svc-sugerencias :global(li[aria-selected='true']),
  .svc-sugerencias :global(li:hover) { background: color-mix(in srgb, var(--color-accent) 18%, var(--surface-card)); }
  .svc-sugerencias :global(mark) { background: none; color: inherit; font-weight: 700; text-decoration: underline; text-decoration-color: var(--color-accent); text-underline-offset: 3px; }
  .svc-sugerencias :global(.svc-sug__servicio) { color: var(--text-muted); font-size: 0.85rem; }
  .svc-sugerencias :global(.svc-sug__servicio)::before { content: '· '; }
  .svc-vacio p { margin: 0 0 1rem; max-width: 62ch; }
  .svc-vacio .svc-vacio__titulo { margin-bottom: 0.4rem; font-size: 1.15rem; font-weight: 700; color: var(--heading); }
  .svc-vacio span { font-weight: 700; overflow-wrap: anywhere; }

  .svc-card[hidden] { display: none; }

  .svc-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* 3 columnas en escritorio, 2 en tableta y 1 en móvil: 6 tarjetas llenan
     3×2, 2×3 y 1×6 sin celdas vacías. Las de una fila miden lo mismo (stretch). */
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.75rem;
    align-items: stretch;
  }
  /* La última tarjeta, si queda sola en su fila, ocupa toda la fila en horizontal
     (foto a la izquierda): sin huecos vacíos. Se calcula sobre las visibles. */
  @media (min-width: 1024px) {
    .svc-grid > .svc-card:not([hidden]):nth-child(3n + 1 of .svc-card:not([hidden])):nth-last-child(1 of .svc-card:not([hidden])) {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: calc((100% - 2 * 1.75rem) / 3 + 0px) minmax(0, 1fr);
    }
    .svc-grid > .svc-card:not([hidden]):nth-child(3n + 1 of .svc-card:not([hidden])):nth-last-child(1 of .svc-card:not([hidden])) .svc-card__media { aspect-ratio: auto; position: relative; min-height: 220px; }
    .svc-grid > .svc-card:not([hidden]):nth-child(3n + 1 of .svc-card:not([hidden])):nth-last-child(1 of .svc-card:not([hidden])) .svc-card__media img { position: absolute; inset: 0; }
    .svc-grid > .svc-card:not([hidden]):nth-child(3n + 1 of .svc-card:not([hidden])):nth-last-child(1 of .svc-card:not([hidden])) .svc-card__body { padding: 2rem 2.25rem; }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .svc-grid > .svc-card:not([hidden]):nth-child(2n + 1 of .svc-card:not([hidden])):nth-last-child(1 of .svc-card:not([hidden])) {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: calc((100% - 1.75rem) / 2) minmax(0, 1fr);
    }
    .svc-grid > .svc-card:not([hidden]):nth-child(2n + 1 of .svc-card:not([hidden])):nth-last-child(1 of .svc-card:not([hidden])) .svc-card__media { aspect-ratio: auto; position: relative; min-height: 220px; }
    .svc-grid > .svc-card:not([hidden]):nth-child(2n + 1 of .svc-card:not([hidden])):nth-last-child(1 of .svc-card:not([hidden])) .svc-card__media img { position: absolute; inset: 0; }
    .svc-grid > .svc-card:not([hidden]):nth-child(2n + 1 of .svc-card:not([hidden])):nth-last-child(1 of .svc-card:not([hidden])) .svc-card__body { padding: 2rem 2.25rem; }
  }
  @media (max-width: 1023px) {
    .svc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 639px) {
    .svc-grid { grid-template-columns: minmax(0, 1fr); }
  }
  .svc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-card);
    color: var(--text);
    box-shadow: var(--sombra-tarjeta);
    transition: transform 200ms var(--ease-out), box-shadow 200ms var(--ease-out);
  }
  /* Línea de acento que crece en la parte superior al pasar el mouse */
  .svc-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 2;
    height: 3px;
    background: var(--color-brand-blue);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 260ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .svc-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--sombra-tarjeta-hover);
    }
    .svc-card:hover::before { transform: scaleX(1); }
    .svc-card:hover .svc-card__media img { transform: scale(1.03); }
    .svc-card:hover .svc-card__cta span { transform: translateX(4px); }
  }
  /* Al presionar la tarjeta (no los enlaces internos) se asienta un poco */
  .svc-card:has(.svc-card__enlace:active) { transform: scale(0.99); transition-duration: 120ms; }
  /* El enlace del título cubre toda la tarjeta */
  .svc-card__enlace { color: inherit; text-decoration: none; }
  .svc-card__enlace::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }
  .svc-card__enlace:hover { text-decoration: none; }
  .svc-card__enlace:focus-visible { outline: none; }
  .svc-card__enlace:focus-visible::after { outline: 3px solid var(--focus-ring); outline-offset: -3px; }
  .svc-card__num {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 2;
    padding: 0.2rem 0.45rem;
    border: 1px solid rgba(108, 182, 236, 0.4);
    background: rgba(7, 27, 48, 0.9);
    color: var(--color-white);
    font-family: var(--mono);
    font-size: 0.6875rem;
    line-height: 1rem;
    letter-spacing: 0.08em;
  }
  .svc-card__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--surface-muted);
  }
  .svc-card__media--vacia {
    background-color: var(--color-navy-deep);
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.055) 1px, transparent 1px),
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 80px 80px, 80px 80px, 16px 16px, 16px 16px;
  }
  .svc-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms var(--ease-out);
  }
  .svc-card__body { padding: 1.6rem 1.6rem 1.75rem; display: flex; flex-direction: column; flex: 1; }
  .svc-card__titulo { font-size: 1.45rem; margin-bottom: 0.5rem; }
  /* Descripción: máximo 3 líneas */
  .svc-card__body p {
    color: var(--text-muted);
    font-size: 1rem;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }
  .svc-items {
    list-style: none;
    margin: 0.25rem 0 1.5rem;
    padding: 1rem 0 0;
    border-top: 1px solid var(--border);
    font-size: 0.95rem;
  }
  .svc-items li { position: relative; padding-left: 1.5rem; margin-bottom: 0.45rem; line-height: 1.45; }
  /* Marca de verificación dibujada con bordes */
  .svc-items li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.3em;
    width: 0.4rem;
    height: 0.7rem;
    border: solid var(--accent);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  /* «+N servicios más»: enlace propio, encima del enlace que cubre la tarjeta */
  .svc-items .svc-items__mas { padding-left: 0; }
  .svc-items .svc-items__mas::before { display: none; }
  .svc-mas {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 32px;
    font-weight: 600;
    color: var(--link);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s ease;
  }
  .svc-mas:hover { text-decoration-color: currentColor; }
  .svc-mas:focus-visible { outline: 3px solid var(--focus-ring); outline-offset: 2px; border-radius: 2px; }
  /* «Ver detalle» siempre al fondo, aunque el servicio tenga poco texto */
  .svc-card__cta { margin-top: auto; font-weight: 600; color: var(--link); }
  .svc-card__cta span { display: inline-block; transition: transform 200ms var(--ease-out); }
  @media (prefers-reduced-motion: reduce) {
    .svc-card, .svc-card::before, .svc-card__media img, .svc-card__cta span { transition: none; }
    .svc-card:hover, .svc-card:hover .svc-card__media img, .svc-card:hover .svc-card__cta span,
    .svc-card:has(.svc-card__enlace:active) { transform: none; }
  }

  /* ---------- Debajo de la grilla (solo en el inicio) ---------- */
  .svc-pie {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
    text-align: center;
  }
  .svc-pie__texto { margin: 0; font-size: 15px; color: var(--text-muted); }
  .svc-pie__texto[hidden], .svc-pie__invitacion[hidden] { display: none; }
  .svc-pie__invitacion {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }
  .svc-pie__titulo {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--heading);
    text-wrap: balance;
  }
  .svc-pie__invitacion .svc-pie__boton { margin-top: 0.85rem; }
  .svc-pie__boton {
    min-height: 52px;
    padding-inline: 32px;
    gap: 0.5rem;
  }
  .svc-pie__boton:focus-visible { outline: 3px solid var(--focus-ring); outline-offset: 3px; }
  .svc-pie__boton[hidden] { display: none; }
  @media (max-width: 639px) {
    .svc-pie__invitacion { align-self: stretch; }
    .svc-pie__boton { width: 100%; }
  }
</style>

<script>
  /*
   * Filtro de servicios y sugerencias. Oculta o muestra las tarjetas que ya están
   * en el HTML (no llama al backend ni las vuelve a generar). Ignora mayúsculas,
   * tildes, símbolos y espacios repetidos; con varias palabras deben aparecer todas,
   * en cualquier orden. Busca en todos los servicios, también en los que no se ven
   * sin buscar. Se reinicia en cada astro:page-load.
   */
  const normalizar = (t: string) =>
    t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9ñ]+/g, ' ').trim();

  const MAX_SUGERENCIAS = 6;
  const CLAVE_PRELLENAR = 'svc:cotizar';
  /** Lo lee el formulario de contacto al activarse: marca la solicitud como servicio personalizado. */
  const CLAVE_TIPO = 'contacto:tipo';

  interface Sugerencia {
    t: string;
    s: string | null;
    /** Palabras normalizadas del texto (para coincidir por inicio de palabra). */
    palabras: string[];
  }

  /** Texto con las partes que coinciden resaltadas (siempre como texto, nunca HTML). */
  function resaltar(texto: string, tokens: string[]): Node[] {
    const nodos: Node[] = [];
    // Recorre las palabras del texto original; cada carácter normaliza a 0 o 1 caracteres.
    const re = /[\p{L}\p{N}]+/gu;
    let ultimo = 0;
    for (const m of texto.matchAll(re)) {
      const palabra = m[0];
      const norm = normalizar(palabra);
      const token = tokens.filter((t) => norm.startsWith(t)).sort((a, b) => b.length - a.length)[0];
      if (!token) continue;
      // Caracteres originales que cubren el prefijo normalizado
      let n = 0;
      let cubiertos = 0;
      for (const ch of palabra) {
        if (cubiertos >= token.length) break;
        cubiertos += normalizar(ch).length;
        n += ch.length;
      }
      const inicio = m.index!;
      if (inicio > ultimo) nodos.push(document.createTextNode(texto.slice(ultimo, inicio)));
      const mark = document.createElement('mark');
      mark.textContent = texto.slice(inicio, inicio + n);
      nodos.push(mark);
      ultimo = inicio + n;
    }
    if (ultimo < texto.length) nodos.push(document.createTextNode(texto.slice(ultimo)));
    return nodos;
  }

  /** Espera a que la isla del formulario de contacto esté activa y escribe el mensaje. */
  function prellenarContacto() {
    let texto: string | null = null;
    try {
      texto = sessionStorage.getItem(CLAVE_PRELLENAR);
    } catch {
      return;
    }
    if (!texto) return;
    let intentos = 0;
    const probar = () => {
      const area = document.querySelector<HTMLTextAreaElement>('#contacto textarea[name="mensaje"]');
      const isla = area?.closest('astro-island');
      // Hasta que React no hidrata la isla (sin atributo ssr), un valor escrito podría perderse.
      if (area && isla && !isla.hasAttribute('ssr')) {
        if (!area.value.trim()) area.value = texto!;
        try {
          sessionStorage.removeItem(CLAVE_PRELLENAR);
        } catch {
          /* sin almacenamiento: no pasa nada */
        }
        return;
      }
      if (++intentos < 50) setTimeout(probar, 200); // hasta ~10 s (la isla se activa al verse)
    };
    if (document.getElementById('contacto')) probar();
  }

  function iniciarBuscador() {
    prellenarContacto();
    const raiz = document.querySelector<HTMLElement>('[data-svc-raiz]');
    if (!raiz) return;
    const caja = raiz.querySelector<HTMLElement>('[data-svc-buscador]')!;
    const input = raiz.querySelector<HTMLInputElement>('[data-svc-q]')!;
    const limpiar = raiz.querySelector<HTMLButtonElement>('[data-svc-limpiar]')!;
    const lista = raiz.querySelector<HTMLUListElement>('[data-svc-lista]')!;
    const estado = raiz.querySelector<HTMLElement>('[data-svc-estado]')!;
    const vacio = raiz.querySelector<HTMLElement>('[data-svc-vacio]')!;
    const contador = raiz.querySelector<HTMLElement>('[data-svc-contador]');
    const invitacion = raiz.querySelector<HTMLElement>('[data-svc-invitacion]');
    const tarjetas = [...raiz.querySelectorAll<HTMLElement>('[data-svc-card]')];
    const datos: Sugerencia[] = JSON.parse(raiz.querySelector('[data-svc-sugerencias]')!.textContent || '[]').map(
      (x: { t: string; s: string | null }) => ({ ...x, palabras: normalizar(x.t).split(' ') })
    );
    let aviso: number | undefined;
    let opciones: Sugerencia[] = [];
    let activa = -1;

    // ---------- Filtro de tarjetas ----------

    function filtrar() {
      const texto = input.value.trim();
      const palabras = normalizar(texto).split(' ').filter(Boolean);
      const buscando = palabras.length > 0;
      let visibles = 0;
      for (const t of tarjetas) {
        // Sin texto: la vista inicial (las primeras). Con texto: todas las coincidencias.
        const ver = buscando ? palabras.every((p) => t.dataset.buscar!.includes(p)) : !('svcExtra' in t.dataset);
        t.hidden = !ver;
        if (ver) visibles++;
      }
      // Sin resultados, el aviso de arriba ya invita a cotizar: no se repite abajo.
      if (invitacion) invitacion.hidden = buscando && visibles === 0;
      if (contador) {
        contador.hidden = !buscando;
        contador.textContent = buscando ? `${visibles} ${visibles === 1 ? 'resultado' : 'resultados'} para «${texto}»` : '';
      }
      limpiar.hidden = input.value === '';
      vacio.hidden = visibles > 0;
      vacio.querySelector('[data-svc-texto]')!.textContent = texto;

      // Aviso para lectores de pantalla, cuando se deja de escribir un momento
      clearTimeout(aviso);
      aviso = window.setTimeout(() => {
        const resultados = !buscando
          ? `Se muestran ${visibles} de ${tarjetas.length} servicios.`
          : visibles === 0
            ? `No se encontraron servicios para ${texto}.`
            : visibles === 1
              ? '1 servicio encontrado.'
              : `${visibles} servicios encontrados.`;
        const sug = !lista.hidden && opciones.length ? ` ${opciones.length === 1 ? '1 sugerencia' : `${opciones.length} sugerencias`}.` : '';
        estado.textContent = resultados + sug;
      }, 400);
    }

    // ---------- Sugerencias (combobox) ----------

    /** Coincidencias por inicio de palabra: cada palabra escrita empieza alguna palabra de la sugerencia. */
    function buscarSugerencias(texto: string): Sugerencia[] {
      const tokens = normalizar(texto).split(' ').filter(Boolean);
      if (!tokens.length) return datos.filter((d) => d.s === null); // campo vacío: nombres de los servicios
      const puntaje = (d: Sugerencia) =>
        (d.palabras[0].startsWith(tokens[0]) ? 0 : 2) + (d.s === null ? 0 : 1); // empieza igual y títulos primero
      return datos
        .filter((d) => tokens.every((t) => d.palabras.some((p) => p.startsWith(t))))
        .sort((a, b) => puntaje(a) - puntaje(b) || a.t.length - b.t.length)
        .slice(0, MAX_SUGERENCIAS);
    }

    function cerrar() {
      lista.hidden = true;
      lista.replaceChildren();
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
      opciones = [];
      activa = -1;
    }

    function marcar(i: number) {
      activa = i;
      [...lista.children].forEach((li, n) => li.setAttribute('aria-selected', String(n === i)));
      if (i >= 0) {
        const li = lista.children[i] as HTMLElement;
        input.setAttribute('aria-activedescendant', li.id);
        li.scrollIntoView({ block: 'nearest' });
      } else input.removeAttribute('aria-activedescendant');
    }

    /** En pantallas chicas, la lista termina antes del botón flotante del chat. */
    function ajustarAlto() {
      const espacio = window.innerHeight - lista.getBoundingClientRect().top - 96; // 96 px: zona del chat
      lista.style.maxHeight = window.innerWidth < 640 ? `${Math.max(132, espacio)}px` : '';
    }

    function abrir() {
      opciones = buscarSugerencias(input.value);
      if (!opciones.length) return cerrar();
      const tokens = normalizar(input.value).split(' ').filter(Boolean);
      lista.replaceChildren(
        ...opciones.map((o, i) => {
          const li = document.createElement('li');
          li.id = `svc-sug-${i}`;
          li.setAttribute('role', 'option');
          li.setAttribute('aria-selected', 'false');
          const t = document.createElement('span');
          t.append(...resaltar(o.t, tokens));
          li.append(t);
          if (o.s) {
            const sv = document.createElement('span');
            sv.className = 'svc-sug__servicio';
            sv.textContent = o.s;
            li.append(sv);
          }
          return li;
        })
      );
      lista.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      activa = -1;
      ajustarAlto();
      // Si en móvil no caben al menos 3 sugerencias sobre el chat, sube el campo.
      if (window.innerWidth < 640 && parseFloat(lista.style.maxHeight) < 3 * 48) {
        input.scrollIntoView({ block: 'start' });
        requestAnimationFrame(ajustarAlto);
      }
    }

    function elegir(i: number) {
      const o = opciones[i];
      if (!o) return;
      input.value = o.t;
      cerrar();
      filtrar();
      input.focus();
    }

    // ---------- Eventos ----------

    input.addEventListener('input', () => {
      filtrar();
      abrir();
    });
    input.addEventListener('focus', () => abrir());
    input.addEventListener('keydown', (e) => {
      const abierta = !lista.hidden;
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (!abierta) return abrir();
        marcar(activa < opciones.length - 1 ? activa + 1 : 0);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (abierta) marcar(activa > 0 ? activa - 1 : opciones.length - 1);
      } else if (e.key === 'Enter') {
        e.preventDefault(); // no hay formulario que enviar
        if (abierta && activa >= 0) elegir(activa);
        else cerrar();
      } else if (e.key === 'Escape') {
        e.preventDefault();
        if (abierta) cerrar(); // primero cierra la lista; un segundo Escape limpia
        else if (input.value) {
          input.value = '';
          filtrar();
        }
      } else if (e.key === 'Tab') cerrar();
    });
    // mousedown sin perder el foco del campo; el clic (o toque) elige
    lista.addEventListener('mousedown', (e) => e.preventDefault());
    lista.addEventListener('click', (e) => {
      const li = (e.target as HTMLElement).closest<HTMLElement>('[role="option"]');
      if (li) elegir([...lista.children].indexOf(li));
    });
    lista.addEventListener('mousemove', (e) => {
      const li = (e.target as HTMLElement).closest<HTMLElement>('[role="option"]');
      if (li) {
        const i = [...lista.children].indexOf(li);
        if (i !== activa) marcar(i);
      }
    });
    // Clic o toque fuera del buscador: cierra
    const fuera = (e: PointerEvent) => {
      if (!caja.contains(e.target as Node)) cerrar();
    };
    document.addEventListener('pointerdown', fuera);
    window.addEventListener('resize', () => !lista.hidden && ajustarAlto());

    limpiar.addEventListener('click', () => {
      input.value = '';
      filtrar();
      input.focus();
    });

    // «Solicitar cotización»: deja escrito el término en el mensaje del formulario
    raiz.querySelector('[data-svc-cotizar]')!.addEventListener('click', () => {
      try {
        sessionStorage.setItem(CLAVE_PRELLENAR, `Estoy buscando: ${input.value.trim()}`);
      } catch {
        return;
      }
      // En el inicio el header hace el desplazamiento; aquí solo se espera al formulario.
      if (location.pathname === '/') prellenarContacto();
    });

    // «Solicitar servicio personalizado»: el header lleva a #contacto y enfoca la sección;
    // después se pone el cursor en el mensaje del formulario.
    raiz.querySelector('[data-svc-personalizado]')?.addEventListener('click', () => {
      try {
        sessionStorage.setItem(CLAVE_TIPO, 'personalizado');
      } catch {
        /* sin almacenamiento: el evento de abajo basta si el formulario ya está activo */
      }
      window.dispatchEvent(new CustomEvent('contacto:tipo', { detail: 'personalizado' }));
      const seccion = document.getElementById('contacto');
      if (location.pathname !== '/' || !seccion) return;
      let listo = false;
      // El campo ya está en el HTML aunque el formulario no se haya activado: al enfocarlo
      // el navegador lo trae a la vista (en móvil queda debajo), el formulario se activa
      // y lee la marca de sessionStorage. React conserva el foco al activarse.
      const enfocar = () => {
        if (listo) return;
        listo = true;
        seccion.querySelector<HTMLTextAreaElement>('textarea[name="mensaje"]')?.focus();
      };
      // El header enfoca la sección al terminar el desplazamiento; si no lo hace, se enfoca igual.
      seccion.addEventListener('focus', enfocar, { once: true });
      setTimeout(enfocar, 2000);
    });

    caja.hidden = false;
    if (input.value) filtrar(); // el navegador puede restaurar el texto al volver atrás
    document.addEventListener('astro:before-swap', () => document.removeEventListener('pointerdown', fuera), { once: true });
  }

  document.addEventListener('astro:page-load', iniciarBuscador);
</script>
