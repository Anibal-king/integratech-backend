# URL base del backend (API REST de SIIE)
PUBLIC_API_URL=http://localhost:3000

# Número de WhatsApp del cliente para la derivación del chatbot.
# Formato internacional SIN "+", espacios ni guiones. El Salvador = 503.
# Ejemplo: 50378654321
PUBLIC_WHATSAPP_NUMBER=

# (Opcional) Mensaje prellenado al abrir WhatsApp desde el chatbot.
PUBLIC_WHATSAPP_MESSAGE=Hola, escribo desde el sitio web de IntegraTech y quisiera asistencia con un proyecto de ingeniería.
