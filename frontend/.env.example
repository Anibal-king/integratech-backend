# URL base del backend (API REST de SIIE)
PUBLIC_API_URL=http://localhost:3000

# WhatsApp (Business) de IntegraTech para el botón de cotizar: solo dígitos con
# código de país, sin "+", espacios ni guiones. El Salvador = 503. Ej.: 50378654321
# Es público (va en el HTML). Vacío = no se muestra el botón.
PUBLIC_WHATSAPP_NUMBER=

# Arranca backend/server.js automáticamente en astro dev si la API local no responde.
# Ponlo en false si prefieres levantar el backend a mano.
AUTO_BACKEND=true
