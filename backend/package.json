{
  "name": "siie-backend",
  "version": "1.0.0",
  "description": "API y base de datos para el sitio web de Servicios Integrales de Ingeniería El Salvador S.A. de C.V.",
  "main": "server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "seed": "node db/seed.js",
    "typecheck": "tsc -p tsconfig.json",
    "crear-admin": "node scripts/crear-admin.js",
    "cambiar-password": "node scripts/cambiar-password.js",
    "migrar-fotos-servicios": "node scripts/migrar-fotos-servicios.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "nodemailer": "^6.9.14",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "argon2": true
  }
}
