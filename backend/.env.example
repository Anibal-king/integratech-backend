# ─────────────────────────────────────────────────────────────
# Backend SIIE — variables de entorno (copia este archivo a .env)
# ─────────────────────────────────────────────────────────────

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# Entorno. En "production" CORS_ORIGIN es obligatorio (no hay orígenes por defecto).
NODE_ENV=development

# Ruta de la base SQLite (opcional). Si es relativa, se resuelve contra backend/,
# nunca contra la carpeta desde donde se arranca. Por defecto: db/siie.db
# DATABASE_PATH=db/siie.db

# Orígenes que pueden llamar a la API desde el navegador (formulario y chatbot),
# separados por comas. En desarrollo, si se deja vacío, se permite el dev server
# de Astro (http://localhost:4321 y http://127.0.0.1:4321). Nunca uses "*".
CORS_ORIGIN=http://localhost:4321

# Token de las rutas administrativas GET /api/contacto y GET /api/lead-chatbot
# (devuelven datos personales). Vacío = esas rutas quedan deshabilitadas (404).
# Uso: curl -H "Authorization: Bearer $ADMIN_TOKEN" http://localhost:3000/api/contacto
# Genera uno largo, p. ej.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Proxies delante del servidor en producción (Nginx, Render...), para que el límite
# de envíos por IP use la IP real del visitante. 0 = conexión directa.
TRUST_PROXY=0

# ── Correo (notificación de leads del chatbot) ───────────────
# Si no se configura, los leads igual se guardan en la base de datos
# y el endpoint responde con "emailSent": false.

# Servidor SMTP. Ejemplo con Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=tucuenta@gmail.com
#   SMTP_PASS=contraseña-de-aplicación-de-16-dígitos   (NO tu contraseña normal;
#             genérala en https://myaccount.google.com/apppasswords)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Remitente que verá el destinatario
MAIL_FROM=IntegraTech <no-reply@integratech.com>

# Correo del cliente que recibe los leads del chatbot y los mensajes del formulario de contacto
MAIL_TO_LEADS=cliente@ejemplo.com
